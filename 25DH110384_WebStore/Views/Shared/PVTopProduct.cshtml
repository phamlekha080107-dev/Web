@model _25DH110384_WebStore.Models.ViewModel.ProductDetailVM
@using PagedList.Mvc

<style>
    .top-product-card {
        background: #fff;
        border-radius: 14px;
        border: 1px solid #eaeaea;
        padding: 22px;
        box-shadow: 0 4px 16px rgba(0,0,0,0.03);
    }

    .top-product-title {
        font-size: 17px;
        font-weight: 700;
        color: #0b4d3c;
        margin: 0 0 16px 0;
        padding-bottom: 10px;
        border-bottom: 2px solid #e6f4f0;
        display: flex;
        align-items: center;
        gap: 8px;
    }

    .top-product-list {
        list-style: none;
        padding: 0;
        margin: 0;
        display: flex;
        flex-direction: column;
        gap: 14px;
    }

    .top-product-item {
        display: flex;
        align-items: center;
        gap: 12px;
        padding: 10px;
        border: 1px solid #f0f0f0;
        border-radius: 10px;
        transition: all 0.25s ease;
        background: #fff;
    }

        .top-product-item:hover {
            border-color: #1a8f6d;
            background-color: #f8fbfa;
            transform: translateX(3px);
        }

    .top-product-thumb {
        width: 64px;
        height: 64px;
        flex-shrink: 0;
        background: #f8f9fa;
        border-radius: 8px;
        padding: 5px;
        display: flex;
        align-items: center;
        justify-content: center;
    }

        .top-product-thumb img {
            max-width: 100%;
            max-height: 100%;
            object-fit: contain;
        }

    .top-product-info {
        flex: 1;
        min-width: 0;
    }

        .top-product-info h5 {
            margin: 0 0 6px 0;
            font-size: 14px;
            font-weight: 600;
            color: #333;
            line-height: 1.35;
            display: -webkit-box;
            -webkit-line-clamp: 2;
            -webkit-box-orient: vertical;
            overflow: hidden;
        }

            .top-product-info h5 a:hover {
                color: #1a8f6d;
            }

        .top-product-info .top-price {
            margin: 0;
            font-size: 14px;
            font-weight: 700;
            color: #d93025;
        }

    /* Phân trang nhỏ gọn cho Sidebar */
    .top-pagination {
        display: flex;
        justify-content: center;
        margin-top: 18px;
    }

        .top-pagination .pagination {
            display: flex;
            list-style: none;
            gap: 6px;
            padding: 0;
            margin: 0;
        }

            .top-pagination .pagination li a,
            .top-pagination .pagination li span {
                display: inline-flex;
                align-items: center;
                justify-content: center;
                min-width: 30px;
                height: 30px;
                padding: 0 8px;
                border: 1px solid #ddd;
                border-radius: 6px;
                font-size: 12px;
                font-weight: 500;
                color: #333;
                transition: 0.2s;
            }

                .top-pagination .pagination li a:hover {
                    background: #e6f4f0;
                    border-color: #1a8f6d;
                    color: #0b4d3c;
                }

            .top-pagination .pagination li.active a,
            .top-pagination .pagination li.active span {
                background: #1a8f6d;
                border-color: #1a8f6d;
                color: #fff;
                font-weight: 600;
            }
</style>

@if (Model.TopProducts != null && Model.TopProducts.Any())
{
    <div class="top-product-card">
        <h4 class="top-product-title">
            <i class="fas fa-fire" style="color: #ff6b35;"></i> Sản phẩm bán chạy
        </h4>

        <ul class="top-product-list">
            @foreach (var product in Model.TopProducts)
            {
                <li class="top-product-item">
                    <a href="@Url.Action("ProductDetails", "Home", new { id = product.ProductID })" class="top-product-thumb">
                        <img src="@product.ProductImage" alt="@product.ProductName" />
                    </a>

                    <div class="top-product-info">
                        <h5>
                            <a href="@Url.Action("ProductDetails", "Home", new { id = product.ProductID })">
                                @product.ProductName
                            </a>
                        </h5>
                        <p class="top-price">@product.ProductPrice.ToString("#,##0").Replace(",", ".") đ</p>
                    </div>
                </li>
            }
        </ul>

        <div class="top-pagination">
            @Html.PagedListPager(Model.TopProducts, page => Url.Action("ProductDetails", new
            {
                id = Model.product.ProductID,
                quantity = Model.quantity,
                page
            }))
        </div>
    </div>
}