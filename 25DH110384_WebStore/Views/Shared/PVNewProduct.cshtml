@model _25DH110384_WebStore.Models.ViewModel.HomeProductVM
@using PagedList.Mvc;

@if (Model.NewProducts != null && Model.NewProducts.Any())
{
    <div class="section-container" id="products">
        <div class="section-header">
            <div class="section-title">
                <span class="section-subtitle">— SẢN PHẨM KHÁC</span>
                <h2>Dành riêng cho bạn</h2>
            </div>
        </div>

        <div class="product-grid" id="product-list">
            @foreach (var product in Model.NewProducts)
            {
                <div class="product-card">
                    <i class="far wishlist-icon"></i>
                    <a href="@Url.Action("ProductDetails", "Home", new { id = product.ProductID })">
                        <img src="@Html.DisplayFor(m => product.ProductImage)" class="product-img" />
                    </a>
                    <h3 class="product-title">@Html.DisplayFor(m => product.ProductName)</h3>
                    <div class="product-rating">
                        ★★★★☆ <span style="color:#aaa;">(Đã bán: @product.OrderDetails.Count)</span>
                    </div>
                    <div class="product-price">
                        @String.Format("{0:N0}", product.ProductPrice) đ
                    </div>
                    <a href="@Url.Action("AddToCart", "Cart", new { id = product.ProductID })" class="btn-add-cart" style="display: block; text-align: center; box-sizing: border-box;">
                        <i class="fas fa-shopping-cart"></i> Thêm vào giỏ
                    </a>
                </div>
            }
        </div>

        <!-- Hiển thị phân trang -->
        <div class="pagination-container">
            @Html.PagedListPager(Model.NewProducts, page => Url.Action(
                ViewContext.RouteData.Values["action"].ToString(),
                new { page, searchTerm = Model.SearchTerm }
            ))
        </div>
    </div>
}
else
{
    <div class="section-container">
        <p style="text-align:center; color:#666; font-size: 16px;">Không tìm được sản phẩm nào phù hợp.</p>
    </div>
}