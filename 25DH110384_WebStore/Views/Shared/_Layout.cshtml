@{
    // Lấy thông tin giỏ hàng từ Session
    var cart = Session["Cart"] as _25DH110384_WebStore.Models.ViewModel.Cart;

    // Kiểm tra đăng nhập dựa trên Session["Username"]
    bool isLoggedIn = Session["Username"] != null;
    string username = isLoggedIn ? Session["Username"].ToString() : string.Empty;

    // Khởi tạo ViewBag.pmmodel chuẩn Session
    ViewBag.pmmodel = new _25DH110384_WebStore.Models.ViewModel.PersonalMenuVM
    {
        IsLoggedIn = isLoggedIn,
        Username = username,
        CartCount = (cart != null && cart.Items != null) ? cart.Items.Count() : 0
    };
}

<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>My Store: @ViewBag.Title</title>
    @Styles.Render("~/Content/css")
    @Scripts.Render("~/bundles/modernizr")
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/5.15.4/css/all.min.css" />

    <style>
        /* Tùy chỉnh thanh top banner */
        .top-banner {
            background-color: #7eed8f;
            padding: 8px 0;
            text-align: center;
        }

            .top-banner h4 {
                color: #1e824c;
                margin: 0;
                font-size: 1.1rem;
            }

            .top-banner .freeship {
                color: #007bff;
                font-weight: 800;
                font-style: italic;
            }

        /* Định dạng chung thanh menu */
        .navbar-custom {
            background-color: #ffffff;
            border-bottom: 1px solid #eaeaea;
            box-shadow: 0 2px 5px rgba(0,0,0,0.05);
            margin-bottom: 0;
        }

        /* Chỉnh lại logo */
        .navbar-brand-custom {
            padding: 10px 15px;
            display: flex;
            align-items: center;
        }

            .navbar-brand-custom img {
                max-height: 40px;
            }

        /* Menu hành động (Yêu thích, Giỏ hàng, Đăng nhập) */
        .action-menu {
            display: flex;
            align-items: center;
            list-style: none;
            margin: 0;
            padding: 0;
            height: 60px; /* Bằng chiều cao header */
        }

            .action-menu > li {
                position: relative;
                margin-left: 25px;
                display: flex;
                align-items: center;
            }

            .action-menu a {
                color: #333;
                text-decoration: none;
                font-size: 1.05rem;
                display: flex;
                align-items: center;
                gap: 6px;
            }

                .action-menu a:hover {
                    color: #1e824c;
                }

        /* Nút Đăng nhập / Tên tài khoản */
        .account-link {
            font-weight: normal;
        }

        .account-logged-in {
            color: #1e824c !important;
            font-weight: bold !important;
        }

        /* Dropdown cho Tài khoản */
        .custom-dropdown-content {
            display: none;
            position: absolute;
            top: 100%;
            right: 0;
            background-color: #ffffff;
            min-width: 200px;
            box-shadow: 0px 8px 16px 0px rgba(0,0,0,0.1);
            z-index: 1000;
            border-radius: 6px;
            border: 1px solid #eee;
            overflow: hidden;
            margin-top: 5px;
        }

            .custom-dropdown-content a {
                color: #333;
                padding: 12px 18px;
                display: block;
                font-size: 1rem;
                border-bottom: 1px solid #f5f5f5;
            }

                .custom-dropdown-content a:last-child {
                    border-bottom: none;
                }

                .custom-dropdown-content a:hover {
                    background-color: #f8f9fa;
                    color: #1e824c;
                }

        .action-menu > li:hover .custom-dropdown-content {
            display: block;
        }

        /* Cục badge số đếm cho Giỏ hàng */
        .cart-badge {
            background-color: #d1b894; /* Màu cam nâu như hình */
            color: white;
            border-radius: 50%;
            padding: 2px 8px;
            font-size: 0.85rem;
            font-weight: bold;
            margin-left: 4px;
        }

        /* Icon Yêu thích (trái tim rỗng) */
        .icon-heart {
            font-weight: 400; /* Dùng FontAwesome regular cho trái tim rỗng */
        }
    </style>
</head>
<body>
    <div class="navbar navbar-fixed-top navbar-custom">
        <!-- Top Banner -->
        <div class="top-banner">
            <div class="container">
                <h4>Free ship đơn từ 40k, giảm nhiều hơn cùng <span class="freeship">FREESHIP</span> XTRA</h4>
            </div>
        </div>

        <!-- Main Navigation -->
        <div class="container">
            <div class="navbar-header">
                <button type="button" class="navbar-toggle" data-toggle="collapse" data-target=".navbar-collapse">
                    <span class="icon-bar"></span>
                    <span class="icon-bar"></span>
                    <span class="icon-bar"></span>
                </button>
                <a href="@Url.Action("Index", "Home")" class="navbar-brand-custom">
                    <!-- Kha nhớ kiểm tra đúng đường dẫn logo. Có thể là Logo.PNG hoặc logo.png -->
                    <img src="~/Images/logo.PNG" alt="Logo" />
                </a>
            </div>

            <div class="navbar-collapse collapse">
                <!-- Vùng action menu (Yêu thích, Giỏ hàng, Đăng nhập) đặt bên phải -->
                <ul class="action-menu pull-right">

                    <!-- 1. Yêu thích -->
                    <li>
                        <a href="#">
                            <i class="far fa-heart icon-heart"></i> Yêu thích
                        </a>
                    </li>

                    <!-- 2. Giỏ hàng -->
                    <li>
                        <a href="@Url.Action("Index", "Cart")">
                            <i class="fas fa-shopping-cart" style="color: #8c8c8c;"></i> Giỏ hàng
                            <span class="cart-badge" id="cart-count">@ViewBag.pmmodel.CartCount</span>
                        </a>
                    </li>

                    <!-- 3. Tài khoản / Đăng nhập -->
                    <li>
                        @if (ViewBag.pmmodel.IsLoggedIn)
                        {
                            <!-- Khi đã đăng nhập: Hiện tên user -->
                            <a href="javascript:void(0)" class="account-logged-in">
                                Xin chào, @ViewBag.pmmodel.Username
                            </a>
                            <div class="custom-dropdown-content">
                                <a href="@Url.Action("ProfileInfo", "Account")"><i class="fas fa-id-badge fa-fw"></i> Thông tin tài khoản</a>
                                <a href="@Url.Action("MyOrder", "Order")"><i class="fas fa-receipt fa-fw"></i> Đơn hàng của tôi</a>
                                <a href="@Url.Action("Logout", "Account")" style="color: #d9534f;"><i class="fas fa-sign-out-alt fa-fw"></i> Đăng xuất</a>
                            </div>
                        }
                        else
                        {
                            <!-- Khi chưa đăng nhập: Hiện nút Đăng nhập cơ bản -->
                            <a href="@Url.Action("Login", "Account")" class="account-link">
                                Đăng nhập
                            </a>
                        }
                    </li>
                </ul>
            </div>
        </div>
    </div>

    <!-- PHẦN HIỂN THỊ NỘI DUNG CÁC TRANG CON -->
    <div class="container body-content" style="margin-top: 130px;">
        <!-- Tăng margin-top để không bị che bởi thanh menu dày -->
        @RenderBody()
        <hr />
        <footer>
            <p>© @DateTime.Now.Year - My Store</p>
        </footer>
    </div>

    @Scripts.Render("~/bundles/jquery")
    @Scripts.Render("~/bundles/bootstrap")
    @RenderSection("scripts", required: false)
</body>
</html>