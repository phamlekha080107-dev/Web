@model _25DH110384_WebStore.Models.ViewModel.CheckoutVM

@{
    ViewBag.Title = "Đặt hàng";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<script>
    function enableAddressEdit() {
        document.getElementById("shippingAddress").removeAttribute("readonly");
        document.getElementById("newAddressGroup").style.display = "block";
    }

    function updateShippingAddress() {
        var newAddress = document.getElementById("newShippingAddress").value;
        if (newAddress) {
            document.getElementById("shippingAddress").value = newAddress;
        }
    }
</script>

<div class="container" style="margin-top: 20px;">
    <h2>ĐẶT HÀNG</h2>
    <hr />

    @using (Html.BeginForm("Checkout", "Order", FormMethod.Post))
    {
        @Html.AntiForgeryToken()
        @Html.HiddenFor(m => m.CustomerID)
        @Html.HiddenFor(m => m.Username)
        @Html.HiddenFor(m => m.TotalAmount)

        <h3>Thông tin đơn hàng</h3>
        <div class="form-group">
            <table class="table table-bordered">
                <thead>
                    <tr>
                        <th colspan="2">Sản phẩm</th>
                        <th>Số lượng</th>
                        <th>Đơn giá</th>
                        <th>Thành tiền</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model.CartItems)
                    {
                        <tr>
                            <td style="width: 80px;"><img src="@item.ProductImage" alt="@item.ProductName" style="max-height: 50px;" /></td>
                            <td>@item.ProductName</td>
                            <td>@item.Quantity</td>
                            <td>@item.UnitPrice.ToString("N0") đ</td>
                            <td>@item.TotalPrice.ToString("N0") đ</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>

        <h3>Thông tin giao hàng</h3>
        <div class="form-horizontal">
            <div class="form-group">
                <label class="control-label col-md-2">Địa chỉ giao hàng</label>
                <div class="col-md-10">
                    @Html.TextBoxFor(m => m.ShippingAddress, new { @class = "form-control", @readonly = "readonly", @id = "shippingAddress" })
                    <button type="button" class="btn btn-link" onclick="enableAddressEdit()">Chỉnh sửa</button>
                </div>
            </div>

            <div class="form-group" id="newAddressGroup" style="display:none;">
                <label class="control-label col-md-2">Địa chỉ mới</label>
                <div class="col-md-10">
                    <input type="text" id="newShippingAddress" class="form-control" placeholder="Nhập địa chỉ mới tại đây..." />
                </div>
            </div>

            <div class="form-group">
                <label class="control-label col-md-2">Phương thức giao hàng</label>
                <div class="col-md-10">
                    @Html.RadioButtonFor(m => m.ShippingMethod, "Giao hàng nhanh", new { @checked = "checked" }) Giao hàng nhanh<br />
                    @Html.RadioButtonFor(m => m.ShippingMethod, "Giao hàng tiết kiệm") Giao hàng tiết kiệm
                </div>
            </div>

            <div class="form-group">
                <label class="control-label col-md-2">Phương thức thanh toán</label>
                <div class="col-md-10">
                    @Html.RadioButtonFor(m => m.PaymentMethod, "Tiền mặt", new { @checked = "checked" }) Tiền mặt (COD)<br />
                    @Html.RadioButtonFor(m => m.PaymentMethod, "Paypal") Paypal
                </div>
            </div>

            <div class="form-group">
                <label class="control-label col-md-2">Tổng tiền thanh toán</label>
                <div class="col-md-10">
                    <h4 style="color: red; font-weight: bold;">@Model.TotalAmount.ToString("N0") đ</h4>
                </div>
            </div>

            <div class="form-group">
                <div class="col-md-offset-2 col-md-10">
                    <input type="submit" value="XÁC NHẬN ĐẶT HÀNG" class="btn btn-danger btn-lg" onclick="updateShippingAddress()" />
                </div>
            </div>
        </div>
    }
</div>