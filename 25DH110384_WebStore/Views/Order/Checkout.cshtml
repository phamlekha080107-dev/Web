@model _25DH110384_WebStore.Models.ViewModel.CheckoutVM

@{
    Layout = null;
    var cart = Session["Cart"] as _25DH110384_WebStore.Models.ViewModel.Cart;
    int cartCount = (cart != null && cart.Items != null) ? cart.Items.Count() : (Model.CartItems != null ? Model.CartItems.Count() : 0);
    int totalQty = Model.CartItems != null ? Model.CartItems.Sum(x => x.Quantity) : 0;
}

<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Đặt hàng - PHONE & ACCES</title>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&display=swap" rel="stylesheet">

    <style>
        :root {
            --primary-color: #0b4d3c;
            --secondary-color: #1a8f6d;
            --bg-light: #f8f9fa;
            --text-dark: #333;
            --text-gray: #666;
            --border-radius: 14px;
        }

        html {
            scroll-behavior: smooth;
        }

        body {
            font-family: 'Inter', sans-serif;
            margin: 0;
            padding: 0;
            background-color: #f4f6f8;
            color: var(--text-dark);
            display: flex;
            flex-direction: column;
            min-height: 100vh;
        }

        a {
            text-decoration: none;
            color: inherit;
        }

        /* HEADER */
        .header-top {
            background-color: #fff;
            padding: 15px 50px;
            display: flex;
            align-items: center;
            justify-content: space-between;
            border-bottom: 1px solid #eee;
        }

        .logo {
            font-size: 24px;
            font-weight: 700;
            color: var(--primary-color);
            display: flex;
            align-items: center;
            gap: 10px;
        }

        .nav-links {
            display: flex;
            gap: 30px;
            font-weight: 500;
        }

            .nav-links a {
                position: relative;
                padding-bottom: 6px;
                transition: color 0.25s ease;
            }

                .nav-links a::after {
                    content: "";
                    position: absolute;
                    left: 0;
                    bottom: 0;
                    width: 0;
                    height: 2.5px;
                    background-color: var(--secondary-color);
                    border-radius: 2px;
                    transition: width 0.25s ease;
                }

                .nav-links a:hover {
                    color: var(--secondary-color);
                }

                    .nav-links a:hover::after {
                        width: 100%;
                    }

        .header-actions {
            display: flex;
            align-items: center;
            gap: 20px;
        }

        .search-bar {
            background: var(--bg-light);
            border-radius: 20px;
            padding: 8px 15px;
            display: flex;
            align-items: center;
        }

            .search-bar input {
                border: none;
                background: transparent;
                outline: none;
                padding-left: 10px;
                width: 200px;
            }

        .icon-btn {
            font-size: 20px;
            color: var(--text-dark);
            cursor: pointer;
            position: relative;
        }

        .cart-badge {
            position: absolute;
            top: -8px;
            right: -10px;
            background: var(--secondary-color);
            color: #fff;
            font-size: 11px;
            padding: 2px 6px;
            border-radius: 10px;
            font-weight: bold;
        }

        /* USER DROPDOWN */
        .user-dropdown {
            position: relative;
            display: inline-block;
        }

        .user-trigger {
            display: flex;
            align-items: center;
            gap: 8px;
            background-color: #e6f4f0;
            color: var(--primary-color);
            padding: 7px 14px;
            border-radius: 20px;
            font-size: 14px;
            font-weight: 600;
            cursor: pointer;
            transition: 0.3s;
            user-select: none;
        }

            .user-trigger:hover {
                background-color: var(--secondary-color);
                color: #fff;
            }

        .user-dropdown-menu {
            opacity: 0;
            visibility: hidden;
            transform: translateY(-6px);
            position: absolute;
            right: 0;
            top: calc(100% + 8px);
            background: #fff;
            box-shadow: 0 8px 20px rgba(0,0,0,0.12);
            border: 1px solid #eee;
            border-radius: 10px;
            min-width: 200px;
            z-index: 1000;
            transition: opacity 0.2s ease, transform 0.2s ease, visibility 0s linear 0.35s;
        }

            .user-dropdown-menu::before {
                content: "";
                position: absolute;
                top: -15px;
                left: 0;
                width: 100%;
                height: 18px;
                background: transparent;
            }

        .user-dropdown:hover .user-dropdown-menu,
        .user-dropdown.open .user-dropdown-menu {
            opacity: 1;
            visibility: visible;
            transform: translateY(0);
            transition: opacity 0.2s ease, transform 0.2s ease, visibility 0s linear 0s;
        }

        .user-dropdown-menu a {
            padding: 12px 20px;
            display: block;
            border-bottom: 1px solid #eee;
            font-size: 14px;
        }

            .user-dropdown-menu a:last-child {
                border-bottom: none;
            }

            .user-dropdown-menu a:hover {
                background: #f9f9f9;
                color: var(--secondary-color);
            }

        /* BREADCRUMB */
        .breadcrumb-bar {
            max-width: 1240px;
            width: 100%;
            box-sizing: border-box;
            margin: 22px auto 0 auto;
            padding: 0 30px;
            font-size: 14px;
            color: var(--text-gray);
            display: flex;
            align-items: center;
            gap: 8px;
        }

            .breadcrumb-bar a:hover {
                color: var(--secondary-color);
            }

            .breadcrumb-bar span.current {
                color: var(--primary-color);
                font-weight: 600;
            }

        /* CHECKOUT LAYOUT */
        .checkout-wrapper {
            max-width: 1240px;
            width: 100%;
            box-sizing: border-box;
            margin: 20px auto 60px auto;
            padding: 0 30px;
            flex: 1;
        }

        .page-heading {
            font-size: 24px;
            font-weight: 700;
            color: var(--primary-color);
            margin: 0 0 22px 0;
            display: flex;
            align-items: center;
            gap: 10px;
        }

        .checkout-grid {
            display: grid;
            grid-template-columns: 1fr 440px;
            gap: 26px;
            align-items: start;
        }

        .card-box {
            background: #fff;
            border-radius: var(--border-radius);
            border: 1px solid #eaeaea;
            padding: 24px 28px;
            box-shadow: 0 4px 16px rgba(0,0,0,0.03);
            margin-bottom: 22px;
        }

        .card-title {
            font-size: 17px;
            font-weight: 700;
            color: var(--primary-color);
            margin: 0 0 18px 0;
            padding-bottom: 12px;
            border-bottom: 2px solid #e6f4f0;
            display: flex;
            align-items: center;
            gap: 9px;
        }

        /* FORM ĐỊA CHỈ */
        .form-field {
            margin-bottom: 18px;
        }

            .form-field:last-child {
                margin-bottom: 0;
            }

        .field-label {
            display: block;
            font-size: 14px;
            font-weight: 600;
            color: var(--text-dark);
            margin-bottom: 8px;
        }

        .address-input-row {
            display: flex;
            gap: 10px;
            align-items: center;
        }

        .form-input {
            width: 100%;
            box-sizing: border-box;
            padding: 12px 15px;
            border: 1px solid #dcdcdc;
            border-radius: 10px;
            font-family: inherit;
            font-size: 14px;
            color: var(--text-dark);
            background-color: #fff;
            outline: none;
            transition: border-color 0.25s, box-shadow 0.25s;
        }

            .form-input[readonly] {
                background-color: #f8f9fa;
                color: #555;
                cursor: default;
            }

            .form-input:focus:not([readonly]) {
                border-color: var(--secondary-color);
                box-shadow: 0 0 0 3px rgba(26, 143, 109, 0.12);
            }

        .btn-edit-address {
            flex-shrink: 0;
            background: #e6f4f0;
            color: var(--primary-color);
            border: 1px solid #cce7df;
            padding: 11px 16px;
            border-radius: 10px;
            font-family: inherit;
            font-size: 13px;
            font-weight: 600;
            cursor: pointer;
            transition: 0.25s;
            display: inline-flex;
            align-items: center;
            gap: 6px;
        }

            .btn-edit-address:hover {
                background: var(--secondary-color);
                color: #fff;
                border-color: var(--secondary-color);
            }

        .new-address-box {
            margin-top: 14px;
            padding: 16px;
            background: #f8fbfa;
            border: 1px dashed #1a8f6d;
            border-radius: 10px;
        }

        /* THẺ CHỌN PHƯƠNG THỨC (RADIO CARDS) */
        .radio-options-grid {
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 14px;
        }

        .radio-card {
            display: flex;
            align-items: center;
            gap: 12px;
            padding: 14px 16px;
            border: 1.5px solid #e2e8f0;
            border-radius: 10px;
            cursor: pointer;
            transition: all 0.2s ease;
            background: #fff;
            user-select: none;
        }

            .radio-card:hover {
                border-color: var(--secondary-color);
                background: #f8fbfa;
            }

            .radio-card input[type="radio"] {
                accent-color: var(--secondary-color);
                width: 17px;
                height: 17px;
                margin: 0;
                cursor: pointer;
            }

            .radio-card:has(input[type="radio"]:checked) {
                border-color: var(--secondary-color);
                background: #eef8f5;
                box-shadow: 0 3px 10px rgba(26, 143, 109, 0.1);
            }

        .radio-card-info {
            display: flex;
            flex-direction: column;
            gap: 2px;
        }

        .radio-card-title {
            font-size: 14px;
            font-weight: 600;
            color: var(--text-dark);
        }

        .radio-card-sub {
            font-size: 12px;
            color: var(--text-gray);
        }

        /* CỘT TÓM TẮT ĐƠN HÀNG BÊN PHẢI */
        .order-item-list {
            max-height: 360px;
            overflow-y: auto;
            padding-right: 4px;
            margin-bottom: 18px;
        }

        .order-item {
            display: flex;
            align-items: center;
            gap: 12px;
            padding: 12px 0;
            border-bottom: 1px solid #f0f0f0;
        }

            .order-item:first-child {
                padding-top: 0;
            }

            .order-item:last-child {
                border-bottom: none;
            }

        .order-item-thumb {
            width: 58px;
            height: 58px;
            flex-shrink: 0;
            background: var(--bg-light);
            border: 1px solid #eee;
            border-radius: 8px;
            padding: 4px;
            display: flex;
            align-items: center;
            justify-content: center;
        }

            .order-item-thumb img {
                max-width: 100%;
                max-height: 100%;
                object-fit: contain;
            }

        .order-item-details {
            flex: 1;
            min-width: 0;
        }

        .order-item-name {
            font-size: 14px;
            font-weight: 600;
            color: var(--text-dark);
            margin-bottom: 4px;
            display: -webkit-box;
            -webkit-line-clamp: 2;
            -webkit-box-orient: vertical;
            overflow: hidden;
        }

        .order-item-meta {
            font-size: 12px;
            color: var(--text-gray);
        }

        .order-item-total {
            font-size: 14px;
            font-weight: 700;
            color: var(--text-dark);
            white-space: nowrap;
        }

        .summary-divider {
            border: none;
            border-top: 1px solid #eee;
            margin: 14px 0;
        }

        .summary-row {
            display: flex;
            justify-content: space-between;
            margin-bottom: 10px;
            font-size: 14px;
            color: var(--text-gray);
        }

            .summary-row span:last-child {
                font-weight: 600;
                color: var(--text-dark);
            }

        .total-highlight-box {
            background: #f8fbfa;
            border: 1px solid #d9ede7;
            border-radius: 10px;
            padding: 15px 18px;
            margin: 16px 0 20px 0;
            display: flex;
            justify-content: space-between;
            align-items: center;
        }

        .total-label {
            font-size: 15px;
            font-weight: 700;
            color: var(--text-dark);
        }

        .total-amount {
            font-size: 22px;
            font-weight: 700;
            color: #d93025;
        }

        .btn-confirm-order {
            width: 100%;
            background-color: var(--secondary-color);
            color: #fff;
            border: none;
            padding: 15px 20px;
            border-radius: 10px;
            font-family: inherit;
            font-size: 15px;
            font-weight: 700;
            letter-spacing: 0.4px;
            cursor: pointer;
            transition: 0.25s;
            box-shadow: 0 4px 12px rgba(26, 143, 109, 0.28);
            display: flex;
            align-items: center;
            justify-content: center;
            gap: 8px;
        }

            .btn-confirm-order:hover {
                background-color: var(--primary-color);
                transform: translateY(-1px);
            }

        .btn-back-cart {
            display: flex;
            align-items: center;
            justify-content: center;
            gap: 6px;
            margin-top: 12px;
            padding: 10px;
            border-radius: 10px;
            border: 1px solid #ddd;
            color: var(--text-dark);
            font-size: 14px;
            font-weight: 500;
            transition: 0.2s;
        }

            .btn-back-cart:hover {
                border-color: var(--secondary-color);
                color: var(--primary-color);
                background: #f8fbfa;
            }

        /* FOOTER */
        .phone-footer {
            background-color: var(--primary-color);
            color: #fff;
            padding: 40px 50px;
            display: flex;
            justify-content: space-between;
            align-items: center;
            margin-top: auto;
        }

            .phone-footer h3 {
                margin: 0 0 8px 0;
                font-size: 22px;
            }

            .phone-footer p {
                margin: 0;
                color: #cce5de;
                font-size: 14px;
            }

        @@media (max-width: 992px) {
            .checkout-grid {
                grid-template-columns: 1fr;
            }

            .radio-options-grid {
                grid-template-columns: 1fr;
            }
        }
    </style>
</head>
<body>

    <!-- HEADER -->
    <header class="header-top">
        <a href="@Url.Action("Index", "Home")" class="logo">
            <i class="fas fa-shopping-bag"></i> PHONE & ACCES
        </a>

        <nav class="nav-links">
            <a href="@Url.Action("Index", "Home")">Trang chủ</a>
            <a href="@Url.Action("PageDienThoai", "Home")">Điện thoại</a>
            <a href="@Url.Action("PagePhuKien", "Home")">Phụ kiện</a>
            <a href="@Url.Action("PageThietBi", "Home")">Đồng hồ</a>
            <a href="#footer">Hỗ trợ</a>
        </nav>

        <div class="header-actions">
            @using (Html.BeginForm("Index", "Home", FormMethod.Get))
            {
                <div class="search-bar">
                    <i class="fas fa-search" style="color:#aaa;"></i>
                    <input type="text" name="searchTerm" placeholder="Tìm sản phẩm..." />
                    <button type="submit" style="display:none;"></button>
                </div>
            }

            @if (Session["Username"] != null)
            {
                <div class="user-dropdown">
                    <div class="user-trigger" onclick="this.parentElement.classList.toggle('open')">
                        <i class="fas fa-user-circle" style="font-size: 18px;"></i>
                        <span>@Session["Username"]</span>
                        <i class="fas fa-chevron-down" style="font-size: 11px;"></i>
                    </div>
                    <div class="user-dropdown-menu">
                        <a href="@Url.Action("ProfileInfo", "Account")">Thông tin tài khoản</a>
                        <a href="@Url.Action("MyOrder", "Order")">Đơn hàng của tôi</a>
                        <a href="@Url.Action("Logout", "Account")" style="color: #d9534f;">Đăng xuất</a>
                    </div>
                </div>
            }
            else
            {
                <a href="@Url.Action("Login", "Account")" class="icon-btn" title="Đăng nhập"><i class="fas fa-user"></i></a>
            }

            <a href="@Url.Action("Index", "Cart")" class="icon-btn">
                <i class="fas fa-shopping-cart"></i>
                <span class="cart-badge">@cartCount</span>
            </a>
        </div>
    </header>

    <!-- BREADCRUMB -->
    <div class="breadcrumb-bar">
        <a href="@Url.Action("Index", "Home")"><i class="fas fa-home"></i> Trang chủ</a>
        <span>/</span>
        <a href="@Url.Action("Index", "Cart")">Giỏ hàng</a>
        <span>/</span>
        <span class="current">Đặt hàng</span>
    </div>

    <!-- NỘI DUNG ĐẶT HÀNG -->
    <main class="checkout-wrapper">
        <h1 class="page-heading">
            <i class="fas fa-clipboard-check"></i> Xác nhận thông tin đặt hàng
        </h1>

        @using (Html.BeginForm("Checkout", "Order", FormMethod.Post))
        {
            @Html.AntiForgeryToken()
            @Html.HiddenFor(m => m.CustomerID)
            @Html.HiddenFor(m => m.Username)
            @Html.HiddenFor(m => m.TotalAmount)

            <div class="checkout-grid">
                <!-- CỘT TRÁI: THÔNG TIN GIAO HÀNG & THANH TOÁN -->
                <div>
                    <!-- ĐỊA CHỈ GIAO HÀNG -->
                    <div class="card-box">
                        <h3 class="card-title">
                            <i class="fas fa-map-marker-alt"></i> Địa chỉ nhận hàng
                        </h3>

                        <div class="form-field">
                            <label class="field-label" for="shippingAddress">Địa chỉ giao hàng hiện tại</label>
                            <div class="address-input-row">
                                @Html.TextBoxFor(m => m.ShippingAddress, new { @class = "form-input", @readonly = "readonly", @id = "shippingAddress" })
                                <button type="button" class="btn-edit-address" onclick="enableAddressEdit()">
                                    <i class="fas fa-pen"></i> Chỉnh sửa
                                </button>
                            </div>
                        </div>

                        <div class="new-address-box" id="newAddressGroup" style="display:none;">
                            <label class="field-label" for="newShippingAddress" style="color: var(--primary-color);">
                                <i class="fas fa-location-arrow"></i> Nhập địa chỉ nhận hàng mới
                            </label>
                            <input type="text"
                                   id="newShippingAddress"
                                   class="form-input"
                                   oninput="updateShippingAddress()"
                                   placeholder="Số nhà, tên đường, phường/xã, quận/huyện, tỉnh/thành phố..." />
                        </div>
                    </div>

                    <!-- PHƯƠNG THỨC GIAO HÀNG -->
                    <div class="card-box">
                        <h3 class="card-title">
                            <i class="fas fa-truck"></i> Phương thức giao hàng
                        </h3>

                        <div class="radio-options-grid">
                            <label class="radio-card">
                                @Html.RadioButtonFor(m => m.ShippingMethod, "Giao hàng nhanh", new { @checked = "checked" })
                                <div class="radio-card-info">
                                    <span class="radio-card-title">Giao hàng nhanh</span>
                                    <span class="radio-card-sub">Nhận hàng trong 24h - 48h</span>
                                </div>
                            </label>

                            <label class="radio-card">
                                @Html.RadioButtonFor(m => m.ShippingMethod, "Giao hàng tiết kiệm")
                                <div class="radio-card-info">
                                    <span class="radio-card-title">Giao hàng tiết kiệm</span>
                                    <span class="radio-card-sub">Nhận hàng trong 3 - 5 ngày</span>
                                </div>
                            </label>
                        </div>
                    </div>

                    <!-- PHƯƠNG THỨC THANH TOÁN -->
                    <div class="card-box">
                        <h3 class="card-title">
                            <i class="fas fa-credit-card"></i> Phương thức thanh toán
                        </h3>

                        <div class="radio-options-grid">
                            <label class="radio-card">
                                @Html.RadioButtonFor(m => m.PaymentMethod, "Tiền mặt", new { @checked = "checked" })
                                <div class="radio-card-info">
                                    <span class="radio-card-title">Tiền mặt (COD)</span>
                                    <span class="radio-card-sub">Thanh toán khi nhận hàng</span>
                                </div>
                            </label>

                            <label class="radio-card">
                                @Html.RadioButtonFor(m => m.PaymentMethod, "Paypal")
                                <div class="radio-card-info">
                                    <span class="radio-card-title">PayPal</span>
                                    <span class="radio-card-sub">Thanh toán trực tuyến an toàn</span>
                                </div>
                            </label>
                        </div>
                    </div>
                </div>

                <!-- CỘT PHẢI: TÓM TẮT ĐƠN HÀNG -->
                <div class="card-box">
                    <h3 class="card-title">
                        <i class="fas fa-receipt"></i> Đơn hàng của bạn (@totalQty sản phẩm)
                    </h3>

                    @if (Model.CartItems != null && Model.CartItems.Any())
                    {
                        <div class="order-item-list">
                            @foreach (var item in Model.CartItems)
                            {
                                <div class="order-item">
                                    <div class="order-item-thumb">
                                        <img src="@item.ProductImage" alt="@item.ProductName" />
                                    </div>
                                    <div class="order-item-details">
                                        <div class="order-item-name">@item.ProductName</div>
                                        <div class="order-item-meta">
                                            @item.UnitPrice.ToString("#,##0").Replace(",", ".") đ × <strong>@item.Quantity</strong>
                                        </div>
                                    </div>
                                    <div class="order-item-total">
                                        @item.TotalPrice.ToString("#,##0").Replace(",", ".") đ
                                    </div>
                                </div>
                            }
                        </div>
                    }

                    <hr class="summary-divider" />

                    <div class="summary-row">
                        <span>Tạm tính:</span>
                        <span>@Model.TotalAmount.ToString("#,##0").Replace(",", ".") đ</span>
                    </div>

                    <div class="summary-row">
                        <span>Phí vận chuyển:</span>
                        <span style="color: var(--secondary-color);">Miễn phí</span>
                    </div>

                    <div class="total-highlight-box">
                        <span class="total-label">Tổng thanh toán:</span>
                        <span class="total-amount">@Model.TotalAmount.ToString("#,##0").Replace(",", ".") đ</span>
                    </div>

                    <button type="submit" class="btn-confirm-order" onclick="updateShippingAddress()">
                        <i class="fas fa-check-circle"></i> XÁC NHẬN ĐẶT HÀNG
                    </button>

                    <a href="@Url.Action("Index", "Cart")" class="btn-back-cart">
                        <i class="fas fa-arrow-left"></i> Quay lại giỏ hàng
                    </a>
                </div>
            </div>
        }
    </main>

    <!-- FOOTER -->
