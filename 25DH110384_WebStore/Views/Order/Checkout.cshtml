@model _25DH110384_WebStore.Models.ViewModel.CheckoutVM

@{
    Layout = null;
    var cart = Session["Cart"] as _25DH110384_WebStore.Models.ViewModel.Cart;
    int cartCount = (cart != null && cart.Items != null) ? cart.Items.Count() : (Model.CartItems != null ? Model.CartItems.Count() : 0);
    int totalQty = Model.CartItems != null ? Model.CartItems.Sum(x => x.Quantity) : 0;
}

<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Đặt hàng - PHONE & ACCES</title>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800&display=swap" rel="stylesheet">

    <style>
        :root {
            --primary-color: #0b4d3c;
            --secondary-color: #1a8f6d;
            --dark-surface: #0d1714;
            --dark-card: #152420;
            --bg-light: #f4f6f8;
            --text-dark: #181c1b;
            --text-gray: #646e6b;
            --border-color: #e6eae8;
            --container-max: 1280px;
        }

        *, *::before, *::after {
            box-sizing: border-box;
        }

        html {
            scroll-behavior: smooth;
        }

        body {
            font-family: 'Inter', sans-serif;
            margin: 0;
            padding: 0;
            background-color: #f6f8f7;
            color: var(--text-dark);
            display: flex;
            flex-direction: column;
            min-height: 100vh;
            overflow-x: clip;
        }

        a {
            text-decoration: none;
            color: inherit;
        }

        .page-container {
            max-width: var(--container-max);
            margin: 0 auto;
            padding: 0 32px;
        }

        /* ================= 1. TOP ANNOUNCEMENT BAR ================= */
        .top-promo-bar {
            background-color: #0b1411;
            color: #d7e2de;
            font-size: 12px;
            padding: 8px 0;
            border-bottom: 1px solid rgba(255,255,255,0.08);
        }

            .top-promo-bar .page-container {
                display: flex;
                justify-content: space-between;
                align-items: center;
            }

        .promo-highlights {
            display: flex;
            align-items: center;
            gap: 14px;
        }

            .promo-highlights span.sep {
                color: #4b5c57;
            }

        .promo-meta {
            display: flex;
            align-items: center;
            gap: 16px;
            font-weight: 500;
        }

        /* ================= 2. MAIN HEADER ================= */
        .header-top {
            background-color: #ffffff;
            border-bottom: 1px solid #ecefef;
            position: sticky;
            top: 0;
            z-index: 1000;
        }

            .header-top .page-container {
                height: 70px;
                display: flex;
                align-items: center;
                justify-content: space-between;
                gap: 24px;
            }

        .logo {
            font-size: 22px;
            font-weight: 800;
            color: var(--primary-color);
            display: flex;
            align-items: center;
            gap: 9px;
            letter-spacing: -0.4px;
            white-space: nowrap;
        }

            .logo i {
                color: var(--secondary-color);
            }

        .nav-links {
            display: flex;
            align-items: center;
            gap: 28px;
            font-size: 14.5px;
            font-weight: 500;
            white-space: nowrap;
        }

            .nav-links a {
                position: relative;
                padding: 6px 0;
                color: #2d3533;
                transition: color 0.2s ease;
            }

                .nav-links a::after {
                    content: "";
                    position: absolute;
                    left: 0;
                    bottom: 0;
                    width: 0;
                    height: 2px;
                    background-color: var(--secondary-color);
                    border-radius: 2px;
                    transition: width 0.25s ease;
                }

                .nav-links a:hover,
                .nav-links a.active {
                    color: var(--secondary-color);
                    font-weight: 600;
                }

                    .nav-links a:hover::after,
                    .nav-links a.active::after {
                        width: 100%;
                    }

        .header-actions {
            display: flex;
            align-items: center;
            gap: 16px;
        }

            .header-actions form {
                margin: 0;
            }

        .search-bar {
            background: #f3f5f6;
            border: 1px solid transparent;
            border-radius: 999px;
            padding: 8px 16px;
            display: flex;
            align-items: center;
            width: 260px;
            transition: all 0.2s ease;
        }

            .search-bar:focus-within {
                background: #fff;
                border-color: var(--secondary-color);
                box-shadow: 0 0 0 3px rgba(26, 143, 109, 0.12);
            }

            .search-bar input {
                border: none;
                background: transparent;
                outline: none;
                padding-left: 10px;
                width: 100%;
                font-family: inherit;
                font-size: 13.5px;
                color: var(--text-dark);
            }

        .icon-btn {
            font-size: 19px;
            color: var(--text-dark);
            cursor: pointer;
            position: relative;
            width: 38px;
            height: 38px;
            border-radius: 50%;
            display: inline-flex;
            align-items: center;
            justify-content: center;
            transition: background 0.2s;
            flex-shrink: 0;
        }

            .icon-btn:hover {
                background: #f2f5f4;
                color: var(--primary-color);
            }

        .cart-badge {
            position: absolute;
            top: 0;
            right: -2px;
            background: var(--secondary-color);
            color: #fff;
            font-size: 10.5px;
            min-width: 18px;
            height: 18px;
            padding: 0 5px;
            border-radius: 999px;
            font-weight: 700;
            display: inline-flex;
            align-items: center;
            justify-content: center;
        }

        /* USER DROPDOWN */
        .user-dropdown {
            position: relative;
            display: inline-block;
        }

        .user-trigger {
            display: flex;
            align-items: center;
            gap: 8px;
            background-color: #e8f5f1;
            color: var(--primary-color);
            padding: 7px 14px;
            border-radius: 999px;
            font-size: 13.5px;
            font-weight: 600;
            cursor: pointer;
            transition: 0.25s;
            user-select: none;
            white-space: nowrap;
        }

            .user-trigger:hover {
                background-color: var(--secondary-color);
                color: #fff;
            }

        .user-dropdown-menu {
            opacity: 0;
            visibility: hidden;
            transform: translateY(-6px);
            position: absolute;
            right: 0;
            top: calc(100% + 8px);
            background: #fff;
            box-shadow: 0 10px 28px rgba(0,0,0,0.12);
            border: 1px solid #eaeaea;
            border-radius: 12px;
            min-width: 205px;
            z-index: 1000;
            transition: opacity 0.2s ease, transform 0.2s ease, visibility 0s linear 0.35s;
        }

            .user-dropdown-menu::before {
                content: "";
                position: absolute;
                top: -15px;
                left: 0;
                width: 100%;
                height: 18px;
                background: transparent;
            }

        .user-dropdown:hover .user-dropdown-menu,
        .user-dropdown.open .user-dropdown-menu {
            opacity: 1;
            visibility: visible;
            transform: translateY(0);
            transition: opacity 0.2s ease, transform 0.2s ease, visibility 0s linear 0s;
        }

        .user-dropdown-menu a {
            padding: 11px 18px;
            display: block;
            border-bottom: 1px solid #f1f3f2;
            font-size: 13.5px;
            font-weight: 500;
        }

            .user-dropdown-menu a:first-child {
                border-radius: 12px 12px 0 0;
            }

            .user-dropdown-menu a:last-child {
                border-bottom: none;
                border-radius: 0 0 12px 12px;
            }

            .user-dropdown-menu a:hover {
                background: #f5faf8;
                color: var(--secondary-color);
            }

        /* ================= 3. NỘI DUNG TRANG ĐẶT HÀNG ================= */
        .checkout-page {
            flex: 1;
            padding: 34px 0 64px 0;
        }

        .breadcrumb-bar {
            display: flex;
            align-items: center;
            gap: 8px;
            font-size: 13px;
            color: var(--text-gray);
            margin-bottom: 20px;
        }

            .breadcrumb-bar a:hover {
                color: var(--secondary-color);
            }

            .breadcrumb-bar span.current {
                color: var(--primary-color);
                font-weight: 600;
            }

        .checkout-page-head {
            margin-bottom: 24px;
        }

        .checkout-eyebrow {
            display: block;
            font-size: 11.5px;
            font-weight: 700;
            letter-spacing: 1.2px;
            text-transform: uppercase;
            color: var(--secondary-color);
            margin-bottom: 4px;
        }

        .page-heading {
            font-size: 26px;
            font-weight: 800;
            color: var(--text-dark);
            margin: 0;
            letter-spacing: -0.4px;
            display: flex;
            align-items: center;
            gap: 10px;
        }

            .page-heading i {
                color: var(--secondary-color);
                font-size: 22px;
            }

        .checkout-grid {
            display: grid;
            grid-template-columns: 1fr 430px;
            gap: 26px;
            align-items: start;
        }

        .card-box {
            background: #ffffff;
            border-radius: 16px;
            border: 1px solid #e7ecea;
            padding: 26px 30px;
            box-shadow: 0 8px 24px rgba(11, 22, 19, 0.04);
            margin-bottom: 22px;
        }

        .summary-sticky {
            position: sticky;
            top: 94px;
        }

        .card-title {
            font-size: 17.5px;
            font-weight: 700;
            color: var(--text-dark);
            margin: 0 0 18px 0;
            padding-bottom: 14px;
            border-bottom: 1px solid #eef1f0;
            display: flex;
            align-items: center;
            gap: 10px;
        }

            .card-title i {
                color: var(--secondary-color);
                font-size: 16px;
            }

        /* FORM ĐỊA CHỈ */
        .form-field {
            margin-bottom: 18px;
        }

            .form-field:last-child {
                margin-bottom: 0;
            }

        .field-label {
            display: block;
            font-size: 13.5px;
            font-weight: 600;
            color: var(--text-dark);
            margin-bottom: 8px;
        }

        .address-input-row {
            display: flex;
            gap: 10px;
            align-items: center;
        }

        .form-input {
            width: 100%;
            height: 44px;
            padding: 10px 16px;
            border: 1px solid #dce3e1;
            border-radius: 10px;
            font-family: inherit;
            font-size: 14px;
            color: var(--text-dark);
            background-color: #ffffff;
            outline: none;
            transition: all 0.2s ease;
        }

            .form-input[readonly] {
                background-color: #f3f5f6;
                color: #5a6562;
                border-color: #e6eae8;
                cursor: default;
            }

            .form-input:focus:not([readonly]) {
                border-color: var(--secondary-color);
                box-shadow: 0 0 0 3px rgba(26, 143, 109, 0.12);
            }

        .btn-edit-address {
            flex-shrink: 0;
            height: 44px;
            background: #e8f5f1;
            color: var(--primary-color);
            border: 1px solid #cce5de;
            padding: 0 18px;
            border-radius: 999px;
            font-family: inherit;
            font-size: 13px;
            font-weight: 600;
            cursor: pointer;
            transition: all 0.25s ease;
            display: inline-flex;
            align-items: center;
            gap: 7px;
            white-space: nowrap;
        }

            .btn-edit-address:hover {
                background: var(--secondary-color);
                color: #ffffff;
                border-color: var(--secondary-color);
            }

        .new-address-box {
            margin-top: 16px;
            padding: 18px;
            background: #f4faf8;
            border: 1px dashed var(--secondary-color);
            border-radius: 12px;
        }

        /* THẺ CHỌN PHƯƠNG THỨC (RADIO CARDS) */
        .radio-options-grid {
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 14px;
        }

        .radio-card {
            display: flex;
            align-items: center;
            gap: 12px;
            padding: 15px 16px;
            border: 1.5px solid #e2e8e6;
            border-radius: 12px;
            cursor: pointer;
            transition: all 0.2s ease;
            background: #ffffff;
            user-select: none;
        }

            .radio-card:hover {
                border-color: var(--secondary-color);
                background: #f7fbf9;
            }

            .radio-card input[type="radio"] {
                accent-color: var(--secondary-color);
                width: 17px;
                height: 17px;
                margin: 0;
                cursor: pointer;
                flex-shrink: 0;
            }

            .radio-card:has(input[type="radio"]:checked) {
                border-color: var(--secondary-color);
                background: #eef8f4;
                box-shadow: 0 4px 12px rgba(26, 143, 109, 0.1);
            }

        .radio-card-info {
            display: flex;
            flex-direction: column;
            gap: 3px;
        }

        .radio-card-title {
            font-size: 14px;
            font-weight: 700;
            color: var(--text-dark);
        }

        .radio-card-sub {
            font-size: 12px;
            color: var(--text-gray);
        }

        /* CỘT TÓM TẮT ĐƠN HÀNG BÊN PHẢI */
        .order-item-list {
            max-height: 360px;
            overflow-y: auto;
            padding-right: 4px;
            margin-bottom: 18px;
        }

        .order-item {
            display: flex;
            align-items: center;
            gap: 14px;
            padding: 12px 0;
            border-bottom: 1px dashed #e6eae8;
        }

            .order-item:first-child {
                padding-top: 0;
            }

            .order-item:last-child {
                border-bottom: none;
            }

        .order-item-thumb {
            width: 62px;
            height: 62px;
            flex-shrink: 0;
            background: #f6f8f7;
            border: 1px solid #e9eded;
            border-radius: 10px;
            padding: 6px;
            display: flex;
            align-items: center;
            justify-content: center;
        }

            .order-item-thumb img {
                max-width: 100%;
                max-height: 100%;
                object-fit: contain;
            }

        .order-item-details {
            flex: 1;
            min-width: 0;
        }

        .order-item-name {
            font-size: 14px;
            font-weight: 600;
            color: var(--text-dark);
            margin-bottom: 4px;
            line-height: 1.35;
            display: -webkit-box;
            -webkit-line-clamp: 2;
            -webkit-box-orient: vertical;
            overflow: hidden;
        }

        .order-item-meta {
            font-size: 12.5px;
            color: var(--text-gray);
        }

        .order-item-total {
            font-size: 14.5px;
            font-weight: 700;
            color: var(--primary-color);
            white-space: nowrap;
        }

        .summary-divider {
            border: none;
            border-top: 1px solid #eef1f0;
            margin: 14px 0;
        }

        .summary-row {
            display: flex;
            justify-content: space-between;
            margin-bottom: 11px;
            font-size: 14px;
            color: var(--text-gray);
        }

            .summary-row span:last-child {
                font-weight: 600;
                color: var(--text-dark);
            }

        .total-highlight-box {
            background: #eef8f4;
            border: 1px solid #bfe3d7;
            border-radius: 12px;
            padding: 16px 18px;
            margin: 18px 0 22px 0;
            display: flex;
            justify-content: space-between;
            align-items: center;
        }

        .total-label {
            font-size: 14.5px;
            font-weight: 700;
            color: var(--primary-color);
        }

        .total-amount {
            font-size: 22px;
            font-weight: 800;
            color: #d93025;
        }

        .btn-confirm-order {
            width: 100%;
            background-color: #141f1c;
            color: #ffffff;
            border: none;
            padding: 14px 22px;
            border-radius: 999px;
            font-family: inherit;
            font-size: 14.5px;
            font-weight: 700;
            letter-spacing: 0.3px;
            cursor: pointer;
            transition: all 0.25s ease;
            display: flex;
            align-items: center;
            justify-content: center;
            gap: 8px;
        }

            .btn-confirm-order:hover {
                background-color: var(--secondary-color);
                transform: translateY(-1px);
                box-shadow: 0 6px 18px rgba(26, 143, 109, 0.28);
            }

        .btn-back-cart {
            display: flex;
            align-items: center;
            justify-content: center;
            gap: 8px;
            margin-top: 12px;
            padding: 11px 20px;
            border-radius: 999px;
            border: 1px solid #dce3e1;
            background: #ffffff;
            color: var(--text-dark);
            font-size: 14px;
            font-weight: 600;
            transition: all 0.2s ease;
        }

            .btn-back-cart:hover {
                border-color: var(--secondary-color);
                color: var(--primary-color);
                background: #f5faf8;
            }

        /* ================= 4. SERVICE STRIP ================= */
        .service-strip {
            border-top: 1px solid #ecefef;
            background: #fafcfb;
            padding: 32px 0;
            margin-top: auto;
        }

        .service-grid {
            max-width: var(--container-max);
            margin: 0 auto;
            padding: 0 32px;
            display: grid;
            grid-template-columns: repeat(4, 1fr);
            gap: 24px;
        }

        .service-box {
            display: flex;
            align-items: center;
            gap: 14px;
        }

            .service-box .srv-icon {
                width: 44px;
                height: 44px;
                border-radius: 12px;
                background: #e8f5f1;
                color: var(--secondary-color);
                display: inline-flex;
                align-items: center;
                justify-content: center;
                font-size: 18px;
                flex-shrink: 0;
            }

            .service-box h4 {
                margin: 0 0 3px 0;
                font-size: 14.5px;
                font-weight: 700;
                color: var(--text-dark);
            }

            .service-box p {
                margin: 0;
                font-size: 12.5px;
                color: var(--text-gray);
            }

        /* ================= 5. MULTI-COLUMN DARK FOOTER ================= */
        .voltix-footer {
            background-color: #0b1411;
            color: #b7c4c0;
            padding-top: 52px;
        }

        .footer-grid {
            max-width: var(--container-max);
            margin: 0 auto;
            padding: 0 32px 40px 32px;
            display: grid;
            grid-template-columns: 1.4fr 1fr 1fr 1fr 1.2fr;
            gap: 32px;
        }

        .footer-brand .logo {
            color: #ffffff;
            margin-bottom: 14px;
        }

        .footer-brand p {
            font-size: 13px;
            line-height: 1.6;
            color: #93a39e;
            margin: 0 0 20px 0;
        }

        .social-links {
            display: flex;
            gap: 10px;
        }

            .social-links a {
                width: 34px;
                height: 34px;
                border-radius: 50%;
                background: rgba(255,255,255,0.08);
                color: #ffffff;
                display: inline-flex;
                align-items: center;
                justify-content: center;
                font-size: 13.5px;
                transition: background 0.2s;
            }

                .social-links a:hover {
                    background: var(--secondary-color);
                }

        .footer-col h4 {
            color: #ffffff;
            font-size: 14px;
            font-weight: 700;
            margin: 0 0 16px 0;
        }

        .footer-col ul {
            list-style: none;
            padding: 0;
            margin: 0;
            display: flex;
            flex-direction: column;
            gap: 10px;
            font-size: 13px;
        }

            .footer-col ul a:hover {
                color: #5eead4;
            }

        .app-badges {
            display: flex;
            flex-direction: column;
            gap: 10px;
            margin-top: 14px;
        }

        .app-badge-btn {
            display: inline-flex;
            align-items: center;
            gap: 10px;
            background: rgba(255,255,255,0.07);
            border: 1px solid rgba(255,255,255,0.14);
            color: #ffffff;
            padding: 8px 14px;
            border-radius: 10px;
            font-size: 12px;
            transition: background 0.2s;
        }

            .app-badge-btn:hover {
                background: rgba(255,255,255,0.14);
            }

            .app-badge-btn i {
                font-size: 18px;
            }

        .footer-bottom {
            border-top: 1px solid rgba(255,255,255,0.08);
            padding: 18px 0;
            font-size: 12.5px;
            color: #7f908b;
        }

            .footer-bottom .page-container {
                display: flex;
                justify-content: space-between;
                align-items: center;
            }

        .footer-legal {
            display: flex;
            gap: 18px;
        }

            .footer-legal a:hover {
                color: #ffffff;
            }

        /* ================= RESPONSIVE ================= */
        @@media (max-width: 1180px) {
            .nav-links {
                gap: 20px;
            }

            .search-bar {
                width: 210px;
            }
        }

        @@media (max-width: 1024px) {
            .checkout-grid {
                grid-template-columns: 1fr;
            }

            .summary-sticky {
                position: static;
            }

            .footer-grid {
                grid-template-columns: repeat(2, 1fr);
            }
        }

        @@media (max-width: 820px) {
            .top-promo-bar,
            .nav-links,
            .search-bar {
                display: none;
            }

            .page-container {
                padding: 0 20px;
            }

            .checkout-page {
                padding: 24px 0 48px 0;
            }

            .card-box {
                padding: 20px 18px;
            }

            .address-input-row {
                flex-direction: column;
                align-items: stretch;
            }

            .btn-edit-address {
                justify-content: center;
            }

            .radio-options-grid {
                grid-template-columns: 1fr;
            }

            .service-grid {
                grid-template-columns: 1fr;
            }
        }
    </style>
</head>
<body>

    <!-- 1. TOP ANNOUNCEMENT BAR -->
    <div class="top-promo-bar">
        <div class="page-container">
            <div class="promo-highlights">
                <span>Miễn phí vận chuyển cho đơn từ 500.000đ</span>
                <span class="sep">|</span>
                <span>Đổi trả dễ dàng 30 ngày</span>
                <span class="sep">|</span>
                <span>Công nghệ chính hãng 100%</span>
            </div>
            <div class="promo-meta">
                <span>VND <i class="fas fa-chevron-down" style="font-size:10px;"></i></span>
                <span style="color:#4b5c57;">|</span>
                <span>Tiếng Việt <i class="fas fa-chevron-down" style="font-size:10px;"></i></span>
            </div>
        </div>
    </div>

    <!-- 2. MAIN HEADER -->
    <header class="header-top">
        <div class="page-container">
            <a href="@Url.Action("Index", "Home")" class="logo">
                <i class="fas fa-shopping-bag"></i> PHONE & ACCES
            </a>

            <nav class="nav-links">
                <a href="@Url.Action("Index", "Home")">Trang chủ</a>
                <a href="@Url.Action("PageDienThoai", "Home")">Điện thoại</a>
                <a href="@Url.Action("PagePhuKien", "Home")">Phụ kiện</a>
                <a href="@Url.Action("PageThietBi", "Home")">Đồng hồ</a>
                <a href="#footer">Hỗ trợ</a>
            </nav>

            <div class="header-actions">
                @using (Html.BeginForm("Index", "Home", FormMethod.Get))
                {
                    <div class="search-bar">
                        <i class="fas fa-search" style="color:#8b9693; font-size:13px;"></i>
                        <input type="text" name="searchTerm" placeholder="Tìm sản phẩm..." />
                        <button type="submit" style="display:none;"></button>
                    </div>
                }

                @if (Session["Username"] != null)
                {
                    <div class="user-dropdown">
                        <div class="user-trigger" onclick="this.parentElement.classList.toggle('open')">
                            <i class="fas fa-user-circle" style="font-size: 17px;"></i>
                            <span>@Session["Username"]</span>
                            <i class="fas fa-chevron-down" style="font-size: 10px;"></i>
                        </div>
                        <div class="user-dropdown-menu">
                            <a href="@Url.Action("ProfileInfo", "Account")">Thông tin tài khoản</a>
                            <a href="@Url.Action("MyOrder", "Order")">Đơn hàng của tôi</a>
                            <a href="@Url.Action("Logout", "Account")" style="color: #d9534f;">Đăng xuất</a>
                        </div>
                    </div>
                }
                else
                {
                    <a href="@Url.Action("Login", "Account")" class="icon-btn" title="Đăng nhập">
                        <i class="far fa-user"></i>
                    </a>
                }

                <a href="@Url.Action("Index", "Cart")" class="icon-btn" title="Giỏ hàng">
                    <i class="fas fa-shopping-cart"></i>
                    <span class="cart-badge">@cartCount</span>
                </a>
            </div>
        </div>
    </header>

    <!-- 3. NỘI DUNG ĐẶT HÀNG -->
    <main class="checkout-page">
        <div class="page-container">
            <div class="breadcrumb-bar">
                <a href="@Url.Action("Index", "Home")"><i class="fas fa-home"></i> Trang chủ</a>
                <span>/</span>
                <a href="@Url.Action("Index", "Cart")">Giỏ hàng</a>
                <span>/</span>
                <span class="current">Đặt hàng</span>
            </div>

            <div class="checkout-page-head">
                <span class="checkout-eyebrow">Hoàn tất đơn hàng</span>
                <h1 class="page-heading">
                    <i class="fas fa-clipboard-check"></i> Xác nhận thông tin đặt hàng
                </h1>
            </div>

            @using (Html.BeginForm("Checkout", "Order", FormMethod.Post))
            {
                @Html.AntiForgeryToken()
                @Html.HiddenFor(m => m.CustomerID)
                @Html.HiddenFor(m => m.Username)
                @Html.HiddenFor(m => m.TotalAmount)

                <div class="checkout-grid">
                    <!-- CỘT TRÁI: THÔNG TIN GIAO HÀNG & THANH TOÁN -->
                    <div>
                        <!-- ĐỊA CHỈ GIAO HÀNG -->
                        <div class="card-box">
                            <h3 class="card-title">
                                <i class="fas fa-map-marker-alt"></i> Địa chỉ nhận hàng
                            </h3>

                            <div class="form-field">
                                <label class="field-label" for="shippingAddress">Địa chỉ giao hàng hiện tại</label>
                                <div class="address-input-row">
                                    @Html.TextBoxFor(m => m.ShippingAddress, new { @class = "form-input", @readonly = "readonly", @id = "shippingAddress" })
                                    <button type="button" class="btn-edit-address" onclick="enableAddressEdit()">
                                        <i class="fas fa-pen"></i> Chỉnh sửa
                                    </button>
                                </div>
                            </div>

                            <div class="new-address-box" id="newAddressGroup" style="display:none;">
                                <label class="field-label" for="newShippingAddress" style="color: var(--primary-color);">
                                    <i class="fas fa-location-arrow"></i> Nhập địa chỉ nhận hàng mới
                                </label>
                                <input type="text"
                                       id="newShippingAddress"
                                       class="form-input"
                                       oninput="updateShippingAddress()"
                                       placeholder="Số nhà, tên đường, phường/xã, quận/huyện, tỉnh/thành phố..." />
                            </div>
                        </div>

                        <!-- PHƯƠNG THỨC GIAO HÀNG -->
                        <div class="card-box">
                            <h3 class="card-title">
                                <i class="fas fa-truck"></i> Phương thức giao hàng
                            </h3>

                            <div class="radio-options-grid">
                                <label class="radio-card">
                                    @Html.RadioButtonFor(m => m.ShippingMethod, "Giao hàng nhanh", new { @checked = "checked" })
                                    <div class="radio-card-info">
                                        <span class="radio-card-title">Giao hàng nhanh</span>
                                        <span class="radio-card-sub">Nhận hàng trong 24h - 48h</span>
                                    </div>
                                </label>

                                <label class="radio-card">
                                    @Html.RadioButtonFor(m => m.ShippingMethod, "Giao hàng tiết kiệm")
                                    <div class="radio-card-info">
                                        <span class="radio-card-title">Giao hàng tiết kiệm</span>
                                        <span class="radio-card-sub">Nhận hàng trong 3 - 5 ngày</span>
                                    </div>
                                </label>
                            </div>
                        </div>

                        <!-- PHƯƠNG THỨC THANH TOÁN -->
                        <div class="card-box">
                            <h3 class="card-title">
                                <i class="fas fa-credit-card"></i> Phương thức thanh toán
                            </h3>

                            <div class="radio-options-grid">
                                <label class="radio-card">
                                    @Html.RadioButtonFor(m => m.PaymentMethod, "Tiền mặt", new { @checked = "checked" })
                                    <div class="radio-card-info">
                                        <span class="radio-card-title">Tiền mặt (COD)</span>
                                        <span class="radio-card-sub">Thanh toán khi nhận hàng</span>
                                    </div>
                                </label>

                                <label class="radio-card">
                                    @Html.RadioButtonFor(m => m.PaymentMethod, "Paypal")
                                    <div class="radio-card-info">
                                        <span class="radio-card-title">PayPal</span>
                                        <span class="radio-card-sub">Thanh toán trực tuyến an toàn</span>
                                    </div>
                                </label>
                            </div>
                        </div>
                    </div>

                    <!-- CỘT PHẢI: TÓM TẮT ĐƠN HÀNG -->
                    <div class="card-box summary-sticky">
                        <h3 class="card-title">
                            <i class="fas fa-receipt"></i> Đơn hàng của bạn (@totalQty sản phẩm)
                        </h3>

                        @if (Model.CartItems != null && Model.CartItems.Any())
                        {
                            <div class="order-item-list">
                                @foreach (var item in Model.CartItems)
                                {
                                    <div class="order-item">
                                        <div class="order-item-thumb">
                                            <img src="@item.ProductImage" alt="@item.ProductName" />
                                        </div>
                                        <div class="order-item-details">
                                            <div class="order-item-name">@item.ProductName</div>
                                            <div class="order-item-meta">
                                                @item.UnitPrice.ToString("#,##0").Replace(",", ".") đ × <strong>@item.Quantity</strong>
                                            </div>
                                        </div>
                                        <div class="order-item-total">
                                            @item.TotalPrice.ToString("#,##0").Replace(",", ".") đ
                                        </div>
                                    </div>
                                }
                            </div>
                        }

                        <hr class="summary-divider" />

                        <div class="summary-row">
                            <span>Tạm tính:</span>
                            <span>@Model.TotalAmount.ToString("#,##0").Replace(",", ".") đ</span>
                        </div>

                        <div class="summary-row">
                            <span>Phí vận chuyển:</span>
                            <span style="color: var(--secondary-color);">Miễn phí</span>
                        </div>

                        <div class="total-highlight-box">
                            <span class="total-label">Tổng thanh toán:</span>
                            <span class="total-amount">@Model.TotalAmount.ToString("#,##0").Replace(",", ".") đ</span>
                        </div>

                        <button type="submit" class="btn-confirm-order" onclick="updateShippingAddress()">
                            <i class="fas fa-check-circle"></i> XÁC NHẬN ĐẶT HÀNG
                        </button>

                        <a href="@Url.Action("Index", "Cart")" class="btn-back-cart">
                            <i class="fas fa-arrow-left"></i> Quay lại giỏ hàng
                        </a>
                    </div>
                </div>
            }
        </div>
    </main>

    <!-- 4. SERVICE STRIP -->
    <div class="service-strip">
        <div class="service-grid">
            <div class="service-box">
                <span class="srv-icon"><i class="fas fa-truck"></i></span>
                <div>
                    <h4>Miễn phí vận chuyển</h4>
                    <p>Cho đơn hàng từ 500.000đ</p>
                </div>
            </div>

            <div class="service-box">
                <span class="srv-icon"><i class="fas fa-undo-alt"></i></span>
                <div>
                    <h4>Đổi trả 30 ngày</h4>
                    <p>Bảo hành 1 đổi 1 dễ dàng</p>
                </div>
            </div>

            <div class="service-box">
                <span class="srv-icon"><i class="fas fa-headset"></i></span>
                <div>
                    <h4>Hỗ trợ 24/7</h4>
                    <p>Tư vấn kỹ thuật tận tâm</p>
                </div>
            </div>

            <div class="service-box">
                <span class="srv-icon"><i class="fas fa-shield-alt"></i></span>
                <div>
                    <h4>Thanh toán bảo mật</h4>
                    <p>Hỗ trợ PayPal & COD an toàn</p>
                </div>
            </div>
        </div>
    </div>

    <!-- 5. MULTI-COLUMN DARK FOOTER -->
    <footer class="voltix-footer" id="footer">
        <div class="footer-grid">
            <div class="footer-brand">
                <a href="@Url.Action("Index", "Home")" class="logo">
                    <i class="fas fa-shopping-bag"></i> PHONE & ACCES
                </a>
                <p>Hệ thống bán lẻ điện thoại thông minh, đồng hồ và phụ kiện công nghệ chính hãng hàng đầu dành cho bạn.</p>
                <div class="social-links">
                    <a href="#"><i class="fab fa-facebook-f"></i></a>
                    <a href="#"><i class="fab fa-instagram"></i></a>
                    <a href="#"><i class="fab fa-youtube"></i></a>
                    <a href="#"><i class="fab fa-tiktok"></i></a>
                </div>
            </div>

            <div class="footer-col">
                <h4>Danh mục</h4>
                <ul>
                    <li><a href="@Url.Action("PageDienThoai", "Home")">Điện thoại</a></li>
                    <li><a href="@Url.Action("PagePhuKien", "Home")">Phụ kiện</a></li>
                    <li><a href="@Url.Action("PageThietBi", "Home")">Đồng hồ thông minh</a></li>
                    <li><a href="@Url.Action("Index", "Home")#featured">Sản phẩm nổi bật</a></li>
                </ul>
            </div>

            <div class="footer-col">
                <h4>Về chúng tôi</h4>
                <ul>
                    <li><a href="#footer">Giới thiệu cửa hàng</a></li>
                    <li><a href="#footer">Chính sách bảo hành</a></li>
                    <li><a href="#footer">Tin tức công nghệ</a></li>
                    <li><a href="#footer">Hệ thống chi nhánh</a></li>
                </ul>
            </div>

            <div class="footer-col">
                <h4>Hỗ trợ khách hàng</h4>
                <ul>
                    <li><a href="@Url.Action("MyOrder", "Order")">Tra cứu đơn hàng</a></li>
                    <li><a href="@Url.Action("ProfileInfo", "Account")">Tài khoản của tôi</a></li>
                    <li><a href="#footer">Hướng dẫn thanh toán PayPal</a></li>
                    <li><a href="#footer">Chính sách đổi trả</a></li>
                </ul>
            </div>

            <div class="footer-col">
                <h4>Tải ứng dụng</h4>
                <p style="font-size:12.5px; color:#93a39e; margin:0;">Trải nghiệm mua sắm tiện lợi hơn trên điện thoại.</p>
                <div class="app-badges">
                    <a href="#footer" class="app-badge-btn">
                        <i class="fab fa-apple"></i>
                        <span>Tải về trên <strong>App Store</strong></span>
                    </a>
                    <a href="#footer" class="app-badge-btn">
                        <i class="fab fa-google-play"></i>
                        <span>Tải về trên <strong>Google Play</strong></span>
                    </a>
                </div>
            </div>
        </div>

        <div class="footer-bottom">
            <div class="page-container">
                <span>© 2026 PHONE & ACCES. All rights reserved.</span>
                <div class="footer-legal">
                    <a href="#footer">Chính sách bảo mật</a>
                    <a href="#footer">Điều khoản dịch vụ</a>
                    <a href="#footer">Sơ đồ trang</a>
                </div>
            </div>
        </div>
    </footer>

    <script>
        function enableAddressEdit() {
            const addrInput = document.getElementById("shippingAddress");
            const newGroup = document.getElementById("newAddressGroup");
            const newInput = document.getElementById("newShippingAddress");

            addrInput.removeAttribute("readonly");
            newGroup.style.display = "block";
            newInput.focus();
        }

        function updateShippingAddress() {
            var newAddress = document.getElementById("newShippingAddress").value.trim();
            if (newAddress) {
                document.getElementById("shippingAddress").value = newAddress;
            }
        }

        document.addEventListener('click', function (e) {
            const dropdown = document.querySelector('.user-dropdown');
            if (dropdown && !dropdown.contains(e.target)) {
                dropdown.classList.remove('open');
            }
        });
    </script>

</body>
</html>