@model IEnumerable<_25DH110384_WebStore.Models.Order>

@{
    Layout = null;
    var cart = Session["Cart"] as _25DH110384_WebStore.Models.ViewModel.Cart;
    int cartCount = (cart != null && cart.Items != null) ? cart.Items.Count() : 0;

    string selectedStatus = ViewBag.SelectedStatus as string ?? "Tất cả đơn";
    string searchTerm = ViewBag.SearchTerm as string ?? "";

    var allOrders = Model != null ? Model.ToList() : new List<_25DH110384_WebStore.Models.Order>();

    var statusTabs = new List<string>
{
        "Tất cả đơn",
        "Chờ thanh toán",
        "Đang xử lý",
        "Đang vận chuyển",
        "Đã giao",
        "Đã hủy"
    };

    var groupStatuses = new List<string>
{
        "Chờ thanh toán",
        "Đang xử lý",
        "Đang vận chuyển",
        "Đã giao",
        "Đã hủy"
    };
}

<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Đơn hàng của tôi - PHONE & ACCES</title>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800&display=swap" rel="stylesheet">

    <style>
        :root {
            --primary-color: #0b4d3c;
            --secondary-color: #1a8f6d;
            --dark-surface: #0d1714;
            --dark-card: #152420;
            --bg-light: #f4f6f8;
            --text-dark: #181c1b;
            --text-gray: #646e6b;
            --border-color: #e6eae8;
            --container-max: 1280px;
        }

        *, *::before, *::after {
            box-sizing: border-box;
        }

        html {
            scroll-behavior: smooth;
        }

        body {
            font-family: 'Inter', sans-serif;
            margin: 0;
            padding: 0;
            background-color: #f6f8f7;
            color: var(--text-dark);
            display: flex;
            flex-direction: column;
            min-height: 100vh;
            overflow-x: clip;
        }

        a {
            text-decoration: none;
            color: inherit;
        }

        .page-container {
            max-width: var(--container-max);
            margin: 0 auto;
            padding: 0 32px;
        }

        /* ================= 1. TOP ANNOUNCEMENT BAR ================= */
        .top-promo-bar {
            background-color: #0b1411;
            color: #d7e2de;
            font-size: 12px;
            padding: 8px 0;
            border-bottom: 1px solid rgba(255,255,255,0.08);
        }

            .top-promo-bar .page-container {
                display: flex;
                justify-content: space-between;
                align-items: center;
            }

        .promo-highlights {
            display: flex;
            align-items: center;
            gap: 14px;
        }

            .promo-highlights span.sep {
                color: #4b5c57;
            }

        .promo-meta {
            display: flex;
            align-items: center;
            gap: 16px;
            font-weight: 500;
        }

        /* ================= 2. MAIN HEADER ================= */
        .header-top {
            background-color: #ffffff;
            border-bottom: 1px solid #ecefef;
            position: sticky;
            top: 0;
            z-index: 1000;
        }

            .header-top .page-container {
                height: 70px;
                display: flex;
                align-items: center;
                justify-content: space-between;
                gap: 24px;
            }

        .logo {
            font-size: 22px;
            font-weight: 800;
            color: var(--primary-color);
            display: flex;
            align-items: center;
            gap: 9px;
            letter-spacing: -0.4px;
            white-space: nowrap;
        }

            .logo i {
                color: var(--secondary-color);
            }

        .nav-links {
            display: flex;
            align-items: center;
            gap: 28px;
            font-size: 14.5px;
            font-weight: 500;
            white-space: nowrap;
        }

            .nav-links a {
                position: relative;
                padding: 6px 0;
                color: #2d3533;
                transition: color 0.2s ease;
            }

                .nav-links a::after {
                    content: "";
                    position: absolute;
                    left: 0;
                    bottom: 0;
                    width: 0;
                    height: 2px;
                    background-color: var(--secondary-color);
                    border-radius: 2px;
                    transition: width 0.25s ease;
                }

                .nav-links a:hover,
                .nav-links a.active {
                    color: var(--secondary-color);
                    font-weight: 600;
                }

                    .nav-links a:hover::after,
                    .nav-links a.active::after {
                        width: 100%;
                    }

        .header-actions {
            display: flex;
            align-items: center;
            gap: 16px;
        }

            .header-actions form {
                margin: 0;
            }

        .search-bar {
            background: #f3f5f6;
            border: 1px solid transparent;
            border-radius: 999px;
            padding: 8px 16px;
            display: flex;
            align-items: center;
            width: 260px;
            transition: all 0.2s ease;
        }

            .search-bar:focus-within {
                background: #fff;
                border-color: var(--secondary-color);
                box-shadow: 0 0 0 3px rgba(26, 143, 109, 0.12);
            }

            .search-bar input {
                border: none;
                background: transparent;
                outline: none;
                padding-left: 10px;
                width: 100%;
                font-family: inherit;
                font-size: 13.5px;
                color: var(--text-dark);
            }

        .icon-btn {
            font-size: 19px;
            color: var(--text-dark);
            cursor: pointer;
            position: relative;
            width: 38px;
            height: 38px;
            border-radius: 50%;
            display: inline-flex;
            align-items: center;
            justify-content: center;
            transition: background 0.2s;
            flex-shrink: 0;
        }

            .icon-btn:hover {
                background: #f2f5f4;
                color: var(--primary-color);
            }

        .cart-badge {
            position: absolute;
            top: 0;
            right: -2px;
            background: var(--secondary-color);
            color: #fff;
            font-size: 10.5px;
            min-width: 18px;
            height: 18px;
            padding: 0 5px;
            border-radius: 999px;
            font-weight: 700;
            display: inline-flex;
            align-items: center;
            justify-content: center;
        }

        /* USER DROPDOWN */
        .user-dropdown {
            position: relative;
            display: inline-block;
        }

        .user-trigger {
            display: flex;
            align-items: center;
            gap: 8px;
            background-color: #e8f5f1;
            color: var(--primary-color);
            padding: 7px 14px;
            border-radius: 999px;
            font-size: 13.5px;
            font-weight: 600;
            cursor: pointer;
            transition: 0.25s;
            user-select: none;
            white-space: nowrap;
        }

            .user-trigger:hover {
                background-color: var(--secondary-color);
                color: #fff;
            }

        .user-dropdown-menu {
            opacity: 0;
            visibility: hidden;
            transform: translateY(-6px);
            position: absolute;
            right: 0;
            top: calc(100% + 8px);
            background: #fff;
            box-shadow: 0 10px 28px rgba(0,0,0,0.12);
            border: 1px solid #eaeaea;
            border-radius: 12px;
            min-width: 205px;
            z-index: 1000;
            transition: opacity 0.2s ease, transform 0.2s ease, visibility 0s linear 0.35s;
        }

            .user-dropdown-menu::before {
                content: "";
                position: absolute;
                top: -15px;
                left: 0;
                width: 100%;
                height: 18px;
                background: transparent;
            }

        .user-dropdown:hover .user-dropdown-menu,
        .user-dropdown.open .user-dropdown-menu {
            opacity: 1;
            visibility: visible;
            transform: translateY(0);
            transition: opacity 0.2s ease, transform 0.2s ease, visibility 0s linear 0s;
        }

        .user-dropdown-menu a {
            padding: 11px 18px;
            display: block;
            border-bottom: 1px solid #f1f3f2;
            font-size: 13.5px;
            font-weight: 500;
        }

            .user-dropdown-menu a:first-child {
                border-radius: 12px 12px 0 0;
            }

            .user-dropdown-menu a:last-child {
                border-bottom: none;
                border-radius: 0 0 12px 12px;
            }

            .user-dropdown-menu a:hover {
                background: #f5faf8;
                color: var(--secondary-color);
            }

        /* ================= 3. NỘI DUNG TRANG ĐƠN HÀNG ================= */
        .orders-page {
            flex: 1;
            padding: 34px 0 64px 0;
        }

        .orders-inner {
            max-width: 1080px;
            margin: 0 auto;
        }

        .breadcrumb-bar {
            display: flex;
            align-items: center;
            gap: 8px;
            font-size: 13px;
            color: var(--text-gray);
            margin-bottom: 20px;
        }

            .breadcrumb-bar a:hover {
                color: var(--secondary-color);
            }

            .breadcrumb-bar span.current {
                color: var(--primary-color);
                font-weight: 600;
            }

        .page-header-row {
            display: flex;
            justify-content: space-between;
            align-items: flex-end;
            margin-bottom: 22px;
            flex-wrap: wrap;
            gap: 12px;
        }

        .page-eyebrow {
            display: block;
            font-size: 11.5px;
            font-weight: 700;
            letter-spacing: 1.2px;
            text-transform: uppercase;
            color: var(--secondary-color);
            margin-bottom: 4px;
        }

        .page-heading {
            font-size: 26px;
            font-weight: 800;
            color: var(--text-dark);
            margin: 0;
            letter-spacing: -0.4px;
            display: flex;
            align-items: center;
            gap: 10px;
        }

            .page-heading i {
                color: var(--secondary-color);
                font-size: 22px;
            }

        .order-count-badge {
            background: #e8f5f1;
            color: var(--primary-color);
            font-size: 13px;
            font-weight: 700;
            padding: 6px 14px;
            border-radius: 999px;
            border: 1px solid #cce5de;
        }

        /* THANH TÌM KIẾM ĐƠN HÀNG */
        .order-search-box {
            background: #ffffff;
            border-radius: 16px;
            border: 1px solid #e7ecea;
            padding: 14px 18px;
            margin-bottom: 18px;
            display: flex;
            gap: 12px;
            align-items: center;
            box-shadow: 0 6px 20px rgba(11, 22, 19, 0.03);
        }

        .order-search-input-wrap {
            flex: 1;
            display: flex;
            align-items: center;
            background: #f3f5f6;
            border: 1px solid transparent;
            border-radius: 999px;
            padding: 0 18px;
            height: 42px;
            transition: all 0.2s ease;
        }

            .order-search-input-wrap:focus-within {
                border-color: var(--secondary-color);
                background: #ffffff;
                box-shadow: 0 0 0 3px rgba(26, 143, 109, 0.12);
            }

            .order-search-input-wrap input {
                border: none;
                background: transparent;
                outline: none;
                width: 100%;
                padding-left: 10px;
                font-family: inherit;
                font-size: 13.5px;
                color: var(--text-dark);
            }

        .btn-order-search {
            height: 42px;
            padding: 0 24px;
            background: #141f1c;
            color: #ffffff;
            border: none;
            border-radius: 999px;
            font-family: inherit;
            font-size: 13.5px;
            font-weight: 600;
            cursor: pointer;
            display: inline-flex;
            align-items: center;
            gap: 8px;
            transition: all 0.25s ease;
            white-space: nowrap;
        }

            .btn-order-search:hover {
                background: var(--secondary-color);
            }

        .btn-order-reset {
            height: 42px;
            padding: 0 18px;
            background: #ffffff;
            color: var(--text-gray);
            border: 1px solid #dce3e1;
            border-radius: 999px;
            font-size: 13.5px;
            font-weight: 600;
            display: inline-flex;
            align-items: center;
            gap: 6px;
            transition: all 0.2s ease;
            white-space: nowrap;
        }

            .btn-order-reset:hover {
                background: #f5faf8;
                border-color: var(--secondary-color);
                color: var(--primary-color);
            }

        /* TABS TRẠNG THÁI ĐƠN HÀNG */
        .status-tabs-bar {
            background: #ffffff;
            border-radius: 16px;
            border: 1px solid #e7ecea;
            display: flex;
            overflow-x: auto;
            margin-bottom: 24px;
            box-shadow: 0 6px 20px rgba(11, 22, 19, 0.03);
        }

        .status-tab-item {
            flex: 1;
            min-width: 135px;
            text-align: center;
            padding: 15px 14px;
            font-size: 13.5px;
            font-weight: 600;
            color: var(--text-gray);
            border-bottom: 3px solid transparent;
            transition: all 0.2s ease;
            white-space: nowrap;
        }

            .status-tab-item:hover {
                color: var(--secondary-color);
                background: #f7fbf9;
            }

            .status-tab-item.active {
                color: var(--primary-color);
                border-bottom-color: var(--secondary-color);
                background: #eef8f4;
            }

        /* GOM NHÓM THEO TRẠNG THÁI */
        .status-group-section {
            margin-bottom: 30px;
        }

        .status-group-header {
            display: flex;
            justify-content: space-between;
            align-items: center;
            margin-bottom: 14px;
            padding: 11px 18px;
            background: #e8f5f1;
            border-left: 4px solid var(--secondary-color);
            border-radius: 10px;
        }

        .status-group-title {
            font-size: 15.5px;
            font-weight: 700;
            color: var(--primary-color);
            display: flex;
            align-items: center;
            gap: 8px;
        }

            .status-group-title i {
                color: var(--secondary-color);
            }

        .status-group-count {
            font-size: 12.5px;
            font-weight: 600;
            color: var(--primary-color);
            background: #ffffff;
            padding: 3px 10px;
            border-radius: 999px;
        }

        /* THẺ ĐƠN HÀNG */
        .order-card {
            background: #ffffff;
            border-radius: 16px;
            border: 1px solid #e7ecea;
            padding: 24px 28px;
            margin-bottom: 18px;
            box-shadow: 0 8px 24px rgba(11, 22, 19, 0.04);
            transition: all 0.25s ease;
        }

            .order-card:hover {
                border-color: #cce5de;
                box-shadow: 0 12px 28px rgba(11, 77, 60, 0.07);
            }

        .order-header {
            border-bottom: 1px solid #eef1f0;
            padding-bottom: 14px;
            margin-bottom: 18px;
            display: flex;
            justify-content: space-between;
            align-items: center;
            flex-wrap: wrap;
            gap: 10px;
        }

        .order-meta {
            display: flex;
            align-items: center;
            gap: 12px;
            font-size: 13.5px;
            color: var(--text-dark);
            flex-wrap: wrap;
        }

        .order-id {
            font-weight: 700;
            color: var(--primary-color);
            font-size: 15px;
        }

        .order-date {
            color: var(--text-gray);
            font-size: 13px;
            display: inline-flex;
            align-items: center;
            gap: 6px;
        }

        .order-status-pill {
            background: #e8f5f1;
            color: var(--primary-color);
            border: 1px solid #bfe3d7;
            font-weight: 700;
            font-size: 11.5px;
            padding: 5px 14px;
            border-radius: 999px;
            text-transform: uppercase;
            letter-spacing: 0.4px;
        }

            .order-status-pill.pending {
                background: #fef9ec;
                color: #b45309;
                border-color: #fde68a;
            }

            .order-status-pill.cancelled {
                background: #fdf2f2;
                color: #d93025;
                border-color: #f5c6cb;
            }

        /* DANH SÁCH SẢN PHẨM TRONG ĐƠN */
        .product-item {
            display: flex;
            align-items: center;
            gap: 18px;
            padding: 14px 0;
            border-bottom: 1px dashed #e6eae8;
        }

            .product-item:first-child {
                padding-top: 0;
            }

            .product-item:last-child {
                border-bottom: none;
                padding-bottom: 4px;
            }

        .product-thumb {
            width: 76px;
            height: 76px;
            flex-shrink: 0;
            background: #f6f8f7;
            border: 1px solid #e9eded;
            border-radius: 12px;
            padding: 8px;
            display: flex;
            align-items: center;
            justify-content: center;
        }

            .product-thumb img {
                max-width: 100%;
                max-height: 100%;
                object-fit: contain;
            }

        .product-info {
            flex: 1;
            min-width: 0;
        }

            .product-info h5 {
                margin: 0 0 7px 0;
                font-size: 15px;
                font-weight: 600;
                color: var(--text-dark);
                line-height: 1.4;
            }

                .product-info h5 a:hover {
                    color: var(--secondary-color);
                }

        .product-qty {
            font-size: 12.5px;
            color: var(--text-gray);
            background: #f3f5f6;
            display: inline-block;
            padding: 3px 11px;
            border-radius: 999px;
            font-weight: 600;
        }

        .product-right {
            display: flex;
            flex-direction: column;
            align-items: flex-end;
            gap: 9px;
        }

        .product-price {
            font-weight: 800;
            font-size: 15.5px;
            color: var(--primary-color);
            white-space: nowrap;
        }

        .item-mini-actions {
            display: flex;
            gap: 8px;
        }

        .btn-item-detail {
            font-size: 12px;
            font-weight: 600;
            color: var(--primary-color);
            background: #f4faf8;
            border: 1px solid #cce5de;
            padding: 5px 12px;
            border-radius: 999px;
            transition: all 0.2s ease;
        }

            .btn-item-detail:hover {
                background: #e8f5f1;
                border-color: var(--secondary-color);
            }

        .btn-item-rebuy {
            font-size: 12px;
            font-weight: 600;
            color: #ffffff;
            background: #141f1c;
            padding: 5px 12px;
            border-radius: 999px;
            transition: all 0.2s ease;
        }

            .btn-item-rebuy:hover {
                background: var(--secondary-color);
            }

        /* FOOTER ĐƠN HÀNG */
        .order-footer {
            border-top: 1px solid #eef1f0;
            margin-top: 16px;
            padding-top: 16px;
            display: flex;
            justify-content: space-between;
            align-items: center;
            flex-wrap: wrap;
            gap: 14px;
        }

        .total-group {
            display: flex;
            align-items: baseline;
            gap: 8px;
        }

        .total-label {
            font-size: 13.5px;
            color: var(--text-gray);
            font-weight: 500;
        }

        .total-price {
            font-size: 20px;
            color: #d93025;
            font-weight: 800;
        }

        .order-actions {
            display: flex;
            align-items: center;
            gap: 12px;
        }

        .btn-rebuy {
            display: inline-flex;
            align-items: center;
            gap: 8px;
            padding: 10px 22px;
            border-radius: 999px;
            background: #141f1c;
            color: #ffffff;
            font-size: 13.5px;
            font-weight: 600;
            transition: all 0.25s ease;
        }

            .btn-rebuy:hover {
                background: var(--secondary-color);
                transform: translateY(-1px);
                box-shadow: 0 6px 16px rgba(26, 143, 109, 0.24);
            }

        /* XEM THÊM */
        .see-more-row {
            text-align: center;
            margin-top: 8px;
        }

        .btn-see-more {
            display: inline-flex;
            align-items: center;
            gap: 8px;
            padding: 10px 24px;
            border-radius: 999px;
            background: #ffffff;
            color: var(--primary-color);
            border: 1px solid #cce5de;
            font-size: 13.5px;
            font-weight: 600;
            transition: all 0.2s ease;
        }

            .btn-see-more:hover {
                background: #e8f5f1;
                border-color: var(--secondary-color);
            }

        /* EMPTY STATE */
        .empty-orders-box {
            background: #ffffff;
            border-radius: 16px;
            border: 1px solid #e7ecea;
            text-align: center;
            padding: 72px 24px;
            box-shadow: 0 8px 24px rgba(11, 22, 19, 0.04);
        }

        .empty-icon {
            width: 82px;
            height: 82px;
            border-radius: 50%;
            background: #e8f5f1;
            color: var(--secondary-color);
            display: inline-flex;
            align-items: center;
            justify-content: center;
            font-size: 32px;
            margin-bottom: 18px;
        }

        .empty-orders-box h4 {
            margin: 0 0 8px 0;
            font-size: 19px;
            font-weight: 800;
            color: var(--text-dark);
        }

        .empty-orders-box p {
            margin: 0 0 24px 0;
            font-size: 14px;
            color: var(--text-gray);
        }

        /* ================= 4. SERVICE STRIP ================= */
        .service-strip {
            border-top: 1px solid #ecefef;
            background: #fafcfb;
            padding: 32px 0;
            margin-top: auto;
        }

        .service-grid {
            max-width: var(--container-max);
            margin: 0 auto;
            padding: 0 32px;
            display: grid;
            grid-template-columns: repeat(4, 1fr);
            gap: 24px;
        }

        .service-box {
            display: flex;
            align-items: center;
            gap: 14px;
        }

            .service-box .srv-icon {
                width: 44px;
                height: 44px;
                border-radius: 12px;
                background: #e8f5f1;
                color: var(--secondary-color);
                display: inline-flex;
                align-items: center;
                justify-content: center;
                font-size: 18px;
                flex-shrink: 0;
            }

            .service-box h4 {
                margin: 0 0 3px 0;
                font-size: 14.5px;
                font-weight: 700;
                color: var(--text-dark);
            }

            .service-box p {
                margin: 0;
                font-size: 12.5px;
                color: var(--text-gray);
            }

        /* ================= 5. MULTI-COLUMN DARK FOOTER ================= */
        .voltix-footer {
            background-color: #0b1411;
            color: #b7c4c0;
            padding-top: 52px;
        }

        .footer-grid {
            max-width: var(--container-max);
            margin: 0 auto;
            padding: 0 32px 40px 32px;
            display: grid;
            grid-template-columns: 1.4fr 1fr 1fr 1fr 1.2fr;
            gap: 32px;
        }

        .footer-brand .logo {
            color: #ffffff;
            margin-bottom: 14px;
        }

        .footer-brand p {
            font-size: 13px;
            line-height: 1.6;
            color: #93a39e;
            margin: 0 0 20px 0;
        }

        .social-links {
            display: flex;
            gap: 10px;
        }

            .social-links a {
                width: 34px;
                height: 34px;
                border-radius: 50%;
                background: rgba(255,255,255,0.08);
                color: #ffffff;
                display: inline-flex;
                align-items: center;
                justify-content: center;
                font-size: 13.5px;
                transition: background 0.2s;
            }

                .social-links a:hover {
                    background: var(--secondary-color);
                }

        .footer-col h4 {
            color: #ffffff;
            font-size: 14px;
            font-weight: 700;
            margin: 0 0 16px 0;
        }

        .footer-col ul {
            list-style: none;
            padding: 0;
            margin: 0;
            display: flex;
            flex-direction: column;
            gap: 10px;
            font-size: 13px;
        }

            .footer-col ul a:hover {
                color: #5eead4;
            }

        .app-badges {
            display: flex;
            flex-direction: column;
            gap: 10px;
            margin-top: 14px;
        }

        .app-badge-btn {
            display: inline-flex;
            align-items: center;
            gap: 10px;
            background: rgba(255,255,255,0.07);
            border: 1px solid rgba(255,255,255,0.14);
            color: #ffffff;
            padding: 8px 14px;
            border-radius: 10px;
            font-size: 12px;
            transition: background 0.2s;
        }

            .app-badge-btn:hover {
                background: rgba(255,255,255,0.14);
            }

            .app-badge-btn i {
                font-size: 18px;
            }

        .footer-bottom {
            border-top: 1px solid rgba(255,255,255,0.08);
            padding: 18px 0;
            font-size: 12.5px;
            color: #7f908b;
        }

            .footer-bottom .page-container {
                display: flex;
                justify-content: space-between;
                align-items: center;
            }

        .footer-legal {
            display: flex;
            gap: 18px;
        }

            .footer-legal a:hover {
                color: #ffffff;
            }

        /* ================= RESPONSIVE ================= */
        @@media (max-width: 1180px) {
            .nav-links {
                gap: 20px;
            }

            .search-bar {
                width: 210px;
            }
        }

        @@media (max-width: 1024px) {
            .footer-grid {
                grid-template-columns: repeat(2, 1fr);
            }
        }

        @@media (max-width: 820px) {
            .top-promo-bar,
            .nav-links,
            .search-bar {
                display: none;
            }

            .page-container {
                padding: 0 20px;
            }

            .orders-page {
                padding: 24px 0 48px 0;
            }

            .order-search-box {
                flex-direction: column;
                align-items: stretch;
            }

            .btn-order-search,
            .btn-order-reset {
                justify-content: center;
            }

            .order-card {
                padding: 20px 18px;
            }

            .product-item {
                flex-wrap: wrap;
            }

            .product-right {
                width: 100%;
                flex-direction: row;
                justify-content: space-between;
                align-items: center;
            }

            .order-footer {
                flex-direction: column;
                align-items: flex-start;
            }

            .order-actions {
                width: 100%;
            }

                .order-actions a {
                    flex: 1;
                    justify-content: center;
                }

            .service-grid {
                grid-template-columns: 1fr;
            }
        }
    </style>
</head>
<body>

    <!-- 1. TOP ANNOUNCEMENT BAR -->
    <div class="top-promo-bar">
        <div class="page-container">
            <div class="promo-highlights">
                <span>Miễn phí vận chuyển cho đơn từ 500.000đ</span>
                <span class="sep">|</span>
                <span>Đổi trả dễ dàng 30 ngày</span>
                <span class="sep">|</span>
                <span>Công nghệ chính hãng 100%</span>
            </div>
            <div class="promo-meta">
                <span>VND</span>
                <span style="color:#4b5c57;">|</span>
                <span>Tiếng Việt</span>
            </div>
        </div>
    </div>

    <!-- 2. MAIN HEADER -->
    <header class="header-top">
        <div class="page-container">
            <a href="@Url.Action("Index", "Home")" class="logo">
                <i class="fas fa-shopping-bag"></i> PHONE & ACCES
            </a>

            <nav class="nav-links">
                <a href="@Url.Action("Index", "Home")">Trang chủ</a>
                <a href="@Url.Action("PageDienThoai", "Home")">Điện thoại</a>
                <a href="@Url.Action("PagePhuKien", "Home")">Phụ kiện</a>
                <a href="@Url.Action("PageThietBi", "Home")">Đồng hồ</a>
                <a href="#footer">Hỗ trợ</a>
            </nav>

            <div class="header-actions">
                @using (Html.BeginForm("Index", "Home", FormMethod.Get))
                {
                    <div class="search-bar">
                        <i class="fas fa-search" style="color:#8b9693; font-size:13px;"></i>
                        <input type="text" name="searchTerm" placeholder="Tìm sản phẩm..." />
                        <button type="submit" style="display:none;"></button>
                    </div>
                }

                @if (Session["Username"] != null)
                {
                    <div class="user-dropdown">
                        <div class="user-trigger" onclick="this.parentElement.classList.toggle('open')">
                            <i class="fas fa-user-circle" style="font-size: 17px;"></i>
                            <span>@Session["Username"]</span>
                            <i class="fas fa-chevron-down" style="font-size: 10px;"></i>
                        </div>
                        <div class="user-dropdown-menu">
                            <a href="@Url.Action("ProfileInfo", "Account")">Thông tin tài khoản</a>
                            <a href="@Url.Action("MyOrder", "Order")">Đơn hàng của tôi</a>
                            <a href="@Url.Action("Logout", "Account")" style="color: #d9534f;">Đăng xuất</a>
                        </div>
                    </div>
                }
                else
                {
                    <a href="@Url.Action("Login", "Account")" class="icon-btn" title="Đăng nhập">
                        <i class="far fa-user"></i>
                    </a>
                }

                <a href="@Url.Action("Index", "Cart")" class="icon-btn" title="Giỏ hàng">
                    <i class="fas fa-shopping-cart"></i>
                    <span class="cart-badge">@cartCount</span>
                </a>
            </div>
        </div>
    </header>

    <!-- 3. NỘI DUNG ĐƠN HÀNG -->
    <main class="orders-page">
        <div class="page-container">
            <div class="orders-inner">
                <div class="breadcrumb-bar">
                    <a href="@Url.Action("Index", "Home")"><i class="fas fa-home"></i> Trang chủ</a>
                    <span>/</span>
                    <span class="current">Đơn hàng của tôi</span>
                </div>

                <div class="page-header-row">
                    <div>
                        <span class="page-eyebrow">Tài khoản & Giao dịch</span>
                        <h1 class="page-heading">
                            <i class="fas fa-box-open"></i> Đơn hàng của tôi
                        </h1>
                    </div>
                    @if (allOrders.Any())
                    {
                        <span class="order-count-badge">@allOrders.Count đơn hàng</span>
                    }
                </div>

                <!-- PHẦN TÌM KIẾM ĐƠN HÀNG -->
                @using (Html.BeginForm("MyOrder", "Order", FormMethod.Get, new { @class = "order-search-box" }))
                {
                    <input type="hidden" name="status" value="@selectedStatus" />
                    <div class="order-search-input-wrap">
                        <i class="fas fa-search" style="color: #8b9693; font-size: 13.5px;"></i>
                        <input type="text"
                               name="searchTerm"
                               value="@searchTerm"
                               placeholder="Tìm theo Mã đơn hàng hoặc Tên sản phẩm..." />
                    </div>
                    <button type="submit" class="btn-order-search">
                        <i class="fas fa-search"></i> Tìm kiếm
                    </button>
                    if (!string.IsNullOrWhiteSpace(searchTerm))
                    {
                        <a href="@Url.Action("MyOrder", "Order", new { status = selectedStatus })" class="btn-order-reset">
                            <i class="fas fa-times"></i> Xóa lọc
                        </a>
                    }
                }

                <!-- CÁC TAB TRẠNG THÁI ĐƠN HÀNG -->
                <div class="status-tabs-bar">
                    @foreach (var tab in statusTabs)
                    {
                        bool isActive = selectedStatus == tab;
                        <a href="@Url.Action("MyOrder", "Order", new { status = tab, searchTerm = searchTerm, showAll = false })"
                           class="status-tab-item @(isActive ? "active" : "")">
                            @tab
                        </a>
                    }
                </div>

                <!-- DANH SÁCH ĐƠN HÀNG -->
                @if (!allOrders.Any())
                {
                    <div class="empty-orders-box">
                        <div class="empty-icon">
                            <i class="fas fa-file-invoice"></i>
                        </div>
                        <h4>BẠN CHƯA CÓ ĐƠN HÀNG NÀO</h4>
                        <p>Hãy khám phá các sản phẩm công nghệ chính hãng và đặt đơn đầu tiên ngay hôm nay.</p>
                        <a href="@Url.Action("Index", "Home")" class="btn-rebuy" style="padding: 12px 28px; font-size: 14.5px;">
                            <i class="fas fa-store"></i> Về trang chủ mua sắm ngay
                        </a>
                    </div>
                }
                else if (selectedStatus == "Tất cả đơn")
                {
                    <!-- TAB TẤT CẢ ĐƠN: GOM NHÓM THEO TRẠNG THÁI ĐƠN (2 ĐƠN GẦN NHẤT / NHÓM) -->
                    foreach (var groupName in groupStatuses)
                    {
                        var groupOrders = allOrders
                            .Where(o => o.PaymentStatus == groupName)
                            .OrderByDescending(o => o.OrderDate)
                            .ToList();

                        if (groupOrders.Any())
                        {
                            var visibleOrders = groupOrders.Take(2).ToList();
                            <section class="status-group-section">
                                <div class="status-group-header">
                                    <span class="status-group-title">
                                        <i class="fas fa-tag"></i> @groupName
                                    </span>
                                    <span class="status-group-count">
                                        Hiển thị @visibleOrders.Count / @groupOrders.Count đơn hàng
                                    </span>
                                </div>

                                @foreach (var order in visibleOrders)
                                {
                                    string statusClass = order.PaymentStatus == "Đã hủy"
                                        ? "cancelled"
                                        : (order.PaymentStatus == "Chờ thanh toán" ? "pending" : "");

                                    <div class="order-card">
                                        <div class="order-header">
                                            <div class="order-meta">
                                                <span class="order-id">Mã đơn hàng: #@order.OrderID</span>
                                                <span style="color:#dce3e1;">|</span>
                                                <span class="order-date">
                                                    <i class="far fa-clock"></i> Ngày đặt: @order.OrderDate.ToString("dd/MM/yyyy HH:mm")
                                                </span>
                                            </div>
                                            <span class="order-status-pill @statusClass">
                                                @order.PaymentStatus
                                            </span>
                                        </div>

                                        <div class="order-body">
                                            @foreach (var detail in order.OrderDetails)
                                            {
                                                <div class="product-item">
                                                    <div class="product-thumb">
                                                        <img src="@(detail.Product != null ? detail.Product.ProductImage : "/Images/default.png")" alt="Product" />
                                                    </div>
                                                    <div class="product-info">
                                                        <h5>
                                                            @if (detail.Product != null)
                                                            {
                                                                <a href="@Url.Action("ProductDetails", "Home", new { id = detail.Product.ProductID })">
                                                                    @detail.Product.ProductName
                                                                </a>
                                                            }
                                                            else
                                                            {
                                                                <span>Sản phẩm</span>
                                                            }
                                                        </h5>
                                                        <span class="product-qty">Số lượng: x@(detail.Quantity)</span>
                                                    </div>
                                                    <div class="product-right">
                                                        <div class="product-price">
                                                            @detail.UnitPrice.ToString("#,##0").Replace(",", ".") đ
                                                        </div>
                                                        <div class="item-mini-actions">
                                                            <a href="@Url.Action("ProductDetails", "Home", new { id = detail.ProductID })" class="btn-item-detail">
                                                                Xem chi tiết
                                                            </a>
                                                            <a href="@Url.Action("BuyAgain", "Order", new { id = order.OrderID, productId = detail.ProductID })" class="btn-item-rebuy">
                                                                Mua lại
                                                            </a>
                                                        </div>
                                                    </div>
                                                </div>
                                            }
                                        </div>

                                        <div class="order-footer">
                                            <div class="total-group">
                                                <span class="total-label">Tổng tiền:</span>
                                                <span class="total-price">@order.TotalAmount.ToString("#,##0").Replace(",", ".") đ</span>
                                            </div>

                                            <div class="order-actions">
                                                <a href="@Url.Action("BuyAgain", "Order", new { id = order.OrderID })" class="btn-rebuy">
                                                    <i class="fas fa-redo-alt"></i> Mua lại đơn hàng
                                                </a>
                                            </div>
                                        </div>
                                    </div>
                                }

                                @if (groupOrders.Count > 2)
                                {
                                    <div class="see-more-row">
                                        <a href="@Url.Action("MyOrder", "Order", new { status = groupName, searchTerm = searchTerm, showAll = true })" class="btn-see-more">
                                            Xem thêm (@(groupOrders.Count > 50 ? 50 : groupOrders.Count) đơn gần nhất) <i class="fas fa-chevron-right"></i>
                                        </a>
                                    </div>
                                }
                            </section>
                        }
                    }
                }
                else
                {
                    <!-- CÁC TAB TRẠNG THÁI CỤ THỂ (2 ĐƠN GẦN NHẤT HOẶC TỐI ĐA 50 ĐƠN KHI BẤM XEM THÊM) -->
                    foreach (var order in allOrders)
                    {
                        string statusClass = order.PaymentStatus == "Đã hủy"
                            ? "cancelled"
                            : (order.PaymentStatus == "Chờ thanh toán" ? "pending" : "");

                        <div class="order-card">
                            <div class="order-header">
                                <div class="order-meta">
                                    <span class="order-id">Mã đơn hàng: #@order.OrderID</span>
                                    <span style="color:#dce3e1;">|</span>
                                    <span class="order-date">
                                        <i class="far fa-clock"></i> Ngày đặt: @order.OrderDate.ToString("dd/MM/yyyy HH:mm")
                                    </span>
                                </div>
                                <span class="order-status-pill @statusClass">
                                    @order.PaymentStatus
                                </span>
                            </div>

                            <div class="order-body">
                                @foreach (var detail in order.OrderDetails)
                                {
                                    <div class="product-item">
                                        <div class="product-thumb">
                                            <img src="@(detail.Product != null ? detail.Product.ProductImage : "/Images/default.png")" alt="Product" />
                                        </div>
                                        <div class="product-info">
                                            <h5>
                                                @if (detail.Product != null)
                                                {
                                                    <a href="@Url.Action("ProductDetails", "Home", new { id = detail.Product.ProductID })">
                                                        @detail.Product.ProductName
                                                    </a>
                                                }
                                                else
                                                {
                                                    <span>Sản phẩm</span>
                                                }
                                            </h5>
                                            <span class="product-qty">Số lượng: x@(detail.Quantity)</span>
                                        </div>
                                        <div class="product-right">
                                            <div class="product-price">
                                                @detail.UnitPrice.ToString("#,##0").Replace(",", ".") đ
                                            </div>
                                            <div class="item-mini-actions">
                                                <a href="@Url.Action("ProductDetails", "Home", new { id = detail.ProductID })" class="btn-item-detail">
                                                    Xem chi tiết
                                                </a>
                                                <a href="@Url.Action("BuyAgain", "Order", new { id = order.OrderID, productId = detail.ProductID })" class="btn-item-rebuy">
                                                    Mua lại
                                                </a>
                                            </div>
                                        </div>
                                    </div>
                                }
                            </div>

                            <div class="order-footer">
                                <div class="total-group">
                                    <span class="total-label">Tổng tiền:</span>
                                    <span class="total-price">@order.TotalAmount.ToString("#,##0").Replace(",", ".") đ</span>
                                </div>

                                <div class="order-actions">
                                    <a href="@Url.Action("BuyAgain", "Order", new { id = order.OrderID })" class="btn-rebuy">
                                        <i class="fas fa-redo-alt"></i> Mua lại đơn hàng
                                    </a>
                                </div>
                            </div>
                        </div>
                    }

                    if (ViewBag.HasMore != null && (bool)ViewBag.HasMore)
                    {
                        <div class="see-more-row">
                            <a href="@Url.Action("MyOrder", "Order", new { status = selectedStatus, searchTerm = searchTerm, showAll = true })" class="btn-see-more">
                                Xem thêm (tối đa 50 đơn hàng gần nhất) <i class="fas fa-chevron-down"></i>
                            </a>
                        </div>
                    }
                }
            </div>
        </div>
    </main>

    <!-- 4. SERVICE STRIP -->
    <div class="service-strip">
        <div class="service-grid">
            <div class="service-box">
                <span class="srv-icon"><i class="fas fa-truck"></i></span>
                <div>
                    <h4>Miễn phí vận chuyển</h4>
                    <p>Cho đơn hàng từ 500.000đ</p>
                </div>
            </div>

            <div class="service-box">
                <span class="srv-icon"><i class="fas fa-undo-alt"></i></span>
                <div>
                    <h4>Đổi trả 30 ngày</h4>
                    <p>Bảo hành 1 đổi 1 dễ dàng</p>
                </div>
            </div>

            <div class="service-box">
                <span class="srv-icon"><i class="fas fa-headset"></i></span>
                <div>
                    <h4>Hỗ trợ 24/7</h4>
                    <p>Tư vấn kỹ thuật tận tâm</p>
                </div>
            </div>

            <div class="service-box">
                <span class="srv-icon"><i class="fas fa-shield-alt"></i></span>
                <div>
                    <h4>Thanh toán bảo mật</h4>
                    <p>Hỗ trợ PayPal & COD an toàn</p>
                </div>
            </div>
        </div>
    </div>

    <!-- 5. MULTI-COLUMN DARK FOOTER -->
    <footer class="voltix-footer" id="footer">
        <div class="footer-grid">
            <div class="footer-brand">
                <a href="@Url.Action("Index", "Home")" class="logo">
                    <i class="fas fa-shopping-bag"></i> PHONE & ACCES
                </a>
                <p>Hệ thống bán lẻ điện thoại thông minh, đồng hồ và phụ kiện công nghệ chính hãng hàng đầu dành cho bạn.</p>
                <div class="social-links">
                    <a href="#"><i class="fab fa-facebook-f"></i></a>
                    <a href="#"><i class="fab fa-instagram"></i></a>
                    <a href="#"><i class="fab fa-youtube"></i></a>
                    <a href="#"><i class="fab fa-tiktok"></i></a>
                </div>
            </div>

            <div class="footer-col">
                <h4>Danh mục</h4>
                <ul>
                    <li><a href="@Url.Action("PageDienThoai", "Home")">Điện thoại</a></li>
                    <li><a href="@Url.Action("PagePhuKien", "Home")">Phụ kiện</a></li>
                    <li><a href="@Url.Action("PageThietBi", "Home")">Đồng hồ thông minh</a></li>
                    <li><a href="@Url.Action("Index", "Home")#featured">Sản phẩm nổi bật</a></li>
                </ul>
            </div>

            <div class="footer-col">
                <h4>Về chúng tôi</h4>
                <ul>
                    <li><a href="#footer">Giới thiệu cửa hàng</a></li>
                    <li><a href="#footer">Chính sách bảo hành</a></li>
                    <li><a href="#footer">Tin tức công nghệ</a></li>
                    <li><a href="#footer">Hệ thống chi nhánh</a></li>
                </ul>
            </div>

            <div class="footer-col">
                <h4>Hỗ trợ khách hàng</h4>
                <ul>
                    <li><a href="@Url.Action("MyOrder", "Order")">Tra cứu đơn hàng</a></li>
                    <li><a href="@Url.Action("ProfileInfo", "Account")">Tài khoản của tôi</a></li>
                    <li><a href="#footer">Hướng dẫn thanh toán PayPal</a></li>
                    <li><a href="#footer">Chính sách đổi trả</a></li>
                </ul>
            </div>

            <div class="footer-col">
                <h4>Tải ứng dụng</h4>
                <p style="font-size:12.5px; color:#93a39e; margin:0;">Trải nghiệm mua sắm tiện lợi hơn trên điện thoại.</p>
                <div class="app-badges">
                    <a href="#footer" class="app-badge-btn">
                        <i class="fab fa-apple"></i>
                        <span>Tải về trên <strong>App Store</strong></span>
                    </a>
                    <a href="#footer" class="app-badge-btn">
                        <i class="fab fa-google-play"></i>
                        <span>Tải về trên <strong>Google Play</strong></span>
                    </a>
                </div>
            </div>
        </div>

        <div class="footer-bottom">
            <div class="page-container">
                <span>© 2026 PHONE & ACCES. All rights reserved.</span>
                <div class="footer-legal">
                    <a href="#footer">Chính sách bảo mật</a>
                    <a href="#footer">Điều khoản dịch vụ</a>
                    <a href="#footer">Sơ đồ trang</a>
                </div>
            </div>
        </div>
    </footer>

    <script>
        document.addEventListener('click', function (e) {
            const dropdown = document.querySelector('.user-dropdown');
            if (dropdown && !dropdown.contains(e.target)) {
                dropdown.classList.remove('open');
            }
        });
    </script>

</body>
</html>