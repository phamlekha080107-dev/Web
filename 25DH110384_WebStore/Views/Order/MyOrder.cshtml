@model IEnumerable<_25DH110384_WebStore.Models.Order>

@{
    ViewBag.Title = "Đơn hàng của tôi";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<style>
    .order-card {
        background: #fff;
        border: 1px solid #e0e0e0;
        border-radius: 8px;
        margin-bottom: 20px;
        padding: 15px;
    }

    .order-header {
        border-bottom: 1px solid #f0f0f0;
        padding-bottom: 10px;
        margin-bottom: 15px;
        display: flex;
        justify-content: space-between;
    }

    .order-status {
        color: #007bff;
        font-weight: bold;
    }

    .product-item {
        display: flex;
        align-items: center;
        margin-bottom: 12px;
    }

    .product-img {
        width: 70px;
        height: 70px;
        object-fit: cover;
        border-radius: 4px;
        margin-right: 15px;
        border: 1px solid #eee;
    }

    .product-info {
        flex-grow: 1;
    }

    .order-footer {
        border-top: 1px solid #f0f0f0;
        padding-top: 12px;
        text-align: right;
    }

    .total-price {
        font-size: 16px;
        color: #fe3834;
        font-weight: bold;
    }
</style>

<div class="container" style="margin-top: 20px;">
    <h2>ĐƠN HÀNG CỦA TÔI</h2>
    <hr />

    @if (Model == null || !Model.Any())
    {
        <div class="alert alert-info">
            Bạn chưa có đơn hàng nào. @Html.ActionLink("Mua sắm ngay", "Index", "Home")
        </div>
    }
    else
    {
        foreach (var order in Model)
        {
            <div class="order-card">
                <div class="order-header">
                    <span><strong>Mã đơn hàng:</strong> #@order.OrderID | <strong>Ngày đặt:</strong> @order.OrderDate.ToString("dd/MM/yyyy HH:mm")</span>                    <span class="order-status">@order.PaymentStatus</span>
                </div>

                <div class="order-body">
                    @foreach (var detail in order.OrderDetails)
                    {
                        <div class="product-item">
                            <img src="@(detail.Product != null ? detail.Product.ProductImage : "/Images/default.png")" class="product-img" alt="Product" />
                            <div class="product-info">
                                <h5>@(detail.Product != null ? detail.Product.ProductName : "Sản phẩm")</h5>
                                <small class="text-muted">Số lượng: x@detail.Quantity</small>
                            </div>
                            <div class="product-price">
                                <span>@detail.UnitPrice.ToString("N0") đ</span>
                            </div>
                        </div>
                    }
                </div>

                <div class="order-footer">
                    <div>
                        <span>Tổng tiền: </span>
                        <span class="total-price">@order.TotalAmount.ToString("N0") đ</span>
                    </div>
                    <div style="margin-top: 10px;">
                        @Html.ActionLink("Xem chi tiết", "OrderSuccess", "Order", new { id = order.OrderID }, new { @class = "btn btn-default btn-sm" })
                        <a href="@Url.Action("Index", "Cart")" class="btn btn-primary btn-sm">Mua lại</a>
                    </div>
                </div>
            </div>
        }
    }
</div>