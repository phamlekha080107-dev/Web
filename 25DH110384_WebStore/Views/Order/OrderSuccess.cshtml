@model _25DH110384_WebStore.Models.Order

@{
    Layout = null;
    var cart = Session["Cart"] as _25DH110384_WebStore.Models.ViewModel.Cart;
    int cartCount = (cart != null && cart.Items != null) ? cart.Items.Count() : 0;
}

<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Đặt hàng thành công - PHONE & ACCES</title>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&display=swap" rel="stylesheet">

    <style>
        :root {
            --primary-color: #0b4d3c;
            --secondary-color: #1a8f6d;
            --bg-light: #f8f9fa;
            --text-dark: #333;
            --text-gray: #666;
            --border-radius: 14px;
        }

        html {
            scroll-behavior: smooth;
        }

        body {
            font-family: 'Inter', sans-serif;
            margin: 0;
            padding: 0;
            background-color: #f4f6f8;
            color: var(--text-dark);
            display: flex;
            flex-direction: column;
            min-height: 100vh;
        }

        a {
            text-decoration: none;
            color: inherit;
        }

        /* HEADER */
        .header-top {
            background-color: #fff;
            padding: 15px 50px;
            display: flex;
            align-items: center;
            justify-content: space-between;
            border-bottom: 1px solid #eee;
        }

        .logo {
            font-size: 24px;
            font-weight: 700;
            color: var(--primary-color);
            display: flex;
            align-items: center;
            gap: 10px;
        }

        .nav-links {
            display: flex;
            gap: 30px;
            font-weight: 500;
        }

            .nav-links a {
                position: relative;
                padding-bottom: 6px;
                transition: color 0.25s ease;
            }

                .nav-links a::after {
                    content: "";
                    position: absolute;
                    left: 0;
                    bottom: 0;
                    width: 0;
                    height: 2.5px;
                    background-color: var(--secondary-color);
                    border-radius: 2px;
                    transition: width 0.25s ease;
                }

                .nav-links a:hover {
                    color: var(--secondary-color);
                }

                    .nav-links a:hover::after {
                        width: 100%;
                    }

        .header-actions {
            display: flex;
            align-items: center;
            gap: 20px;
        }

        .search-bar {
            background: var(--bg-light);
            border-radius: 20px;
            padding: 8px 15px;
            display: flex;
            align-items: center;
        }

            .search-bar input {
                border: none;
                background: transparent;
                outline: none;
                padding-left: 10px;
                width: 200px;
            }

        .icon-btn {
            font-size: 20px;
            color: var(--text-dark);
            cursor: pointer;
            position: relative;
        }

        .cart-badge {
            position: absolute;
            top: -8px;
            right: -10px;
            background: var(--secondary-color);
            color: #fff;
            font-size: 11px;
            padding: 2px 6px;
            border-radius: 10px;
            font-weight: bold;
        }

        /* USER DROPDOWN */
        .user-dropdown {
            position: relative;
            display: inline-block;
        }

        .user-trigger {
            display: flex;
            align-items: center;
            gap: 8px;
            background-color: #e6f4f0;
            color: var(--primary-color);
            padding: 7px 14px;
            border-radius: 20px;
            font-size: 14px;
            font-weight: 600;
            cursor: pointer;
            transition: 0.3s;
            user-select: none;
        }

            .user-trigger:hover {
                background-color: var(--secondary-color);
                color: #fff;
            }

        .user-dropdown-menu {
            opacity: 0;
            visibility: hidden;
            transform: translateY(-6px);
            position: absolute;
            right: 0;
            top: calc(100% + 8px);
            background: #fff;
            box-shadow: 0 8px 20px rgba(0,0,0,0.12);
            border: 1px solid #eee;
            border-radius: 10px;
            min-width: 200px;
            z-index: 1000;
            transition: opacity 0.2s ease, transform 0.2s ease, visibility 0s linear 0.35s;
        }

            .user-dropdown-menu::before {
                content: "";
                position: absolute;
                top: -15px;
                left: 0;
                width: 100%;
                height: 18px;
                background: transparent;
            }

        .user-dropdown:hover .user-dropdown-menu,
        .user-dropdown.open .user-dropdown-menu {
            opacity: 1;
            visibility: visible;
            transform: translateY(0);
            transition: opacity 0.2s ease, transform 0.2s ease, visibility 0s linear 0s;
        }

        .user-dropdown-menu a {
            padding: 12px 20px;
            display: block;
            border-bottom: 1px solid #eee;
            font-size: 14px;
        }

            .user-dropdown-menu a:last-child {
                border-bottom: none;
            }

            .user-dropdown-menu a:hover {
                background: #f9f9f9;
                color: var(--secondary-color);
            }

        /* BREADCRUMB */
        .breadcrumb-bar {
            max-width: 900px;
            width: 100%;
            box-sizing: border-box;
            margin: 22px auto 0 auto;
            padding: 0 30px;
            font-size: 14px;
            color: var(--text-gray);
            display: flex;
            align-items: center;
            gap: 8px;
        }

            .breadcrumb-bar a:hover {
                color: var(--secondary-color);
            }

            .breadcrumb-bar span.current {
                color: var(--primary-color);
                font-weight: 600;
            }

        /* MAIN CONTAINER */
        .success-wrapper {
            max-width: 900px;
            width: 100%;
            box-sizing: border-box;
            margin: 20px auto 60px auto;
            padding: 0 30px;
            flex: 1;
        }

        .order-success-card {
            background: #fff;
            border-radius: var(--border-radius);
            border: 1px solid #eaeaea;
            padding: 38px 42px;
            box-shadow: 0 6px 24px rgba(0, 0, 0, 0.04);
        }

        /* PHẦN TIÊU ĐỀ THÀNH CÔNG */
        .success-hero {
            text-align: center;
            padding-bottom: 26px;
            margin-bottom: 26px;
            border-bottom: 2px solid #e6f4f0;
        }

        .success-icon-circle {
            width: 76px;
            height: 76px;
            border-radius: 50%;
            background: #e6f4f0;
            color: var(--secondary-color);
            display: inline-flex;
            align-items: center;
            justify-content: center;
            font-size: 36px;
            margin-bottom: 16px;
            box-shadow: 0 6px 16px rgba(26, 143, 109, 0.16);
        }

        .success-hero h1 {
            margin: 0 0 8px 0;
            font-size: 26px;
            font-weight: 700;
            color: var(--primary-color);
            letter-spacing: 0.3px;
        }

        .success-hero p {
            margin: 0;
            color: var(--text-gray);
            font-size: 15px;
        }

        /* KHỐI THÔNG TIN ĐƠN HÀNG */
        .info-grid-box {
            background: #f8fbfa;
            border: 1px solid #d9ede7;
            border-radius: 12px;
            padding: 20px 24px;
            margin-bottom: 28px;
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 14px 28px;
        }

        .info-item {
            display: flex;
            flex-direction: column;
            gap: 4px;
        }

            .info-item.full-width {
                grid-column: 1 / -1;
            }

        .info-label {
            font-size: 12px;
            font-weight: 600;
            text-transform: uppercase;
            color: var(--text-gray);
            letter-spacing: 0.4px;
        }

        .info-value {
            font-size: 15px;
            font-weight: 600;
            color: var(--text-dark);
        }

            .info-value.order-code {
                color: var(--secondary-color);
                font-weight: 700;
                font-size: 16px;
            }

        /* BẢNG CHI TIẾT SẢN PHẨM */
        .section-subtitle {
            font-size: 17px;
            font-weight: 700;
            color: var(--primary-color);
            margin: 0 0 14px 0;
            display: flex;
            align-items: center;
            gap: 8px;
        }

        .table-wrapper {
            border: 1px solid #eaeaea;
            border-radius: 12px;
            overflow: hidden;
            margin-bottom: 22px;
        }

        .detail-table {
            width: 100%;
            border-collapse: collapse;
        }

            .detail-table thead th {
                background-color: #f8f9fa;
                color: var(--text-gray);
                font-size: 13px;
                font-weight: 600;
                text-transform: uppercase;
                padding: 13px 16px;
                border-bottom: 1px solid #eaeaea;
                text-align: left;
            }

                .detail-table thead th.text-center {
                    text-align: center;
                }

                .detail-table thead th.text-right {
                    text-align: right;
                }

            .detail-table tbody td {
                padding: 14px 16px;
                border-bottom: 1px solid #f2f2f2;
                vertical-align: middle;
                font-size: 14px;
            }

            .detail-table tbody tr:last-child td {
                border-bottom: none;
            }

        .product-thumb {
            width: 60px;
            height: 60px;
            background: var(--bg-light);
            border: 1px solid #eee;
            border-radius: 8px;
            padding: 4px;
            display: flex;
            align-items: center;
            justify-content: center;
        }

            .product-thumb img {
                max-width: 100%;
                max-height: 100%;
                object-fit: contain;
            }

        .product-title-cell {
            font-weight: 600;
            color: var(--text-dark);
            line-height: 1.4;
        }

        .qty-pill {
            display: inline-block;
            background: #f4f6f8;
            color: var(--text-dark);
            font-weight: 600;
            font-size: 13px;
            padding: 4px 12px;
            border-radius: 6px;
        }

        .text-center {
            text-align: center;
        }

        .text-right {
            text-align: right;
        }

        /* TỔNG THANH TOÁN */
        .total-summary-bar {
            background: #fdf4f4;
            border: 1px solid #f6d6d6;
            border-radius: 12px;
            padding: 16px 24px;
            display: flex;
            justify-content: space-between;
            align-items: center;
            margin-bottom: 28px;
        }

        .total-summary-label {
            font-size: 16px;
            font-weight: 700;
            color: var(--text-dark);
        }

        .total-summary-amount {
            font-size: 24px;
            font-weight: 700;
            color: #d93025;
        }

        /* NÚT HÀNH ĐỘNG */
        .success-actions {
            display: flex;
            justify-content: center;
            gap: 16px;
            flex-wrap: wrap;
        }

        .btn-primary-action {
            display: inline-flex;
            align-items: center;
            justify-content: center;
            gap: 8px;
            background-color: var(--secondary-color);
            color: #fff;
            padding: 13px 28px;
            border-radius: 10px;
            font-size: 15px;
            font-weight: 600;
            transition: all 0.25s ease;
            box-shadow: 0 4px 12px rgba(26, 143, 109, 0.25);
        }

            .btn-primary-action:hover {
                background-color: var(--primary-color);
                transform: translateY(-1px);
            }

        .btn-secondary-action {
            display: inline-flex;
            align-items: center;
            justify-content: center;
            gap: 8px;
            background-color: #fff;
            color: var(--primary-color);
            border: 1.5px solid #cce7df;
            padding: 13px 28px;
            border-radius: 10px;
            font-size: 15px;
            font-weight: 600;
            transition: all 0.25s ease;
        }

            .btn-secondary-action:hover {
                background-color: #e6f4f0;
                border-color: var(--secondary-color);
            }

        /* FOOTER */
        .phone-footer {
            background-color: var(--primary-color);
            color: #fff;
            padding: 40px 50px;
            display: flex;
            justify-content: space-between;
            align-items: center;
            margin-top: auto;
        }

            .phone-footer h3 {
                margin: 0 0 8px 0;
                font-size: 22px;
            }

            .phone-footer p {
                margin: 0;
                color: #cce5de;
                font-size: 14px;
            }

        @@media (max-width: 768px) {
            .header-top {
                padding: 15px 20px;
            }

            .nav-links {
                display: none;
            }

            .order-success-card {
                padding: 26px 20px;
            }

            .info-grid-box {
                grid-template-columns: 1fr;
            }

            .success-actions a {
                width: 100%;
            }
        }
    </style>
</head>
<body>

    <!-- HEADER -->
    <header class="header-top">
        <a href="@Url.Action("Index", "Home")" class="logo">
            <i class="fas fa-shopping-bag"></i> PHONE & ACCES
        </a>

        <nav class="nav-links">
            <a href="@Url.Action("Index", "Home")">Trang chủ</a>
            <a href="@Url.Action("PageDienThoai", "Home")">Điện thoại</a>
            <a href="@Url.Action("PagePhuKien", "Home")">Phụ kiện</a>
            <a href="@Url.Action("PageThietBi", "Home")">Đồng hồ</a>
            <a href="#footer">Hỗ trợ</a>
        </nav>

        <div class="header-actions">
            @using (Html.BeginForm("Index", "Home", FormMethod.Get))
            {
                <div class="search-bar">
                    <i class="fas fa-search" style="color:#aaa;"></i>
                    <input type="text" name="searchTerm" placeholder="Tìm sản phẩm..." />
                    <button type="submit" style="display:none;"></button>
                </div>
            }

            @if (Session["Username"] != null)
            {
                <div class="user-dropdown">
                    <div class="user-trigger" onclick="this.parentElement.classList.toggle('open')">
                        <i class="fas fa-user-circle" style="font-size: 18px;"></i>
                        <span>@Session["Username"]</span>
                        <i class="fas fa-chevron-down" style="font-size: 11px;"></i>
                    </div>
                    <div class="user-dropdown-menu">
                        <a href="@Url.Action("ProfileInfo", "Account")">Thông tin tài khoản</a>
                        <a href="@Url.Action("MyOrder", "Order")">Đơn hàng của tôi</a>
                        <a href="@Url.Action("Logout", "Account")" style="color: #d9534f;">Đăng xuất</a>
                    </div>
                </div>
            }
            else
            {
                <a href="@Url.Action("Login", "Account")" class="icon-btn" title="Đăng nhập"><i class="fas fa-user"></i></a>
            }

            <a href="@Url.Action("Index", "Cart")" class="icon-btn">
                <i class="fas fa-shopping-cart"></i>
                <span class="cart-badge">@cartCount</span>
            </a>
        </div>
    </header>

    <!-- BREADCRUMB -->
    <div class="breadcrumb-bar">
        <a href="@Url.Action("Index", "Home")"><i class="fas fa-home"></i> Trang chủ</a>
        <span>/</span>
        <a href="@Url.Action("MyOrder", "Order")">Đơn hàng của tôi</a>
        <span>/</span>
        <span class="current">Chi tiết đơn hàng #@Model.OrderID</span>
    </div>

    <!-- NỘI DUNG ĐẶT HÀNG THÀNH CÔNG -->
    <main class="success-wrapper">
        <div class="order-success-card">
            <div class="success-hero">
                <div class="success-icon-circle">
                    <i class="fas fa-check"></i>
                </div>
                <h1>ĐẶT HÀNG THÀNH CÔNG!</h1>
                <p>Cảm ơn bạn đã tin tưởng và mua sắm tại <strong>PHONE & ACCES</strong>.</p>
            </div>

            <!-- THÔNG TIN ĐƠN HÀNG -->
            <div class="info-grid-box">
                <div class="info-item">
                    <span class="info-label">Mã đơn hàng</span>
                    <span class="info-value order-code">#@Model.OrderID</span>
                </div>

                <div class="info-item">
                    <span class="info-label">Ngày đặt hàng</span>
                    <span class="info-value">@Model.OrderDate.ToString("dd/MM/yyyy HH:mm")</span>
                </div>

                <div class="info-item">
                    <span class="info-label">Phương thức thanh toán</span>
                    <span class="info-value">@(string.IsNullOrEmpty(Model.PaymentMethod) ? "Tiền mặt" : Model.PaymentMethod)</span>
                </div>

                <div class="info-item">
                    <span class="info-label">Trạng thái thanh toán</span>
                    <span class="info-value" style="color: var(--secondary-color);">
                        @(string.IsNullOrEmpty(Model.PaymentStatus) ? "Đang xử lý" : Model.PaymentStatus)
                    </span>
                </div>

                <div class="info-item full-width">
                    <span class="info-label">Địa chỉ nhận hàng</span>
                    <span class="info-value">@Model.ShippingAddress</span>
                </div>
            </div>

            <!-- CHI TIẾT SẢN PHẨM TRONG ĐƠN HÀNG -->
            <h3 class="section-subtitle">
                <i class="fas fa-box"></i> Chi tiết sản phẩm
            </h3>

            <div class="table-wrapper">
                <table class="detail-table">
                    <thead>
                        <tr>
                            <th style="width: 72px;">Ảnh</th>
                            <th>Tên sản phẩm</th>
                            <th class="text-center" style="width: 100px;">Số lượng</th>
                            <th class="text-right" style="width: 140px;">Đơn giá</th>
                            <th class="text-right" style="width: 150px;">Thành tiền</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (Model.OrderDetails != null && Model.OrderDetails.Any())
                        {
                            foreach (var item in Model.OrderDetails)
                            {
                                <tr>
                                    <td>
                                        <div class="product-thumb">
                                            <img src="@(item.Product != null ? item.Product.ProductImage : "/Images/default.png")" alt="Product" />
                                        </div>
                                    </td>
                                    <td class="product-title-cell">
                                        @(item.Product != null ? item.Product.ProductName : "Sản phẩm mã #" + item.ProductID)
                                    </td>
                                    <td class="text-center">
                                        <span class="qty-pill">x@(item.Quantity)</span>
                                    </td>
                                    <td class="text-right" style="color: var(--text-gray);">
                                        @item.UnitPrice.ToString("#,##0").Replace(",", ".") đ
                                    </td>
                                    <td class="text-right" style="font-weight: 700; color: var(--text-dark);">
                                        @(Convert.ToDecimal(item.TotalPrice).ToString("#,##0").Replace(",", ".")) đ
                                    </td>
                                </tr>
                            }
                        }
                        else
                        {
                            <tr>
                                <td colspan="5" class="text-center" style="color: var(--text-gray); padding: 24px;">
                                    Không có thông tin chi tiết sản phẩm.
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>

            <!-- TỔNG TIỀN THANH TOÁN -->
            <div class="total-summary-bar">
                <span class="total-summary-label">Tổng cộng thanh toán:</span>
                <span class="total-summary-amount">@Model.TotalAmount.ToString("#,##0").Replace(",", ".") đ</span>
            </div>

            <!-- NÚT ĐIỀU HƯỚNG -->
            <div class="success-actions">
                <a href="@Url.Action("MyOrder", "Order")" class="btn-primary-action">
                    <i class="fas fa-receipt"></i> Xem đơn hàng của tôi
                </a>
                <a href="@Url.Action("Index", "Home")" class="btn-secondary-action">
                    <i class="fas fa-shopping-bag"></i> Tiếp tục mua hàng
                </a>
            </div>
        </div>
    </main>

    <!-- FOOTER -->
    <footer class="phone-footer" id="footer">
        <div>
            <h3>PHONE & ACCES</h3>
            <p>Điện thoại và phụ kiện công nghệ chính hãng dành cho bạn.</p>
        </div>
        <p>© 2026 PHONE & ACCES. All rights reserved.</p>
    </footer>

    <script>
        document.addEventListener('click', function (e) {
            const dropdown = document.querySelector('.user-dropdown');
            if (dropdown && !dropdown.contains(e.target)) {
                dropdown.classList.remove('open');
            }
        });
    </script>

</body>
</html>