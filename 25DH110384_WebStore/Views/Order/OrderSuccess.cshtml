@model _25DH110384_WebStore.Models.Order

@{
    Layout = null;
    var cart = Session["Cart"] as _25DH110384_WebStore.Models.ViewModel.Cart;
    int cartCount = (cart != null && cart.Items != null) ? cart.Items.Count() : 0;
}

<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Đặt hàng thành công - PHONE & ACCES</title>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800&display=swap" rel="stylesheet">

    <style>
        :root {
            --primary-color: #0b4d3c;
            --secondary-color: #1a8f6d;
            --dark-surface: #0d1714;
            --dark-card: #152420;
            --bg-light: #f4f6f8;
            --text-dark: #181c1b;
            --text-gray: #646e6b;
            --border-color: #e6eae8;
            --container-max: 1280px;
        }

        *, *::before, *::after {
            box-sizing: border-box;
        }

        html {
            scroll-behavior: smooth;
        }

        body {
            font-family: 'Inter', sans-serif;
            margin: 0;
            padding: 0;
            background-color: #f6f8f7;
            color: var(--text-dark);
            display: flex;
            flex-direction: column;
            min-height: 100vh;
            overflow-x: clip;
        }

        a {
            text-decoration: none;
            color: inherit;
        }

        .page-container {
            max-width: var(--container-max);
            margin: 0 auto;
            padding: 0 32px;
        }

        /* ================= 1. TOP ANNOUNCEMENT BAR ================= */
        .top-promo-bar {
            background-color: #0b1411;
            color: #d7e2de;
            font-size: 12px;
            padding: 8px 0;
            border-bottom: 1px solid rgba(255,255,255,0.08);
        }

            .top-promo-bar .page-container {
                display: flex;
                justify-content: space-between;
                align-items: center;
            }

        .promo-highlights {
            display: flex;
            align-items: center;
            gap: 14px;
        }

            .promo-highlights span.sep {
                color: #4b5c57;
            }

        .promo-meta {
            display: flex;
            align-items: center;
            gap: 16px;
            font-weight: 500;
        }

        /* ================= 2. MAIN HEADER ================= */
        .header-top {
            background-color: #ffffff;
            border-bottom: 1px solid #ecefef;
            position: sticky;
            top: 0;
            z-index: 1000;
        }

            .header-top .page-container {
                height: 70px;
                display: flex;
                align-items: center;
                justify-content: space-between;
                gap: 24px;
            }

        .logo {
            font-size: 22px;
            font-weight: 800;
            color: var(--primary-color);
            display: flex;
            align-items: center;
            gap: 9px;
            letter-spacing: -0.4px;
            white-space: nowrap;
        }

            .logo i {
                color: var(--secondary-color);
            }

        .nav-links {
            display: flex;
            align-items: center;
            gap: 28px;
            font-size: 14.5px;
            font-weight: 500;
            white-space: nowrap;
        }

            .nav-links a {
                position: relative;
                padding: 6px 0;
                color: #2d3533;
                transition: color 0.2s ease;
            }

                .nav-links a::after {
                    content: "";
                    position: absolute;
                    left: 0;
                    bottom: 0;
                    width: 0;
                    height: 2px;
                    background-color: var(--secondary-color);
                    border-radius: 2px;
                    transition: width 0.25s ease;
                }

                .nav-links a:hover,
                .nav-links a.active {
                    color: var(--secondary-color);
                    font-weight: 600;
                }

                    .nav-links a:hover::after,
                    .nav-links a.active::after {
                        width: 100%;
                    }

        .header-actions {
            display: flex;
            align-items: center;
            gap: 16px;
        }

            .header-actions form {
                margin: 0;
            }

        .search-bar {
            background: #f3f5f6;
            border: 1px solid transparent;
            border-radius: 999px;
            padding: 8px 16px;
            display: flex;
            align-items: center;
            width: 260px;
            transition: all 0.2s ease;
        }

            .search-bar:focus-within {
                background: #fff;
                border-color: var(--secondary-color);
                box-shadow: 0 0 0 3px rgba(26, 143, 109, 0.12);
            }

            .search-bar input {
                border: none;
                background: transparent;
                outline: none;
                padding-left: 10px;
                width: 100%;
                font-family: inherit;
                font-size: 13.5px;
                color: var(--text-dark);
            }

        .icon-btn {
            font-size: 19px;
            color: var(--text-dark);
            cursor: pointer;
            position: relative;
            width: 38px;
            height: 38px;
            border-radius: 50%;
            display: inline-flex;
            align-items: center;
            justify-content: center;
            transition: background 0.2s;
            flex-shrink: 0;
        }

            .icon-btn:hover {
                background: #f2f5f4;
                color: var(--primary-color);
            }

        .cart-badge {
            position: absolute;
            top: 0;
            right: -2px;
            background: var(--secondary-color);
            color: #fff;
            font-size: 10.5px;
            min-width: 18px;
            height: 18px;
            padding: 0 5px;
            border-radius: 999px;
            font-weight: 700;
            display: inline-flex;
            align-items: center;
            justify-content: center;
        }

        /* USER DROPDOWN */
        .user-dropdown {
            position: relative;
            display: inline-block;
        }

        .user-trigger {
            display: flex;
            align-items: center;
            gap: 8px;
            background-color: #e8f5f1;
            color: var(--primary-color);
            padding: 7px 14px;
            border-radius: 999px;
            font-size: 13.5px;
            font-weight: 600;
            cursor: pointer;
            transition: 0.25s;
            user-select: none;
            white-space: nowrap;
        }

            .user-trigger:hover {
                background-color: var(--secondary-color);
                color: #fff;
            }

        .user-dropdown-menu {
            opacity: 0;
            visibility: hidden;
            transform: translateY(-6px);
            position: absolute;
            right: 0;
            top: calc(100% + 8px);
            background: #fff;
            box-shadow: 0 10px 28px rgba(0,0,0,0.12);
            border: 1px solid #eaeaea;
            border-radius: 12px;
            min-width: 205px;
            z-index: 1000;
            transition: opacity 0.2s ease, transform 0.2s ease, visibility 0s linear 0.35s;
        }

            .user-dropdown-menu::before {
                content: "";
                position: absolute;
                top: -15px;
                left: 0;
                width: 100%;
                height: 18px;
                background: transparent;
            }

        .user-dropdown:hover .user-dropdown-menu,
        .user-dropdown.open .user-dropdown-menu {
            opacity: 1;
            visibility: visible;
            transform: translateY(0);
            transition: opacity 0.2s ease, transform 0.2s ease, visibility 0s linear 0s;
        }

        .user-dropdown-menu a {
            padding: 11px 18px;
            display: block;
            border-bottom: 1px solid #f1f3f2;
            font-size: 13.5px;
            font-weight: 500;
        }

            .user-dropdown-menu a:first-child {
                border-radius: 12px 12px 0 0;
            }

            .user-dropdown-menu a:last-child {
                border-bottom: none;
                border-radius: 0 0 12px 12px;
            }

            .user-dropdown-menu a:hover {
                background: #f5faf8;
                color: var(--secondary-color);
            }

        /* ================= 3. NỘI DUNG ĐẶT HÀNG THÀNH CÔNG ================= */
        .success-page {
            flex: 1;
            padding: 34px 0 64px 0;
        }

        .success-inner {
            max-width: 940px;
            margin: 0 auto;
        }

        .breadcrumb-bar {
            display: flex;
            align-items: center;
            gap: 8px;
            font-size: 13px;
            color: var(--text-gray);
            margin-bottom: 20px;
        }

            .breadcrumb-bar a:hover {
                color: var(--secondary-color);
            }

            .breadcrumb-bar span.current {
                color: var(--primary-color);
                font-weight: 600;
            }

        .order-success-card {
            background: #ffffff;
            border-radius: 16px;
            border: 1px solid #e7ecea;
            padding: 40px 44px;
            box-shadow: 0 8px 24px rgba(11, 22, 19, 0.04);
        }

        /* PHẦN TIÊU ĐỀ THÀNH CÔNG */
        .success-hero {
            text-align: center;
            padding-bottom: 28px;
            margin-bottom: 28px;
            border-bottom: 1px solid #eef1f0;
        }

        .success-icon-circle {
            width: 80px;
            height: 80px;
            border-radius: 50%;
            background: linear-gradient(135deg, #e8f5f1, #bce8da);
            color: var(--primary-color);
            display: inline-flex;
            align-items: center;
            justify-content: center;
            font-size: 34px;
            margin-bottom: 16px;
            box-shadow: 0 8px 20px rgba(26, 143, 109, 0.18);
        }

        .success-eyebrow {
            display: block;
            font-size: 11.5px;
            font-weight: 700;
            letter-spacing: 1.4px;
            text-transform: uppercase;
            color: var(--secondary-color);
            margin-bottom: 6px;
        }

        .success-hero h1 {
            margin: 0 0 8px 0;
            font-size: 27px;
            font-weight: 800;
            color: var(--text-dark);
            letter-spacing: -0.4px;
        }

        .success-hero p {
            margin: 0;
            color: var(--text-gray);
            font-size: 14.5px;
        }

        /* KHỐI THÔNG TIN ĐƠN HÀNG */
        .info-grid-box {
            background: #f4faf8;
            border: 1px solid #cce5de;
            border-radius: 14px;
            padding: 22px 26px;
            margin-bottom: 30px;
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 16px 28px;
        }

        .info-item {
            display: flex;
            flex-direction: column;
            gap: 4px;
        }

            .info-item.full-width {
                grid-column: 1 / -1;
                padding-top: 12px;
                border-top: 1px dashed #cce5de;
            }

        .info-label {
            font-size: 11.5px;
            font-weight: 700;
            text-transform: uppercase;
            color: var(--text-gray);
            letter-spacing: 0.5px;
        }

        .info-value {
            font-size: 14.5px;
            font-weight: 600;
            color: var(--text-dark);
        }

            .info-value.order-code {
                color: var(--primary-color);
                font-weight: 800;
                font-size: 16px;
            }

        .status-badge-inline {
            display: inline-flex;
            align-items: center;
            gap: 6px;
            background: #ffffff;
            border: 1px solid #bfe3d7;
            color: var(--secondary-color);
            font-size: 12.5px;
            font-weight: 700;
            padding: 3px 12px;
            border-radius: 999px;
            width: fit-content;
        }

        /* BẢNG CHI TIẾT SẢN PHẨM */
        .section-subtitle {
            font-size: 17.5px;
            font-weight: 700;
            color: var(--text-dark);
            margin: 0 0 14px 0;
            display: flex;
            align-items: center;
            gap: 9px;
        }

            .section-subtitle i {
                color: var(--secondary-color);
                font-size: 16px;
            }

        .table-wrapper {
            border: 1px solid #e7ecea;
            border-radius: 14px;
            overflow-x: auto;
            margin-bottom: 24px;
        }

        .detail-table {
            width: 100%;
            border-collapse: collapse;
            min-width: 580px;
        }

            .detail-table thead th {
                background-color: #f6f8f7;
                color: var(--text-gray);
                font-size: 12px;
                font-weight: 700;
                text-transform: uppercase;
                letter-spacing: 0.4px;
                padding: 14px 18px;
                border-bottom: 1px solid #e7ecea;
                text-align: left;
            }

                .detail-table thead th.text-center {
                    text-align: center;
                }

                .detail-table thead th.text-right {
                    text-align: right;
                }

            .detail-table tbody td {
                padding: 15px 18px;
                border-bottom: 1px dashed #e6eae8;
                vertical-align: middle;
                font-size: 14px;
            }

            .detail-table tbody tr:last-child td {
                border-bottom: none;
            }

        .product-thumb {
            width: 64px;
            height: 64px;
            background: #f6f8f7;
            border: 1px solid #e9eded;
            border-radius: 10px;
            padding: 6px;
            display: flex;
            align-items: center;
            justify-content: center;
        }

            .product-thumb img {
                max-width: 100%;
                max-height: 100%;
                object-fit: contain;
            }

        .product-title-cell {
            font-weight: 600;
            color: var(--text-dark);
            line-height: 1.4;
        }

        .qty-pill {
            display: inline-block;
            background: #f3f5f6;
            color: var(--text-dark);
            font-weight: 700;
            font-size: 12.5px;
            padding: 4px 12px;
            border-radius: 999px;
        }

        .text-center {
            text-align: center;
        }

        .text-right {
            text-align: right;
        }

        /* TỔNG THANH TOÁN */
        .total-summary-bar {
            background: #eef8f4;
            border: 1px solid #bfe3d7;
            border-radius: 14px;
            padding: 18px 24px;
            display: flex;
            justify-content: space-between;
            align-items: center;
            margin-bottom: 30px;
            flex-wrap: wrap;
            gap: 10px;
        }

        .total-summary-label {
            font-size: 15.5px;
            font-weight: 700;
            color: var(--primary-color);
        }

        .total-summary-amount {
            font-size: 24px;
            font-weight: 800;
            color: #d93025;
        }

        /* NÚT HÀNH ĐỘNG */
        .success-actions {
            display: flex;
            justify-content: center;
            gap: 14px;
            flex-wrap: wrap;
        }

        .btn-primary-action {
            display: inline-flex;
            align-items: center;
            justify-content: center;
            gap: 8px;
            background-color: #141f1c;
            color: #ffffff;
            padding: 13px 28px;
            border-radius: 999px;
            font-size: 14px;
            font-weight: 600;
            transition: all 0.25s ease;
        }

            .btn-primary-action:hover {
                background-color: var(--secondary-color);
                transform: translateY(-1px);
                box-shadow: 0 6px 18px rgba(26, 143, 109, 0.25);
            }

        .btn-secondary-action {
            display: inline-flex;
            align-items: center;
            justify-content: center;
            gap: 8px;
            background-color: #ffffff;
            color: var(--text-dark);
            border: 1px solid #dce3e1;
            padding: 13px 28px;
            border-radius: 999px;
            font-size: 14px;
            font-weight: 600;
            transition: all 0.2s ease;
        }

            .btn-secondary-action:hover {
                background-color: #f5faf8;
                border-color: var(--secondary-color);
                color: var(--primary-color);
            }

        /* ================= 4. SERVICE STRIP ================= */
        .service-strip {
            border-top: 1px solid #ecefef;
            background: #fafcfb;
            padding: 32px 0;
            margin-top: auto;
        }

        .service-grid {
            max-width: var(--container-max);
            margin: 0 auto;
            padding: 0 32px;
            display: grid;
            grid-template-columns: repeat(4, 1fr);
            gap: 24px;
        }

        .service-box {
            display: flex;
            align-items: center;
            gap: 14px;
        }

            .service-box .srv-icon {
                width: 44px;
                height: 44px;
                border-radius: 12px;
                background: #e8f5f1;
                color: var(--secondary-color);
                display: inline-flex;
                align-items: center;
                justify-content: center;
                font-size: 18px;
                flex-shrink: 0;
            }

            .service-box h4 {
                margin: 0 0 3px 0;
                font-size: 14.5px;
                font-weight: 700;
                color: var(--text-dark);
            }

            .service-box p {
                margin: 0;
                font-size: 12.5px;
                color: var(--text-gray);
            }

        /* ================= 5. MULTI-COLUMN DARK FOOTER ================= */
        .voltix-footer {
            background-color: #0b1411;
            color: #b7c4c0;
            padding-top: 52px;
        }

        .footer-grid {
            max-width: var(--container-max);
            margin: 0 auto;
            padding: 0 32px 40px 32px;
            display: grid;
            grid-template-columns: 1.4fr 1fr 1fr 1fr 1.2fr;
            gap: 32px;
        }

        .footer-brand .logo {
            color: #ffffff;
            margin-bottom: 14px;
        }

        .footer-brand p {
            font-size: 13px;
            line-height: 1.6;
            color: #93a39e;
            margin: 0 0 20px 0;
        }

        .social-links {
            display: flex;
            gap: 10px;
        }

            .social-links a {
                width: 34px;
                height: 34px;
                border-radius: 50%;
                background: rgba(255,255,255,0.08);
                color: #ffffff;
                display: inline-flex;
                align-items: center;
                justify-content: center;
                font-size: 13.5px;
                transition: background 0.2s;
            }

                .social-links a:hover {
                    background: var(--secondary-color);
                }

        .footer-col h4 {
            color: #ffffff;
            font-size: 14px;
            font-weight: 700;
            margin: 0 0 16px 0;
        }

        .footer-col ul {
            list-style: none;
            padding: 0;
            margin: 0;
            display: flex;
            flex-direction: column;
            gap: 10px;
            font-size: 13px;
        }

            .footer-col ul a:hover {
                color: #5eead4;
            }

        .app-badges {
            display: flex;
            flex-direction: column;
            gap: 10px;
            margin-top: 14px;
        }

        .app-badge-btn {
            display: inline-flex;
            align-items: center;
            gap: 10px;
            background: rgba(255,255,255,0.07);
            border: 1px solid rgba(255,255,255,0.14);
            color: #ffffff;
            padding: 8px 14px;
            border-radius: 10px;
            font-size: 12px;
            transition: background 0.2s;
        }

            .app-badge-btn:hover {
                background: rgba(255,255,255,0.14);
            }

            .app-badge-btn i {
                font-size: 18px;
            }

        .footer-bottom {
            border-top: 1px solid rgba(255,255,255,0.08);
            padding: 18px 0;
            font-size: 12.5px;
            color: #7f908b;
        }

            .footer-bottom .page-container {
                display: flex;
                justify-content: space-between;
                align-items: center;
            }

        .footer-legal {
            display: flex;
            gap: 18px;
        }

            .footer-legal a:hover {
                color: #ffffff;
            }

        /* ================= RESPONSIVE ================= */
        @@media (max-width: 1180px) {
            .nav-links {
                gap: 20px;
            }

            .search-bar {
                width: 210px;
            }
        }

        @@media (max-width: 1024px) {
            .footer-grid {
                grid-template-columns: repeat(2, 1fr);
            }
        }

        @@media (max-width: 820px) {
            .top-promo-bar,
            .nav-links,
            .search-bar {
                display: none;
            }

            .page-container {
                padding: 0 20px;
            }

            .success-page {
                padding: 24px 0 48px 0;
            }

            .order-success-card {
                padding: 26px 20px;
            }

            .info-grid-box {
                grid-template-columns: 1fr;
            }

            .success-actions a {
                width: 100%;
            }

            .service-grid {
                grid-template-columns: 1fr;
            }
        }
    </style>
</head>
<body>

    <!-- 1. TOP ANNOUNCEMENT BAR -->
    <div class="top-promo-bar">
        <div class="page-container">
            <div class="promo-highlights">
                <span>Miễn phí vận chuyển cho đơn từ 500.000đ</span>
                <span class="sep">|</span>
                <span>Đổi trả dễ dàng 30 ngày</span>
                <span class="sep">|</span>
                <span>Công nghệ chính hãng 100%</span>
            </div>
            <div class="promo-meta">
                <span>VND</span>
                <span style="color:#4b5c57;">|</span>
                <span>Tiếng Việt</span>
            </div>
        </div>
    </div>

    <!-- 2. MAIN HEADER -->
    <header class="header-top">
        <div class="page-container">
            <a href="@Url.Action("Index", "Home")" class="logo">
                <i class="fas fa-shopping-bag"></i> PHONE & ACCES
            </a>

            <nav class="nav-links">
                <a href="@Url.Action("Index", "Home")">Trang chủ</a>
                <a href="@Url.Action("PageDienThoai", "Home")">Điện thoại</a>
                <a href="@Url.Action("PagePhuKien", "Home")">Phụ kiện</a>
                <a href="@Url.Action("PageThietBi", "Home")">Đồng hồ</a>
                <a href="#footer">Hỗ trợ</a>
            </nav>

            <div class="header-actions">
                @using (Html.BeginForm("Index", "Home", FormMethod.Get))
                {
                    <div class="search-bar">
                        <i class="fas fa-search" style="color:#8b9693; font-size:13px;"></i>
                        <input type="text" name="searchTerm" placeholder="Tìm sản phẩm..." />
                        <button type="submit" style="display:none;"></button>
                    </div>
                }

                @if (Session["Username"] != null)
                {
                    <div class="user-dropdown">
                        <div class="user-trigger" onclick="this.parentElement.classList.toggle('open')">
                            <i class="fas fa-user-circle" style="font-size: 17px;"></i>
                            <span>@Session["Username"]</span>
                            <i class="fas fa-chevron-down" style="font-size: 10px;"></i>
                        </div>
                        <div class="user-dropdown-menu">
                            <a href="@Url.Action("ProfileInfo", "Account")">Thông tin tài khoản</a>
                            <a href="@Url.Action("MyOrder", "Order")">Đơn hàng của tôi</a>
                            <a href="@Url.Action("Logout", "Account")" style="color: #d9534f;">Đăng xuất</a>
                        </div>
                    </div>
                }
                else
                {
                    <a href="@Url.Action("Login", "Account")" class="icon-btn" title="Đăng nhập">
                        <i class="far fa-user"></i>
                    </a>
                }

                <a href="@Url.Action("Index", "Cart")" class="icon-btn" title="Giỏ hàng">
                    <i class="fas fa-shopping-cart"></i>
                    <span class="cart-badge">@cartCount</span>
                </a>
            </div>
        </div>
    </header>

    <!-- 3. NỘI DUNG ĐẶT HÀNG THÀNH CÔNG -->
    <main class="success-page">
        <div class="page-container">
            <div class="success-inner">
                <div class="breadcrumb-bar">
                    <a href="@Url.Action("Index", "Home")"><i class="fas fa-home"></i> Trang chủ</a>
                    <span>/</span>
                    <a href="@Url.Action("MyOrder", "Order")">Đơn hàng của tôi</a>
                    <span>/</span>
                    <span class="current">Chi tiết đơn hàng #@Model.OrderID</span>
                </div>

                <div class="order-success-card">
                    <div class="success-hero">
                        <div class="success-icon-circle">
                            <i class="fas fa-check"></i>
                        </div>
                        <span class="success-eyebrow">Xác nhận giao dịch</span>
                        <h1>ĐẶT HÀNG THÀNH CÔNG!</h1>
                        <p>Cảm ơn bạn đã tin tưởng và mua sắm tại <strong>PHONE & ACCES</strong>.</p>
                    </div>

                    <!-- THÔNG TIN ĐƠN HÀNG -->
                    <div class="info-grid-box">
                        <div class="info-item">
                            <span class="info-label">Mã đơn hàng</span>
                            <span class="info-value order-code">#@Model.OrderID</span>
                        </div>

                        <div class="info-item">
                            <span class="info-label">Ngày đặt hàng</span>
                            <span class="info-value">@Model.OrderDate.ToString("dd/MM/yyyy HH:mm")</span>
                        </div>

                        <div class="info-item">
                            <span class="info-label">Phương thức thanh toán</span>
                            <span class="info-value">@(string.IsNullOrEmpty(Model.PaymentMethod) ? "Tiền mặt" : Model.PaymentMethod)</span>
                        </div>

                        <div class="info-item">
                            <span class="info-label">Trạng thái thanh toán</span>
                            <span class="status-badge-inline">
                                <i class="fas fa-circle" style="font-size: 7px;"></i>
                                @(string.IsNullOrEmpty(Model.PaymentStatus) ? "Đang xử lý" : Model.PaymentStatus)
                            </span>
                        </div>

                        <div class="info-item full-width">
                            <span class="info-label">Địa chỉ nhận hàng</span>
                            <span class="info-value">@Model.ShippingAddress</span>
                        </div>
                    </div>

                    <!-- CHI TIẾT SẢN PHẨM TRONG ĐƠN HÀNG -->
                    <h3 class="section-subtitle">
                        <i class="fas fa-box"></i> Chi tiết sản phẩm
                    </h3>

                    <div class="table-wrapper">
                        <table class="detail-table">
                            <thead>
                                <tr>
                                    <th style="width: 76px;">Ảnh</th>
                                    <th>Tên sản phẩm</th>
                                    <th class="text-center" style="width: 105px;">Số lượng</th>
                                    <th class="text-right" style="width: 145px;">Đơn giá</th>
                                    <th class="text-right" style="width: 155px;">Thành tiền</th>
                                </tr>
                            </thead>
                            <tbody>
                                @if (Model.OrderDetails != null && Model.OrderDetails.Any())
                                {
                                    foreach (var item in Model.OrderDetails)
                                    {
                                        <tr>
                                            <td>
                                                <div class="product-thumb">
                                                    <img src="@(item.Product != null ? item.Product.ProductImage : "/Images/default.png")" alt="Product" />
                                                </div>
                                            </td>
                                            <td class="product-title-cell">
                                                @(item.Product != null ? item.Product.ProductName : "Sản phẩm mã #" + item.ProductID)
                                            </td>
                                            <td class="text-center">
                                                <span class="qty-pill">x@(item.Quantity)</span>
                                            </td>
                                            <td class="text-right" style="color: var(--text-gray);">
                                                @item.UnitPrice.ToString("#,##0").Replace(",", ".") đ
                                            </td>
                                            <td class="text-right" style="font-weight: 700; color: var(--primary-color);">
                                                @(Convert.ToDecimal(item.TotalPrice).ToString("#,##0").Replace(",", ".")) đ
                                            </td>
                                        </tr>
                                    }
                                }
                                else
                                {
                                    <tr>
                                        <td colspan="5" class="text-center" style="color: var(--text-gray); padding: 24px;">
                                            Không có thông tin chi tiết sản phẩm.
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>

                    <!-- TỔNG TIỀN THANH TOÁN -->
                    <div class="total-summary-bar">
                        <span class="total-summary-label">Tổng cộng thanh toán:</span>
                        <span class="total-summary-amount">@Model.TotalAmount.ToString("#,##0").Replace(",", ".") đ</span>
                    </div>

                    <!-- NÚT ĐIỀU HƯỚNG -->
                    <div class="success-actions">
                        <a href="@Url.Action("MyOrder", "Order")" class="btn-primary-action">
                            <i class="fas fa-receipt"></i> Xem đơn hàng của tôi
                        </a>
                        <a href="@Url.Action("Index", "Home")" class="btn-secondary-action">
                            <i class="fas fa-shopping-bag"></i> Tiếp tục mua hàng
                        </a>
                    </div>
                </div>
            </div>
        </div>
    </main>

    <!-- 4. SERVICE STRIP -->
    <div class="service-strip">
        <div class="service-grid">
            <div class="service-box">
                <span class="srv-icon"><i class="fas fa-truck"></i></span>
                <div>
                    <h4>Miễn phí vận chuyển</h4>
                    <p>Cho đơn hàng từ 500.000đ</p>
                </div>
            </div>

            <div class="service-box">
                <span class="srv-icon"><i class="fas fa-undo-alt"></i></span>
                <div>
                    <h4>Đổi trả 30 ngày</h4>
                    <p>Bảo hành 1 đổi 1 dễ dàng</p>
                </div>
            </div>

            <div class="service-box">
                <span class="srv-icon"><i class="fas fa-headset"></i></span>
                <div>
                    <h4>Hỗ trợ 24/7</h4>
                    <p>Tư vấn kỹ thuật tận tâm</p>
                </div>
            </div>

            <div class="service-box">
                <span class="srv-icon"><i class="fas fa-shield-alt"></i></span>
                <div>
                    <h4>Thanh toán bảo mật</h4>
                    <p>Hỗ trợ PayPal & COD an toàn</p>
                </div>
            </div>
        </div>
    </div>

    <!-- 5. MULTI-COLUMN DARK FOOTER -->
    <footer class="voltix-footer" id="footer">
        <div class="footer-grid">
            <div class="footer-brand">
                <a href="@Url.Action("Index", "Home")" class="logo">
                    <i class="fas fa-shopping-bag"></i> PHONE & ACCES
                </a>
                <p>Hệ thống bán lẻ điện thoại thông minh, đồng hồ và phụ kiện công nghệ chính hãng hàng đầu dành cho bạn.</p>
                <div class="social-links">
                    <a href="#"><i class="fab fa-facebook-f"></i></a>
                    <a href="#"><i class="fab fa-instagram"></i></a>
                    <a href="#"><i class="fab fa-youtube"></i></a>
                    <a href="#"><i class="fab fa-tiktok"></i></a>
                </div>
            </div>

            <div class="footer-col">
                <h4>Danh mục</h4>
                <ul>
                    <li><a href="@Url.Action("PageDienThoai", "Home")">Điện thoại</a></li>
                    <li><a href="@Url.Action("PagePhuKien", "Home")">Phụ kiện</a></li>
                    <li><a href="@Url.Action("PageThietBi", "Home")">Đồng hồ thông minh</a></li>
                    <li><a href="@Url.Action("Index", "Home")#featured">Sản phẩm nổi bật</a></li>
                </ul>
            </div>

            <div class="footer-col">
                <h4>Về chúng tôi</h4>
                <ul>
                    <li><a href="#footer">Giới thiệu cửa hàng</a></li>
                    <li><a href="#footer">Chính sách bảo hành</a></li>
                    <li><a href="#footer">Tin tức công nghệ</a></li>
                    <li><a href="#footer">Hệ thống chi nhánh</a></li>
                </ul>
            </div>

            <div class="footer-col">
                <h4>Hỗ trợ khách hàng</h4>
                <ul>
                    <li><a href="@Url.Action("MyOrder", "Order")">Tra cứu đơn hàng</a></li>
                    <li><a href="@Url.Action("ProfileInfo", "Account")">Tài khoản của tôi</a></li>
                    <li><a href="#footer">Hướng dẫn thanh toán PayPal</a></li>
                    <li><a href="#footer">Chính sách đổi trả</a></li>
                </ul>
            </div>

            <div class="footer-col">
                <h4>Tải ứng dụng</h4>
                <p style="font-size:12.5px; color:#93a39e; margin:0;">Trải nghiệm mua sắm tiện lợi hơn trên điện thoại.</p>
                <div class="app-badges">
                    <a href="#footer" class="app-badge-btn">
                        <i class="fab fa-apple"></i>
                        <span>Tải về trên <strong>App Store</strong></span>
                    </a>
                    <a href="#footer" class="app-badge-btn">
                        <i class="fab fa-google-play"></i>
                        <span>Tải về trên <strong>Google Play</strong></span>
                    </a>
                </div>
            </div>
        </div>

        <div class="footer-bottom">
            <div class="page-container">
                <span>© 2026 PHONE & ACCES. All rights reserved.</span>
                <div class="footer-legal">
                    <a href="#footer">Chính sách bảo mật</a>
                    <a href="#footer">Điều khoản dịch vụ</a>
                    <a href="#footer">Sơ đồ trang</a>
                </div>
            </div>
        </div>
    </footer>

    <script>
        document.addEventListener('click', function (e) {
            const dropdown = document.querySelector('.user-dropdown');
            if (dropdown && !dropdown.contains(e.target)) {
                dropdown.classList.remove('open');
            }
        });
    </script>

</body>
</html>