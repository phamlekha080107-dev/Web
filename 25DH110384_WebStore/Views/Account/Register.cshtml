@model _25DH110384_WebStore.Models.ViewModel.RegisterVM

@{
    Layout = null;
    var cart = Session["Cart"] as _25DH110384_WebStore.Models.ViewModel.Cart;
    int cartCount = (cart != null && cart.Items != null) ? cart.Items.Count() : 0;
}

<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Đăng ký tài khoản - PHONE & ACCES</title>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800&display=swap" rel="stylesheet">

    <style>
        :root {
            --primary-color: #0b4d3c;
            --secondary-color: #1a8f6d;
            --dark-surface: #0d1714;
            --dark-card: #152420;
            --bg-light: #f4f6f8;
            --text-dark: #181c1b;
            --text-gray: #646e6b;
            --border-color: #e6eae8;
            --container-max: 1280px;
        }

        *, *::before, *::after {
            box-sizing: border-box;
        }

        html {
            scroll-behavior: smooth;
        }

        body {
            font-family: 'Inter', sans-serif;
            margin: 0;
            padding: 0;
            background-color: #f6f8f7;
            color: var(--text-dark);
            display: flex;
            flex-direction: column;
            min-height: 100vh;
            overflow-x: clip;
        }

        a {
            text-decoration: none;
            color: inherit;
        }

        .page-container {
            max-width: var(--container-max);
            margin: 0 auto;
            padding: 0 32px;
        }

        /* ================= 1. TOP ANNOUNCEMENT BAR ================= */
        .top-promo-bar {
            background-color: #0b1411;
            color: #d7e2de;
            font-size: 12px;
            padding: 8px 0;
            border-bottom: 1px solid rgba(255,255,255,0.08);
        }

            .top-promo-bar .page-container {
                display: flex;
                justify-content: space-between;
                align-items: center;
            }

        .promo-highlights {
            display: flex;
            align-items: center;
            gap: 14px;
        }

            .promo-highlights span.sep {
                color: #4b5c57;
            }

        .promo-meta {
            display: flex;
            align-items: center;
            gap: 16px;
            font-weight: 500;
        }

        /* ================= 2. MAIN HEADER ================= */
        .header-top {
            background-color: #ffffff;
            border-bottom: 1px solid #ecefef;
            position: sticky;
            top: 0;
            z-index: 1000;
        }

            .header-top .page-container {
                height: 70px;
                display: flex;
                align-items: center;
                justify-content: space-between;
                gap: 24px;
            }

        .logo {
            font-size: 22px;
            font-weight: 800;
            color: var(--primary-color);
            display: flex;
            align-items: center;
            gap: 9px;
            letter-spacing: -0.4px;
            white-space: nowrap;
        }

            .logo i {
                color: var(--secondary-color);
            }

        .nav-links {
            display: flex;
            align-items: center;
            gap: 28px;
            font-size: 14.5px;
            font-weight: 500;
            white-space: nowrap;
        }

            .nav-links a {
                position: relative;
                padding: 6px 0;
                color: #2d3533;
                transition: color 0.2s ease;
            }

                .nav-links a::after {
                    content: "";
                    position: absolute;
                    left: 0;
                    bottom: 0;
                    width: 0;
                    height: 2px;
                    background-color: var(--secondary-color);
                    border-radius: 2px;
                    transition: width 0.25s ease;
                }

                .nav-links a:hover,
                .nav-links a.active {
                    color: var(--secondary-color);
                    font-weight: 600;
                }

                    .nav-links a:hover::after,
                    .nav-links a.active::after {
                        width: 100%;
                    }

        .header-actions {
            display: flex;
            align-items: center;
            gap: 16px;
        }

            .header-actions form {
                margin: 0;
            }

        .search-bar {
            background: #f3f5f6;
            border: 1px solid transparent;
            border-radius: 999px;
            padding: 8px 16px;
            display: flex;
            align-items: center;
            width: 260px;
            transition: all 0.2s ease;
        }

            .search-bar:focus-within {
                background: #fff;
                border-color: var(--secondary-color);
                box-shadow: 0 0 0 3px rgba(26, 143, 109, 0.12);
            }

            .search-bar input {
                border: none;
                background: transparent;
                outline: none;
                padding-left: 10px;
                width: 100%;
                font-family: inherit;
                font-size: 13.5px;
                color: var(--text-dark);
            }

        .icon-btn {
            font-size: 19px;
            color: var(--text-dark);
            cursor: pointer;
            position: relative;
            width: 38px;
            height: 38px;
            border-radius: 50%;
            display: inline-flex;
            align-items: center;
            justify-content: center;
            transition: background 0.2s;
            flex-shrink: 0;
        }

            .icon-btn:hover {
                background: #f2f5f4;
                color: var(--primary-color);
            }

        .cart-badge {
            position: absolute;
            top: 0;
            right: -2px;
            background: var(--secondary-color);
            color: #fff;
            font-size: 10.5px;
            min-width: 18px;
            height: 18px;
            padding: 0 5px;
            border-radius: 999px;
            font-weight: 700;
            display: inline-flex;
            align-items: center;
            justify-content: center;
        }

        /* USER DROPDOWN */
        .user-dropdown {
            position: relative;
            display: inline-block;
        }

        .user-trigger {
            display: flex;
            align-items: center;
            gap: 8px;
            background-color: #e8f5f1;
            color: var(--primary-color);
            padding: 7px 14px;
            border-radius: 999px;
            font-size: 13.5px;
            font-weight: 600;
            cursor: pointer;
            transition: 0.25s;
            user-select: none;
            white-space: nowrap;
        }

            .user-trigger:hover {
                background-color: var(--secondary-color);
                color: #fff;
            }

        .user-dropdown-menu {
            opacity: 0;
            visibility: hidden;
            transform: translateY(-6px);
            position: absolute;
            right: 0;
            top: calc(100% + 8px);
            background: #fff;
            box-shadow: 0 10px 28px rgba(0,0,0,0.12);
            border: 1px solid #eaeaea;
            border-radius: 12px;
            min-width: 205px;
            z-index: 1000;
            transition: opacity 0.2s ease, transform 0.2s ease, visibility 0s linear 0.35s;
        }

            .user-dropdown-menu::before {
                content: "";
                position: absolute;
                top: -15px;
                left: 0;
                width: 100%;
                height: 18px;
                background: transparent;
            }

        .user-dropdown:hover .user-dropdown-menu,
        .user-dropdown.open .user-dropdown-menu {
            opacity: 1;
            visibility: visible;
            transform: translateY(0);
            transition: opacity 0.2s ease, transform 0.2s ease, visibility 0s linear 0s;
        }

        .user-dropdown-menu a {
            padding: 11px 18px;
            display: block;
            border-bottom: 1px solid #f1f3f2;
            font-size: 13.5px;
            font-weight: 500;
        }

            .user-dropdown-menu a:first-child {
                border-radius: 12px 12px 0 0;
            }

            .user-dropdown-menu a:last-child {
                border-bottom: none;
                border-radius: 0 0 12px 12px;
            }

            .user-dropdown-menu a:hover {
                background: #f5faf8;
                color: var(--secondary-color);
            }

        /* ================= 3. NỘI DUNG ĐĂNG KÝ ================= */
        .register-page {
            flex: 1;
            padding: 34px 0 64px 0;
        }

        .register-inner {
            max-width: 780px;
            margin: 0 auto;
        }

        .breadcrumb-bar {
            display: flex;
            align-items: center;
            gap: 8px;
            font-size: 13px;
            color: var(--text-gray);
            margin-bottom: 20px;
        }

            .breadcrumb-bar a:hover {
                color: var(--secondary-color);
            }

            .breadcrumb-bar span.current {
                color: var(--primary-color);
                font-weight: 600;
            }

        .register-card {
            background: #ffffff;
            padding: 40px 46px;
            border-radius: 16px;
            border: 1px solid #e7ecea;
            box-shadow: 0 8px 24px rgba(11, 22, 19, 0.04);
        }

        .register-header {
            text-align: center;
            padding-bottom: 24px;
            margin-bottom: 28px;
            border-bottom: 1px solid #eef1f0;
        }

        .register-icon-badge {
            width: 66px;
            height: 66px;
            border-radius: 50%;
            background: linear-gradient(135deg, #e8f5f1, #bce8da);
            color: var(--primary-color);
            display: inline-flex;
            align-items: center;
            justify-content: center;
            font-size: 26px;
            margin-bottom: 14px;
            box-shadow: 0 6px 16px rgba(26, 143, 109, 0.16);
        }

        .register-eyebrow {
            display: block;
            font-size: 11.5px;
            font-weight: 700;
            letter-spacing: 1.3px;
            text-transform: uppercase;
            color: var(--secondary-color);
            margin-bottom: 5px;
        }

        .register-title {
            color: var(--text-dark);
            font-weight: 800;
            margin: 0 0 6px 0;
            font-size: 26px;
            letter-spacing: -0.4px;
        }

        .register-subtitle {
            color: var(--text-gray);
            font-size: 14px;
            margin: 0;
        }

        /* SECTION HEADING */
        .section-heading {
            font-size: 16.5px;
            font-weight: 700;
            color: var(--text-dark);
            margin: 28px 0 18px 0;
            padding-bottom: 12px;
            border-bottom: 1px solid #eef1f0;
            display: flex;
            align-items: center;
            gap: 9px;
        }

            .section-heading i {
                color: var(--secondary-color);
                font-size: 15px;
            }

            .section-heading:first-of-type {
                margin-top: 0;
            }

        /* FORM GRID & INPUTS */
        .form-row {
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 18px;
            margin-bottom: 18px;
        }

        .form-group-custom {
            margin-bottom: 18px;
        }

        .form-row .form-group-custom {
            margin-bottom: 0;
        }

        .form-group-custom label {
            display: block;
            font-weight: 600;
            font-size: 13px;
            color: var(--text-dark);
            margin-bottom: 8px;
        }

        .input-wrapper {
            position: relative;
        }

        .form-control-custom {
            width: 100%;
            height: 44px;
            padding: 10px 15px;
            border: 1px solid #dce3e1;
            border-radius: 10px;
            font-family: inherit;
            font-size: 14px;
            color: var(--text-dark);
            background-color: #ffffff;
            transition: all 0.2s ease;
        }

            .form-control-custom:focus {
                border-color: var(--secondary-color);
                outline: none;
                box-shadow: 0 0 0 3px rgba(26, 143, 109, 0.12);
            }

        .toggle-password-btn {
            position: absolute;
            right: 12px;
            top: 50%;
            transform: translateY(-50%);
            background: none;
            border: none;
            color: #8b9693;
            cursor: pointer;
            font-size: 15px;
            padding: 4px;
            transition: color 0.2s;
        }

            .toggle-password-btn:hover {
                color: var(--secondary-color);
            }

        /* VALIDATION ERRORS */
        .field-validation-valid {
            display: none;
        }

        .field-validation-error,
        .text-danger {
            display: block;
            color: #d93025;
            font-size: 12px;
            margin-top: 6px;
            font-weight: 500;
        }

        .validation-summary-errors {
            background: #fdf2f2;
            border: 1px solid #f5c6cb;
            color: #d93025;
            padding: 13px 16px;
            border-radius: 12px;
            font-size: 13.5px;
            margin-bottom: 22px;
        }

            .validation-summary-errors ul {
                margin: 0;
                padding-left: 18px;
            }

        /* GENDER RADIO PILLS */
        .gender-group {
            display: flex;
            gap: 12px;
            flex-wrap: wrap;
        }

        .gender-pill {
            display: inline-flex;
            align-items: center;
            gap: 8px;
            padding: 9px 20px;
            border: 1.5px solid #e2e8e6;
            border-radius: 999px;
            font-size: 13.5px;
            font-weight: 500;
            color: var(--text-dark);
            cursor: pointer;
            transition: all 0.2s ease;
            user-select: none;
            background: #ffffff;
        }

            .gender-pill:hover {
                border-color: var(--secondary-color);
                background: #f7fbf9;
            }

            .gender-pill input[type="radio"] {
                accent-color: var(--secondary-color);
                width: 15px;
                height: 15px;
                margin: 0;
                cursor: pointer;
            }

            .gender-pill:has(input[type="radio"]:checked) {
                border-color: var(--secondary-color);
                background: #eef8f4;
                color: var(--primary-color);
                font-weight: 600;
            }

        /* ACTION BUTTONS */
        .action-buttons {
            display: flex;
            flex-direction: column;
            gap: 14px;
            margin-top: 32px;
            padding-top: 22px;
            border-top: 1px solid #eef1f0;
        }

        .btn-submit-reg {
            width: 100%;
            background-color: #141f1c;
            border: none;
            color: #ffffff;
            padding: 14px 26px;
            font-family: inherit;
            font-weight: 700;
            border-radius: 999px;
            font-size: 14.5px;
            cursor: pointer;
            display: inline-flex;
            align-items: center;
            justify-content: center;
            gap: 8px;
            transition: all 0.25s ease;
        }

            .btn-submit-reg:hover {
                background-color: var(--secondary-color);
                transform: translateY(-1px);
                box-shadow: 0 6px 18px rgba(26, 143, 109, 0.26);
            }

        .login-redirect-row {
            text-align: center;
            font-size: 14px;
            color: var(--text-gray);
        }

        .btn-back-login {
            color: var(--secondary-color);
            font-weight: 700;
            margin-left: 4px;
            transition: color 0.2s;
        }

            .btn-back-login:hover {
                color: var(--primary-color);
                text-decoration: underline;
            }

        /* ================= 4. SERVICE STRIP ================= */
        .service-strip {
            border-top: 1px solid #ecefef;
            background: #fafcfb;
            padding: 32px 0;
            margin-top: auto;
        }

        .service-grid {
            max-width: var(--container-max);
            margin: 0 auto;
            padding: 0 32px;
            display: grid;
            grid-template-columns: repeat(4, 1fr);
            gap: 24px;
        }

        .service-box {
            display: flex;
            align-items: center;
            gap: 14px;
        }

            .service-box .srv-icon {
                width: 44px;
                height: 44px;
                border-radius: 12px;
                background: #e8f5f1;
                color: var(--secondary-color);
                display: inline-flex;
                align-items: center;
                justify-content: center;
                font-size: 18px;
                flex-shrink: 0;
            }

            .service-box h4 {
                margin: 0 0 3px 0;
                font-size: 14.5px;
                font-weight: 700;
                color: var(--text-dark);
            }

            .service-box p {
                margin: 0;
                font-size: 12.5px;
                color: var(--text-gray);
            }

        /* ================= 5. MULTI-COLUMN DARK FOOTER ================= */
        .voltix-footer {
            background-color: #0b1411;
            color: #b7c4c0;
            padding-top: 52px;
        }

        .footer-grid {
            max-width: var(--container-max);
            margin: 0 auto;
            padding: 0 32px 40px 32px;
            display: grid;
            grid-template-columns: 1.4fr 1fr 1fr 1fr 1.2fr;
            gap: 32px;
        }

        .footer-brand .logo {
            color: #ffffff;
            margin-bottom: 14px;
        }

        .footer-brand p {
            font-size: 13px;
            line-height: 1.6;
            color: #93a39e;
            margin: 0 0 20px 0;
        }

        .social-links {
            display: flex;
            gap: 10px;
        }

            .social-links a {
                width: 34px;
                height: 34px;
                border-radius: 50%;
                background: rgba(255,255,255,0.08);
                color: #ffffff;
                display: inline-flex;
                align-items: center;
                justify-content: center;
                font-size: 13.5px;
                transition: background 0.2s;
            }

                .social-links a:hover {
                    background: var(--secondary-color);
                }

        .footer-col h4 {
            color: #ffffff;
            font-size: 14px;
            font-weight: 700;
            margin: 0 0 16px 0;
        }

        .footer-col ul {
            list-style: none;
            padding: 0;
            margin: 0;
            display: flex;
            flex-direction: column;
            gap: 10px;
            font-size: 13px;
        }

            .footer-col ul a:hover {
                color: #5eead4;
            }

        .app-badges {
            display: flex;
            flex-direction: column;
            gap: 10px;
            margin-top: 14px;
        }

        .app-badge-btn {
            display: inline-flex;
            align-items: center;
            gap: 10px;
            background: rgba(255,255,255,0.07);
            border: 1px solid rgba(255,255,255,0.14);
            color: #ffffff;
            padding: 8px 14px;
            border-radius: 10px;
            font-size: 12px;
            transition: background 0.2s;
        }

            .app-badge-btn:hover {
                background: rgba(255,255,255,0.14);
            }

            .app-badge-btn i {
                font-size: 18px;
            }

        .footer-bottom {
            border-top: 1px solid rgba(255,255,255,0.08);
            padding: 18px 0;
            font-size: 12.5px;
            color: #7f908b;
        }

            .footer-bottom .page-container {
                display: flex;
                justify-content: space-between;
                align-items: center;
            }

        .footer-legal {
            display: flex;
            gap: 18px;
        }

            .footer-legal a:hover {
                color: #ffffff;
            }

        /* ================= RESPONSIVE ================= */
        @@media (max-width: 1180px) {
            .nav-links {
                gap: 20px;
            }

            .search-bar {
                width: 210px;
            }
        }

        @@media (max-width: 1024px) {
            .footer-grid {
                grid-template-columns: repeat(2, 1fr);
            }
        }

        @@media (max-width: 820px) {
            .top-promo-bar,
            .nav-links,
            .search-bar {
                display: none;
            }

            .page-container {
                padding: 0 20px;
            }

            .register-page {
                padding: 24px 0 48px 0;
            }

            .register-card {
                padding: 28px 20px;
            }

            .form-row {
                grid-template-columns: 1fr;
            }

            .service-grid {
                grid-template-columns: 1fr;
            }
        }
    </style>
</head>
<body>

    <!-- 1. TOP ANNOUNCEMENT BAR -->
    <div class="top-promo-bar">
        <div class="page-container">
            <div class="promo-highlights">
                <span>Miễn phí vận chuyển cho đơn từ 500.000đ</span>
                <span class="sep">|</span>
                <span>Đổi trả dễ dàng 30 ngày</span>
                <span class="sep">|</span>
                <span>Công nghệ chính hãng 100%</span>
            </div>
            <div class="promo-meta">
                <span>VND <i class="fas fa-chevron-down" style="font-size:10px;"></i></span>
                <span style="color:#4b5c57;">|</span>
                <span>Tiếng Việt <i class="fas fa-chevron-down" style="font-size:10px;"></i></span>
            </div>
        </div>
    </div>

    <!-- 2. MAIN HEADER -->
    <header class="header-top">
        <div class="page-container">
            <a href="@Url.Action("Index", "Home")" class="logo">
                <i class="fas fa-shopping-bag"></i> PHONE & ACCES
            </a>

            <nav class="nav-links">
                <a href="@Url.Action("Index", "Home")">Trang chủ</a>
                <a href="@Url.Action("PageDienThoai", "Home")">Điện thoại</a>
                <a href="@Url.Action("PagePhuKien", "Home")">Phụ kiện</a>
                <a href="@Url.Action("PageThietBi", "Home")">Đồng hồ</a>
                <a href="#footer">Hỗ trợ</a>
            </nav>

            <div class="header-actions">
                @using (Html.BeginForm("Index", "Home", FormMethod.Get))
                {
                    <div class="search-bar">
                        <i class="fas fa-search" style="color:#8b9693; font-size:13px;"></i>
                        <input type="text" name="searchTerm" placeholder="Tìm sản phẩm..." />
                        <button type="submit" style="display:none;"></button>
                    </div>
                }

                @if (Session["Username"] != null)
                {
                    <div class="user-dropdown">
                        <div class="user-trigger" onclick="this.parentElement.classList.toggle('open')">
                            <i class="fas fa-user-circle" style="font-size: 17px;"></i>
                            <span>@Session["Username"]</span>
                            <i class="fas fa-chevron-down" style="font-size: 10px;"></i>
                        </div>
                        <div class="user-dropdown-menu">
                            <a href="@Url.Action("ProfileInfo", "Account")">Thông tin tài khoản</a>
                            <a href="@Url.Action("MyOrder", "Order")">Đơn hàng của tôi</a>
                            <a href="@Url.Action("Logout", "Account")" style="color: #d9534f;">Đăng xuất</a>
                        </div>
                    </div>
                }
                else
                {
                    <a href="@Url.Action("Login", "Account")" class="icon-btn" title="Đăng nhập">
                        <i class="fas fa-user" style="color: var(--secondary-color);"></i>
                    </a>
                }

                <a href="@Url.Action("Index", "Cart")" class="icon-btn" title="Giỏ hàng">
                    <i class="fas fa-shopping-cart"></i>
                    <span class="cart-badge">@cartCount</span>
                </a>
            </div>
        </div>
    </header>

    <!-- 3. NỘI DUNG ĐĂNG KÝ -->
    <main class="register-page">
        <div class="page-container">
            <div class="register-inner">
                <div class="breadcrumb-bar">
                    <a href="@Url.Action("Index", "Home")"><i class="fas fa-home"></i> Trang chủ</a>
                    <span>/</span>
                    <span class="current">Đăng ký tài khoản</span>
                </div>

                <div class="register-card">
                    <div class="register-header">
                        <div class="register-icon-badge">
                            <i class="fas fa-user-plus"></i>
                        </div>
                        <span class="register-eyebrow">Tạo tài khoản mới</span>
                        <h1 class="register-title">Đăng ký thành viên</h1>
                        <p class="register-subtitle">Tạo tài khoản <strong>PHONE & ACCES</strong> để nhận ưu đãi và theo dõi đơn hàng dễ dàng</p>
                    </div>

                    @using (Html.BeginForm("Register", "Account", FormMethod.Post))
                    {
                        @Html.AntiForgeryToken()
                        @Html.ValidationSummary(true, "", new { @class = "validation-summary-errors" })

                        <!-- THÔNG TIN CÁ NHÂN -->
                        <div class="section-heading">
                            <i class="fas fa-id-card"></i> Thông tin cá nhân
                        </div>

                        <div class="form-row">
                            <div class="form-group-custom">
                                @Html.LabelFor(model => model.CustomerName, "Họ và tên")
                                @Html.EditorFor(model => model.CustomerName, new { htmlAttributes = new { @class = "form-control-custom", placeholder = "Nhập họ và tên của bạn" } })
                                @Html.ValidationMessageFor(model => model.CustomerName, "", new { @class = "text-danger" })
                            </div>

                            <div class="form-group-custom">
                                <label for="BirthDate">Ngày sinh</label>
                                <input type="date" id="BirthDate" class="form-control-custom" />
                            </div>
                        </div>

                        <div class="form-row">
                            <div class="form-group-custom">
                                @Html.LabelFor(model => model.CustomerPhone, "Số điện thoại")
                                @Html.EditorFor(model => model.CustomerPhone, new { htmlAttributes = new { @class = "form-control-custom", placeholder = "Nhập số điện thoại" } })
                                @Html.ValidationMessageFor(model => model.CustomerPhone, "", new { @class = "text-danger" })
                            </div>

                            <div class="form-group-custom">
                                @Html.LabelFor(model => model.CustomerEmail, "Email")
                                @Html.EditorFor(model => model.CustomerEmail, new { htmlAttributes = new { @class = "form-control-custom", placeholder = "Nhập email (không bắt buộc)" } })
                                @Html.ValidationMessageFor(model => model.CustomerEmail, "", new { @class = "text-danger" })
                            </div>
                        </div>

                        <div class="form-group-custom">
                            @Html.LabelFor(model => model.CustomerAddress, "Địa chỉ nhận hàng")
                            @Html.EditorFor(model => model.CustomerAddress, new { htmlAttributes = new { @class = "form-control-custom", placeholder = "Số nhà, tên đường, phường/xã, quận/huyện, tỉnh/thành phố" } })
                            @Html.ValidationMessageFor(model => model.CustomerAddress, "", new { @class = "text-danger" })
                        </div>

                        <div class="form-group-custom">
                            <label>Giới tính</label>
                            <div class="gender-group">
                                <label class="gender-pill">
                                    <input type="radio" name="Gender" value="Nam" checked /> Nam
                                </label>
                                <label class="gender-pill">
                                    <input type="radio" name="Gender" value="Nữ" /> Nữ
                                </label>
                                <label class="gender-pill">
                                    <input type="radio" name="Gender" value="Khác" /> Khác
                                </label>
                            </div>
                        </div>

                        <!-- THÔNG TIN ĐĂNG NHẬP -->
                        <div class="section-heading">
                            <i class="fas fa-lock"></i> Thông tin đăng nhập
                        </div>

                        <div class="form-group-custom">
                            @Html.LabelFor(model => model.Username, "Tên đăng nhập")
                            @Html.EditorFor(model => model.Username, new { htmlAttributes = new { @class = "form-control-custom", placeholder = "Chọn tên đăng nhập" } })
                            @Html.ValidationMessageFor(model => model.Username, "", new { @class = "text-danger" })
                        </div>

                        <div class="form-row">
                            <div class="form-group-custom">
                                @Html.LabelFor(model => model.Password, "Mật khẩu")
                                <div class="input-wrapper">
                                    @Html.EditorFor(model => model.Password, new { htmlAttributes = new { @class = "form-control-custom", placeholder = "Nhập mật khẩu", type = "password", id = "regPassword", style = "padding-right: 42px;" } })
                                    <button type="button" class="toggle-password-btn" onclick="togglePass('regPassword', this)" title="Hiện/ẩn mật khẩu">
                                        <i class="far fa-eye"></i>
                                    </button>
                                </div>
                                @Html.ValidationMessageFor(model => model.Password, "", new { @class = "text-danger" })
                            </div>

                            <div class="form-group-custom">
                                @Html.LabelFor(model => model.ConfirmPassword, "Nhập lại mật khẩu")
                                <div class="input-wrapper">
                                    @Html.PasswordFor(model => model.ConfirmPassword, new { @class = "form-control-custom", placeholder = "Xác nhận lại mật khẩu", id = "regConfirmPassword", style = "padding-right: 42px;" })
                                    <button type="button" class="toggle-password-btn" onclick="togglePass('regConfirmPassword', this)" title="Hiện/ẩn mật khẩu">
                                        <i class="far fa-eye"></i>
                                    </button>
                                </div>
                                @Html.ValidationMessageFor(model => model.ConfirmPassword, "", new { @class = "text-danger" })
                            </div>
                        </div>

                        <!-- NÚT BẤM -->
                        <div class="action-buttons">
                            <button type="submit" class="btn-submit-reg">
                                <i class="fas fa-check-circle"></i> Hoàn tất đăng ký
                            </button>

                            <div class="login-redirect-row">
                                Bạn đã có tài khoản?
                                <a href="@Url.Action("Login", "Account", null)" class="btn-back-login">Đăng nhập ngay</a>
                            </div>
                        </div>
                    }
                </div>
            </div>
        </div>
    </main>

    <!-- 4. SERVICE STRIP -->
    <div class="service-strip">
        <div class="service-grid">
            <div class="service-box">
                <span class="srv-icon"><i class="fas fa-truck"></i></span>
                <div>
                    <h4>Miễn phí vận chuyển</h4>
                    <p>Cho đơn hàng từ 500.000đ</p>
                </div>
            </div>

            <div class="service-box">
                <span class="srv-icon"><i class="fas fa-undo-alt"></i></span>
                <div>
                    <h4>Đổi trả 30 ngày</h4>
                    <p>Bảo hành 1 đổi 1 dễ dàng</p>
                </div>
            </div>

            <div class="service-box">
                <span class="srv-icon"><i class="fas fa-headset"></i></span>
                <div>
                    <h4>Hỗ trợ 24/7</h4>
                    <p>Tư vấn kỹ thuật tận tâm</p>
                </div>
            </div>

            <div class="service-box">
                <span class="srv-icon"><i class="fas fa-shield-alt"></i></span>
                <div>
                    <h4>Thanh toán bảo mật</h4>
                    <p>Hỗ trợ PayPal & COD an toàn</p>
                </div>
            </div>
        </div>
    </div>

    <!-- 5. MULTI-COLUMN DARK FOOTER -->
    <footer class="voltix-footer" id="footer">
        <div class="footer-grid">
            <div class="footer-brand">
                <a href="@Url.Action("Index", "Home")" class="logo">
                    <i class="fas fa-shopping-bag"></i> PHONE & ACCES
                </a>
                <p>Hệ thống bán lẻ điện thoại thông minh, đồng hồ và phụ kiện công nghệ chính hãng hàng đầu dành cho bạn.</p>
                <div class="social-links">
                    <a href="#"><i class="fab fa-facebook-f"></i></a>
                    <a href="#"><i class="fab fa-instagram"></i></a>
                    <a href="#"><i class="fab fa-youtube"></i></a>
                    <a href="#"><i class="fab fa-tiktok"></i></a>
                </div>
            </div>

            <div class="footer-col">
                <h4>Danh mục</h4>
                <ul>
                    <li><a href="@Url.Action("PageDienThoai", "Home")">Điện thoại</a></li>
                    <li><a href="@Url.Action("PagePhuKien", "Home")">Phụ kiện</a></li>
                    <li><a href="@Url.Action("PageThietBi", "Home")">Đồng hồ thông minh</a></li>
                    <li><a href="@Url.Action("Index", "Home")#featured">Sản phẩm nổi bật</a></li>
                </ul>
            </div>

            <div class="footer-col">
                <h4>Về chúng tôi</h4>
                <ul>
                    <li><a href="#footer">Giới thiệu cửa hàng</a></li>
                    <li><a href="#footer">Chính sách bảo hành</a></li>
                    <li><a href="#footer">Tin tức công nghệ</a></li>
                    <li><a href="#footer">Hệ thống chi nhánh</a></li>
                </ul>
            </div>

            <div class="footer-col">
                <h4>Hỗ trợ khách hàng</h4>
                <ul>
                    <li><a href="@Url.Action("MyOrder", "Order")">Tra cứu đơn hàng</a></li>
                    <li><a href="@Url.Action("ProfileInfo", "Account")">Tài khoản của tôi</a></li>
                    <li><a href="#footer">Hướng dẫn thanh toán PayPal</a></li>
                    <li><a href="#footer">Chính sách đổi trả</a></li>
                </ul>
            </div>

            <div class="footer-col">
                <h4>Tải ứng dụng</h4>
                <p style="font-size:12.5px; color:#93a39e; margin:0;">Trải nghiệm mua sắm tiện lợi hơn trên điện thoại.</p>
                <div class="app-badges">
                    <a href="#footer" class="app-badge-btn">
                        <i class="fab fa-apple"></i>
                        <span>Tải về trên <strong>App Store</strong></span>
                    </a>
                    <a href="#footer" class="app-badge-btn">
                        <i class="fab fa-google-play"></i>
                        <span>Tải về trên <strong>Google Play</strong></span>
                    </a>
                </div>
            </div>
        </div>

        <div class="footer-bottom">
            <div class="page-container">
                <span>© 2026 PHONE & ACCES. All rights reserved.</span>
                <div class="footer-legal">
                    <a href="#footer">Chính sách bảo mật</a>
                    <a href="#footer">Điều khoản dịch vụ</a>
                    <a href="#footer">Sơ đồ trang</a>
                </div>
            </div>
        </div>
    </footer>

    <script>
        function togglePass(inputId, btn) {
            const input = document.getElementById(inputId);
            const icon = btn.querySelector('i');
            if (!input) return;

            if (input.type === 'password') {
                input.type = 'text';
                icon.classList.remove('fa-eye');
                icon.classList.add('fa-eye-slash');
            } else {
                input.type = 'password';
                icon.classList.remove('fa-eye-slash');
                icon.classList.add('fa-eye');
            }
        }

        document.addEventListener('click', function (e) {
            const dropdown = document.querySelector('.user-dropdown');
            if (dropdown && !dropdown.contains(e.target)) {
                dropdown.classList.remove('open');
            }
        });
    </script>

</body>
</html>