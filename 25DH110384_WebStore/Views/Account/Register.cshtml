@model _25DH110384_WebStore.Models.ViewModel.RegisterVM

@{
    Layout = null;
    var cart = Session["Cart"] as _25DH110384_WebStore.Models.ViewModel.Cart;
    int cartCount = (cart != null && cart.Items != null) ? cart.Items.Count() : 0;
}

<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Đăng ký tài khoản - PHONE & ACCES</title>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&display=swap" rel="stylesheet">

    <style>
        :root {
            --primary-color: #0b4d3c;
            --secondary-color: #1a8f6d;
            --bg-light: #f8f9fa;
            --text-dark: #333;
            --text-gray: #666;
            --border-radius: 16px;
        }

        html {
            scroll-behavior: smooth;
        }

        body {
            font-family: 'Inter', sans-serif;
            margin: 0;
            padding: 0;
            background-color: #f4f6f8;
            color: var(--text-dark);
            display: flex;
            flex-direction: column;
            min-height: 100vh;
        }

        a {
            text-decoration: none;
            color: inherit;
        }

        /* HEADER */
        .header-top {
            background-color: #fff;
            padding: 15px 50px;
            display: flex;
            align-items: center;
            justify-content: space-between;
            border-bottom: 1px solid #eee;
        }

        .logo {
            font-size: 24px;
            font-weight: 700;
            color: var(--primary-color);
            display: flex;
            align-items: center;
            gap: 10px;
        }

        .nav-links {
            display: flex;
            gap: 30px;
            font-weight: 500;
        }

            .nav-links a {
                position: relative;
                padding-bottom: 6px;
                transition: color 0.25s ease;
            }

                .nav-links a::after {
                    content: "";
                    position: absolute;
                    left: 0;
                    bottom: 0;
                    width: 0;
                    height: 2.5px;
                    background-color: var(--secondary-color);
                    border-radius: 2px;
                    transition: width 0.25s ease;
                }

                .nav-links a:hover {
                    color: var(--secondary-color);
                }

                    .nav-links a:hover::after {
                        width: 100%;
                    }

        .header-actions {
            display: flex;
            align-items: center;
            gap: 20px;
        }

        .search-bar {
            background: var(--bg-light);
            border-radius: 20px;
            padding: 8px 15px;
            display: flex;
            align-items: center;
        }

            .search-bar input {
                border: none;
                background: transparent;
                outline: none;
                padding-left: 10px;
                width: 200px;
            }

        .icon-btn {
            font-size: 20px;
            color: var(--text-dark);
            cursor: pointer;
            position: relative;
        }

        .cart-badge {
            position: absolute;
            top: -8px;
            right: -10px;
            background: var(--secondary-color);
            color: #fff;
            font-size: 11px;
            padding: 2px 6px;
            border-radius: 10px;
            font-weight: bold;
        }

        /* BREADCRUMB */
        .breadcrumb-bar {
            max-width: 740px;
            width: 100%;
            box-sizing: border-box;
            margin: 22px auto 0 auto;
            padding: 0 24px;
            font-size: 14px;
            color: var(--text-gray);
            display: flex;
            align-items: center;
            gap: 8px;
        }

            .breadcrumb-bar a:hover {
                color: var(--secondary-color);
            }

            .breadcrumb-bar span.current {
                color: var(--primary-color);
                font-weight: 600;
            }

        /* REGISTER CONTAINER */
        .register-wrapper {
            max-width: 740px;
            width: 100%;
            box-sizing: border-box;
            margin: 18px auto 60px auto;
            padding: 0 24px;
            flex: 1;
        }

        .register-card {
            background: #ffffff;
            padding: 38px 44px;
            border-radius: var(--border-radius);
            border: 1px solid #eaeaea;
            box-shadow: 0 8px 28px rgba(0, 0, 0, 0.04);
        }

        .register-header {
            text-align: center;
            margin-bottom: 24px;
        }

        .register-icon-badge {
            width: 60px;
            height: 60px;
            border-radius: 50%;
            background: #e6f4f0;
            color: var(--secondary-color);
            display: inline-flex;
            align-items: center;
            justify-content: center;
            font-size: 24px;
            margin-bottom: 14px;
        }

        .register-title {
            color: var(--primary-color);
            font-weight: 700;
            margin: 0 0 6px 0;
            font-size: 24px;
            letter-spacing: 0.3px;
        }

        .register-subtitle {
            color: var(--text-gray);
            font-size: 14px;
            margin: 0;
        }

        /* SOCIAL LOGIN */
        .social-login {
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 14px;
            margin: 22px 0;
        }

        .btn-social {
            border: 1px solid #e0e0e0;
            background: #fff;
            padding: 11px 18px;
            border-radius: 10px;
            font-size: 14px;
            font-weight: 600;
            color: var(--text-dark);
            display: inline-flex;
            align-items: center;
            justify-content: center;
            gap: 10px;
            transition: all 0.2s ease;
        }

            .btn-social:hover {
                background: #f8fbfa;
                border-color: var(--secondary-color);
                color: var(--primary-color);
            }

        /* DIVIDER */
        .divider-line {
            display: flex;
            align-items: center;
            text-align: center;
            margin: 22px 0 26px 0;
            color: #888;
            font-size: 13px;
        }

            .divider-line::before,
            .divider-line::after {
                content: "";
                flex: 1;
                border-bottom: 1px solid #eaeaea;
            }

            .divider-line span {
                padding: 0 14px;
            }

        /* SECTION HEADING */
        .section-heading {
            font-size: 16px;
            font-weight: 700;
            color: var(--primary-color);
            margin: 26px 0 16px 0;
            padding-bottom: 10px;
            border-bottom: 2px solid #e6f4f0;
            display: flex;
            align-items: center;
            gap: 8px;
        }

            .section-heading:first-of-type {
                margin-top: 0;
            }

        /* FORM GRID & INPUTS */
        .form-row {
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 18px;
            margin-bottom: 16px;
        }

        .form-group-custom {
            margin-bottom: 16px;
        }

        .form-row .form-group-custom {
            margin-bottom: 0;
        }

        .form-group-custom label {
            display: block;
            font-weight: 600;
            font-size: 13px;
            color: var(--text-dark);
            margin-bottom: 7px;
        }

        .input-wrapper {
            position: relative;
        }

        .form-control-custom {
            width: 100%;
            box-sizing: border-box;
            height: 44px;
            padding: 10px 14px;
            border: 1px solid #dcdcdc;
            border-radius: 10px;
            font-family: inherit;
            font-size: 14px;
            color: var(--text-dark);
            background-color: #fff;
            transition: border-color 0.25s, box-shadow 0.25s;
        }

            .form-control-custom:focus {
                border-color: var(--secondary-color);
                outline: none;
                box-shadow: 0 0 0 3px rgba(26, 143, 109, 0.12);
            }

        .toggle-password-btn {
            position: absolute;
            right: 12px;
            top: 50%;
            transform: translateY(-50%);
            background: none;
            border: none;
            color: #999;
            cursor: pointer;
            font-size: 15px;
            padding: 4px;
        }

            .toggle-password-btn:hover {
                color: var(--primary-color);
            }

        /* VALIDATION ERRORS */
        .field-validation-error,
        .text-danger {
            display: block;
            color: #d93025;
            font-size: 12px;
            margin-top: 5px;
            font-weight: 500;
        }

        .validation-summary-errors {
            background: #fdf4f4;
            border: 1px solid #f5c6cb;
            color: #d93025;
            padding: 12px 16px;
            border-radius: 10px;
            font-size: 13px;
            margin-bottom: 20px;
        }

            .validation-summary-errors ul {
                margin: 0;
                padding-left: 18px;
            }

        /* GENDER RADIO PILLS */
        .gender-group {
            display: flex;
            gap: 14px;
            flex-wrap: wrap;
        }

        .gender-pill {
            display: inline-flex;
            align-items: center;
            gap: 8px;
            padding: 9px 18px;
            border: 1px solid #dcdcdc;
            border-radius: 10px;
            font-size: 14px;
            font-weight: 500;
            color: var(--text-dark);
            cursor: pointer;
            transition: all 0.2s ease;
            user-select: none;
            background: #fff;
        }

            .gender-pill:hover {
                border-color: var(--secondary-color);
                background: #f8fbfa;
            }

            .gender-pill input[type="radio"] {
                accent-color: var(--secondary-color);
                width: 16px;
                height: 16px;
                margin: 0;
                cursor: pointer;
            }

            .gender-pill:has(input[type="radio"]:checked) {
                border-color: var(--secondary-color);
                background: #eef8f5;
                color: var(--primary-color);
                font-weight: 600;
            }

        /* ACTION BUTTONS */
        .action-buttons {
            display: flex;
            flex-direction: column;
            gap: 12px;
            margin-top: 30px;
        }

        .btn-submit-reg {
            width: 100%;
            background-color: var(--secondary-color);
            border: none;
            color: #fff;
            padding: 14px 24px;
            font-family: inherit;
            font-weight: 700;
            border-radius: 10px;
            font-size: 15px;
            cursor: pointer;
            transition: all 0.25s ease;
            box-shadow: 0 4px 12px rgba(26, 143, 109, 0.25);
        }

            .btn-submit-reg:hover {
                background-color: var(--primary-color);
                transform: translateY(-1px);
            }

        .login-redirect-row {
            text-align: center;
            margin-top: 8px;
            font-size: 14px;
            color: var(--text-gray);
        }

        .btn-back-login {
            color: var(--secondary-color);
            font-weight: 600;
            margin-left: 4px;
            transition: color 0.2s;
        }

            .btn-back-login:hover {
                color: var(--primary-color);
                text-decoration: underline;
            }

        /* FOOTER */
        .phone-footer {
            background-color: var(--primary-color);
            color: #fff;
            padding: 40px 50px;
            display: flex;
            justify-content: space-between;
            align-items: center;
            margin-top: auto;
        }

            .phone-footer h3 {
                margin: 0 0 8px 0;
                font-size: 22px;
            }

            .phone-footer p {
                margin: 0;
                color: #cce5de;
                font-size: 14px;
            }

        @@media (max-width: 768px) {
            .header-top {
                padding: 15px 20px;
            }

            .nav-links {
                display: none;
            }

            .register-card {
                padding: 28px 20px;
            }

            .form-row,
            .social-login {
                grid-template-columns: 1fr;
            }
        }
    </style>
</head>
<body>

    <!-- HEADER -->
    <header class="header-top">
        <a href="@Url.Action("Index", "Home")" class="logo">
            <i class="fas fa-shopping-bag"></i> PHONE & ACCES
        </a>

        <nav class="nav-links">
            <a href="@Url.Action("Index", "Home")">Trang chủ</a>
            <a href="@Url.Action("PageDienThoai", "Home")">Điện thoại</a>
            <a href="@Url.Action("PagePhuKien", "Home")">Phụ kiện</a>
            <a href="@Url.Action("PageThietBi", "Home")">Đồng hồ</a>
            <a href="#footer">Hỗ trợ</a>
        </nav>

        <div class="header-actions">
            @using (Html.BeginForm("Index", "Home", FormMethod.Get))
            {
                <div class="search-bar">
                    <i class="fas fa-search" style="color:#aaa;"></i>
                    <input type="text" name="searchTerm" placeholder="Tìm sản phẩm..." />
                    <button type="submit" style="display:none;"></button>
                </div>
            }

            <a href="@Url.Action("Login", "Account")" class="icon-btn" title="Đăng nhập">
                <i class="fas fa-user" style="color: var(--secondary-color);"></i>
            </a>

            <a href="@Url.Action("Index", "Cart")" class="icon-btn">
                <i class="fas fa-shopping-cart"></i>
                <span class="cart-badge">@cartCount</span>
            </a>
        </div>
    </header>

    <!-- BREADCRUMB -->
    <div class="breadcrumb-bar">
        <a href="@Url.Action("Index", "Home")"><i class="fas fa-home"></i> Trang chủ</a>
        <span>/</span>
        <span class="current">Đăng ký tài khoản</span>
    </div>

    <!-- NỘI DUNG ĐĂNG KÝ -->
    <main class="register-wrapper">
        <div class="register-card">
            <div class="register-header">
                <div class="register-icon-badge">
                    <i class="fas fa-user-plus"></i>
                </div>
                <h1 class="register-title">Đăng ký thành viên</h1>
                <p class="register-subtitle">Tạo tài khoản <strong>PHONE & ACCES</strong> để nhận ưu đãi và theo dõi đơn hàng dễ dàng</p>
            </div>

            

            @using (Html.BeginForm("Register", "Account", FormMethod.Post))
            {
                @Html.AntiForgeryToken()
                @Html.ValidationSummary(true, "", new { @class = "validation-summary-errors" })

                <!-- THÔNG TIN CÁ NHÂN -->
                <div class="section-heading">
                    <i class="fas fa-id-card"></i> Thông tin cá nhân
                </div>

                <div class="form-row">
                    <div class="form-group-custom">
                        @Html.LabelFor(model => model.CustomerName, "Họ và tên")
                        @Html.EditorFor(model => model.CustomerName, new { htmlAttributes = new { @class = "form-control-custom", placeholder = "Nhập họ và tên của bạn" } })
                        @Html.ValidationMessageFor(model => model.CustomerName, "", new { @class = "text-danger" })
                    </div>

                    <div class="form-group-custom">
                        <label for="BirthDate">Ngày sinh</label>
                        <input type="date" id="BirthDate" class="form-control-custom" />
                    </div>
                </div>

                <div class="form-row">
                    <div class="form-group-custom">
                        @Html.LabelFor(model => model.CustomerPhone, "Số điện thoại")
                        @Html.EditorFor(model => model.CustomerPhone, new { htmlAttributes = new { @class = "form-control-custom", placeholder = "Nhập số điện thoại" } })
                        @Html.ValidationMessageFor(model => model.CustomerPhone, "", new { @class = "text-danger" })
                    </div>

                    <div class="form-group-custom">
                        @Html.LabelFor(model => model.CustomerEmail, "Email")
                        @Html.EditorFor(model => model.CustomerEmail, new { htmlAttributes = new { @class = "form-control-custom", placeholder = "Nhập email (không bắt buộc)" } })
                        @Html.ValidationMessageFor(model => model.CustomerEmail, "", new { @class = "text-danger" })
                    </div>
                </div>

                <div class="form-group-custom">
                    @Html.LabelFor(model => model.CustomerAddress, "Địa chỉ nhận hàng")
                    @Html.EditorFor(model => model.CustomerAddress, new { htmlAttributes = new { @class = "form-control-custom", placeholder = "Số nhà, tên đường, phường/xã, quận/huyện, tỉnh/thành phố" } })
                    @Html.ValidationMessageFor(model => model.CustomerAddress, "", new { @class = "text-danger" })
                </div>

                <div class="form-group-custom">
                    <label>Giới tính</label>
                    <div class="gender-group">
                        <label class="gender-pill">
                            <input type="radio" name="Gender" value="Nam" checked /> Nam
                        </label>
                        <label class="gender-pill">
                            <input type="radio" name="Gender" value="Nữ" /> Nữ
                        </label>
                        <label class="gender-pill">
                            <input type="radio" name="Gender" value="Khác" /> Khác
                        </label>
                    </div>
                </div>

                <!-- THÔNG TIN ĐĂNG NHẬP -->
                <div class="section-heading">
                    <i class="fas fa-lock"></i> Thông tin đăng nhập
                </div>

                <div class="form-group-custom">
                    @Html.LabelFor(model => model.Username, "Tên đăng nhập")
                    @Html.EditorFor(model => model.Username, new { htmlAttributes = new { @class = "form-control-custom", placeholder = "Chọn tên đăng nhập" } })
                    @Html.ValidationMessageFor(model => model.Username, "", new { @class = "text-danger" })
                </div>

                <div class="form-row">
                    <div class="form-group-custom">
                        @Html.LabelFor(model => model.Password, "Mật khẩu")
                        <div class="input-wrapper">
                            @Html.EditorFor(model => model.Password, new { htmlAttributes = new { @class = "form-control-custom", placeholder = "Nhập mật khẩu", type = "password", id = "regPassword", style = "padding-right: 40px;" } })
                            <button type="button" class="toggle-password-btn" onclick="togglePass('regPassword', this)" title="Hiện/ẩn mật khẩu">
                                <i class="far fa-eye"></i>
                            </button>
                        </div>
                        @Html.ValidationMessageFor(model => model.Password, "", new { @class = "text-danger" })
                    </div>

                    <div class="form-group-custom">
                        @Html.LabelFor(model => model.ConfirmPassword, "Nhập lại mật khẩu")
                        <div class="input-wrapper">
                            @Html.PasswordFor(model => model.ConfirmPassword, new { @class = "form-control-custom", placeholder = "Xác nhận lại mật khẩu", id = "regConfirmPassword", style = "padding-right: 40px;" })
                            <button type="button" class="toggle-password-btn" onclick="togglePass('regConfirmPassword', this)" title="Hiện/ẩn mật khẩu">
                                <i class="far fa-eye"></i>
                            </button>
                        </div>
                        @Html.ValidationMessageFor(model => model.ConfirmPassword, "", new { @class = "text-danger" })
                    </div>
                </div>

                <!-- NÚT BẤM -->
                <div class="action-buttons">
                    <button type="submit" class="btn-submit-reg">
                        <i class="fas fa-check-circle"></i> Hoàn tất đăng ký
                    </button>

                    <div class="login-redirect-row">
                        Bạn đã có tài khoản?
                        <a href="@Url.Action("Login", "Account", null)" class="btn-back-login">Đăng nhập ngay</a>
                    </div>
                </div>
            }
        </div>
    </main>

    <!-- FOOTER -->
    <footer class="phone-footer" id="footer">
        <div>
            <h3>PHONE & ACCES</h3>
            <p>Điện thoại và phụ kiện công nghệ chính hãng dành cho bạn.</p>
        </div>
        <p>© 2026 PHONE & ACCES. All rights reserved.</p>
    </footer>

    <script>
        function togglePass(inputId, btn) {
            const input = document.getElementById(inputId);
            const icon = btn.querySelector('i');
            if (!input) return;

            if (input.type === 'password') {
                input.type = 'text';
                icon.classList.remove('fa-eye');
                icon.classList.add('fa-eye-slash');
            } else {
                input.type = 'password';
                icon.classList.remove('fa-eye-slash');
                icon.classList.add('fa-eye');
            }
        }
    </script>

</body>
</html>