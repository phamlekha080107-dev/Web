@model _25DH110384_WebStore.Models.ViewModel.ProfileVM

@{
    ViewBag.Title = "Thông tin tài khoản";
    Layout = "~/Views/Shared/_Layout.cshtml"; // Hoặc Layout trang chủ của Kha
}

<style>
    .profile-container {
        max-width: 650px;
        margin: 40px auto;
        background: #ffffff;
        border-radius: 10px;
        box-shadow: 0 4px 15px rgba(0,0,0,0.08);
        border: 1px solid #e9ecef;
        overflow: hidden;
    }

    .profile-header {
        background-color: #1e824c;
        color: white;
        padding: 20px;
        font-weight: bold;
        font-size: 1.3rem;
        text-align: center;
    }

    .profile-body {
        padding: 30px;
    }

    .form-group {
        margin-bottom: 20px;
    }

        .form-group label {
            font-weight: 600;
            color: #333;
            margin-bottom: 8px;
            display: block;
        }

    .form-control {
        border-radius: 6px;
        padding: 10px 12px;
        border: 1px solid #ced4da;
        width: 100%;
    }

    .btn-save {
        background-color: #1e824c;
        color: white;
        padding: 10px 25px;
        font-weight: 600;
        border-radius: 6px;
        border: none;
        transition: background-color 0.2s;
    }

        .btn-save:hover {
            background-color: #145c35;
        }

    .alert-success {
        background-color: #d4edda;
        color: #155724;
        padding: 12px;
        border-radius: 6px;
        margin-bottom: 20px;
        border: 1px solid #c3e6cb;
    }
</style>

<div class="profile-container">
    <div class="profile-header">
        <i class="fas fa-user-cog" style="margin-right: 8px;"></i> THÔNG TIN TÀI KHOẢN CÁ NHÂN
    </div>

    <div class="profile-body">
        @if (ViewBag.Message != null)
        {
            <div class="alert-success">
                <i class="fas fa-check-circle" style="margin-right: 5px;"></i> @ViewBag.Message
            </div>
        }

        @using (Html.BeginForm("ProfileInfo", "Account", FormMethod.Post))
        {
            @Html.AntiForgeryToken()
            @Html.HiddenFor(m => m.CustomerID)

            <div class="form-group">
                <label>Tên đăng nhập (Username):</label>
                @Html.TextBoxFor(m => m.Username, new { @class = "form-control", @readonly = "readonly", style = "background-color: #e9ecef;" })
            </div>

            <div class="form-group">
                <label>Họ và tên:</label>
                @Html.TextBoxFor(m => m.CustomerName, new { @class = "form-control", @placeholder = "Nhập họ và tên..." })
                @Html.ValidationMessageFor(m => m.CustomerName, "", new { @class = "text-danger" })
            </div>

            <div class="form-group">
                <label>Số điện thoại:</label>
                @Html.TextBoxFor(m => m.CustomerPhone, new { @class = "form-control", @placeholder = "Nhập số điện thoại..." })
                @Html.ValidationMessageFor(m => m.CustomerPhone, "", new { @class = "text-danger" })
            </div>

            <div class="form-group">
                <label>Email:</label>
                @Html.TextBoxFor(m => m.CustomerEmail, new { @class = "form-control", @placeholder = "Nhập địa chỉ email..." })
                @Html.ValidationMessageFor(m => m.CustomerEmail, "", new { @class = "text-danger" })
            </div>

            <div class="form-group">
                <label>Địa chỉ giao hàng mặc định:</label>
                @Html.TextAreaFor(m => m.CustomerAddress, new { @class = "form-control", @rows = 3, @placeholder = "Nhập địa chỉ nhận hàng..." })
                @Html.ValidationMessageFor(m => m.CustomerAddress, "", new { @class = "text-danger" })
            </div>

            <div style="margin-top: 25px; display: flex; justify-content: space-between; align-items: center;">
                <button type="submit" class="btn btn-save">
                    <i class="fas fa-save" style="margin-right: 5px;"></i> Cập nhật thông tin
                </button>
                <a href="@Url.Action("Index", "Home")" class="btn btn-default" style="font-weight: 600;">
                    ← Quay lại trang chủ
                </a>
            </div>
        }
    </div>
</div>