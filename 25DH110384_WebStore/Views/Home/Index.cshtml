@model _25DH110384_WebStore.Models.ViewModel.HomeProductVM

@{
    Layout = null;
    // Lấy số lượng sản phẩm thực tế trong giỏ hàng từ Session
    var cart = Session["Cart"] as _25DH110384_WebStore.Models.ViewModel.Cart;
    int cartCount = (cart != null && cart.Items != null) ? cart.Items.Count() : 0;
}

<link rel="stylesheet" href="~/Content/Index.css" />

<style>
    .user-dropdown {
        position: relative;
        display: inline-block;
        cursor: pointer;
    }

    .user-name-btn {
        color: #1e824c;
        font-weight: bold;
        text-decoration: none;
        padding: 8px 12px;
        border-radius: 6px;
        background-color: #e8f5e9;
        display: inline-block;
    }

    .user-dropdown-menu {
        display: none;
        position: absolute;
        right: 0;
        top: 100%;
        padding-top: 8px; /* Tạo khoảng đệm để chuột di chuyển mượt mà không bị mất menu */
        background-color: transparent;
        z-index: 1000;
        min-width: 190px;
    }

    .user-dropdown-content-box {
        background-color: #ffffff;
        box-shadow: 0 8px 16px rgba(0,0,0,0.15);
        border-radius: 6px;
        border: 1px solid #eee;
        overflow: hidden;
    }

    /* Giữ menu hiển thị khi hover vào nút hoặc chính menu */
    .user-dropdown:hover .user-dropdown-menu {
        display: block;
    }

    .user-dropdown-menu a {
        color: #333;
        padding: 12px 16px;
        text-decoration: none;
        display: block;
        font-size: 14px;
        border-bottom: 1px solid #f5f5f5;
        text-align: left;
    }

        .user-dropdown-menu a:last-child {
            border-bottom: none;
        }

        .user-dropdown-menu a:hover {
            background-color: #f8f9fa;
            color: #1e824c;
        }
</style>

<div class="top-note">MIỄN PHÍ VẬN CHUYỂN CHO ĐƠN HÀNG TỪ 500.000Đ</div>

<header class="header">
    <a class="logo" href="@Url.Action("Index", "Home")">PHONE & ACCES</a>
    <div class="header-right">

        @using (Html.BeginForm("Index", "Home", FormMethod.Get))
        {
            <div class="form-group search-container">
                @Html.TextBoxFor(m => m.SearchTerm, new
                {
                    @class = "search-input",
                    @id = "search-input",
                    @placeholder = "Tìm sản phẩm..."
                })
                <button type="submit" class="search-button" style="display:none;">Tìm</button>
            </div>
        }

        <span class="wishlist">♡ Yêu thích</span>

        <a href="@Url.Action("Index", "Cart")" class="login-link">
            🛒 Giỏ hàng <b id="cart-count">@cartCount</b>
        </a>

        <!-- KIỂM TRA ĐĂNG NHẬP -->
        @if (Session["Username"] != null)
        {
            <div class="user-dropdown">
                <span class="user-name-btn">
                    👤 Xin chào, @Session["Username"] ▾
                </span>
                <div class="user-dropdown-menu">
                    <div class="user-dropdown-content-box">
                        <a href="@Url.Action("ProfileInfo", "Account")">Thông tin tài khoản</a>
                        <a href="@Url.Action("MyOrder", "Order")">Đơn hàng của tôi</a>
                        <a href="@Url.Action("Logout", "Account")" style="color: #d9534f; font-weight: 600;">Đăng xuất</a>
                    </div>
                </div>
            </div>
        }
        else
        {
            <a href="@Url.Action("Login", "Account")" class="login-link">
                Đăng nhập
            </a>
        }
    </div>
</header>

<nav class="navbar">
    <a href="@Url.Action("Index", "Home")">TRANG CHỦ</a>
    <a href="@Url.Action("PageDienThoai", "Home")">ĐIỆN THOẠI</a>
    <a href="#products">PHỤ KIỆN</a>
    <a href="#featured">THIẾT BỊ ĐEO THÔNG MINH</a>
    <a href="#footer">THÔNG TIN HỖ TRỢ</a>
</nav>

<section class="hero">
    <div class="hero-copy">
        <p class="eyebrow">SẢN PHẨM MỚI</p>
        <h1>SMART PHONE</h1>
        <span class="small-line"></span>
        <p>Thiết kế nổi bật, hiện đại cho mỗi ngày.</p>
        <a class="btn" href="#products">KHÁM PHÁ NGAY  →</a>
    </div>
</section>

@* Phần hiển thị các danh mục hoặc sản phẩm bên dưới banner *@
<div class="container">
    @* Sản phẩm nổi bật *@
    @Html.Partial("PVFeatureProduct", Model)

    @* Sản phẩm mới *@
    @Html.Partial("PVNewProduct", Model)
</div>