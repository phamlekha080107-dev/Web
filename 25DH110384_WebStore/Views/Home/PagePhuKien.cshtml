@model _25DH110384_WebStore.Models.ViewModel.HomeProductVM
@using PagedList.Mvc;

@{
    Layout = null;
    var cart = Session["Cart"] as _25DH110384_WebStore.Models.ViewModel.Cart;
    int cartCount = (cart != null && cart.Items != null) ? cart.Items.Count() : 0;

    string currentAction = ViewContext.RouteData.Values["action"] != null
        ? ViewContext.RouteData.Values["action"].ToString()
        : "PageThietBi";
    bool isDongHo = currentAction.Equals("PageThietBi", StringComparison.OrdinalIgnoreCase);

    string formAction = isDongHo ? "PageThietBi" : "PagePhuKien";
    string pageTitle = isDongHo ? "Đồng hồ" : "Phụ kiện";
    string searchPlaceholder = isDongHo ? "Tìm đồng hồ..." : "Tìm phụ kiện...";
    string searchInputPlaceholder = isDongHo ? "Tìm tên đồng hồ..." : "Tìm tên phụ kiện...";
    string listHeading = isDongHo ? "DANH SÁCH ĐỒNG HỒ" : "DANH SÁCH PHỤ KIỆN";
    string emptyCategoryName = isDongHo ? "Đồng hồ" : "Phụ kiện";
}

<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@pageTitle - PHONE & ACCES</title>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&display=swap" rel="stylesheet">

    <style>
        :root {
            --primary-color: #0b4d3c;
            --secondary-color: #1a8f6d;
            --bg-light: #f8f9fa;
            --text-dark: #333;
            --text-gray: #666;
            --border-radius: 12px;
        }

        html {
            scroll-behavior: smooth;
        }

        body {
            font-family: 'Inter', sans-serif;
            margin: 0;
            padding: 0;
            background-color: #ffffff;
            color: var(--text-dark);
        }

        a {
            text-decoration: none;
            color: inherit;
        }

        /* HEADER */
        .header-top {
            background-color: #fff;
            padding: 15px 50px;
            display: flex;
            align-items: center;
            justify-content: space-between;
            border-bottom: 1px solid #eee;
        }

        .logo {
            font-size: 24px;
            font-weight: 700;
            color: var(--primary-color);
            display: flex;
            align-items: center;
            gap: 10px;
        }

        .nav-links {
            display: flex;
            gap: 30px;
            font-weight: 500;
        }

            .nav-links a {
                position: relative;
                padding-bottom: 6px;
                transition: color 0.25s ease;
            }

                .nav-links a::after {
                    content: "";
                    position: absolute;
                    left: 0;
                    bottom: 0;
                    width: 0;
                    height: 2.5px;
                    background-color: var(--secondary-color);
                    border-radius: 2px;
                    transition: width 0.25s ease;
                }

                .nav-links a:hover {
                    color: var(--secondary-color);
                }

                    .nav-links a:hover::after,
                    .nav-links a.active::after {
                        width: 100%;
                    }

                .nav-links a.active {
                    color: var(--secondary-color);
                    font-weight: 600;
                }

        .header-actions {
            display: flex;
            align-items: center;
            gap: 20px;
        }

        .search-bar {
            background: var(--bg-light);
            border-radius: 20px;
            padding: 8px 15px;
            display: flex;
            align-items: center;
        }

            .search-bar input {
                border: none;
                background: transparent;
                outline: none;
                padding-left: 10px;
                width: 200px;
            }

        .icon-btn {
            font-size: 20px;
            color: var(--text-dark);
            cursor: pointer;
            position: relative;
        }

        .cart-badge {
            position: absolute;
            top: -8px;
            right: -10px;
            background: var(--secondary-color);
            color: #fff;
            font-size: 11px;
            padding: 2px 6px;
            border-radius: 10px;
            font-weight: bold;
        }

        /* HERO BANNER & SLIDER */
        .hero-section {
            background-color: var(--bg-light);
            margin: 30px 50px;
            border-radius: 20px;
            display: flex;
            align-items: center;
            padding: 70px 80px;
            position: relative;
            overflow: hidden;
            min-height: 360px;
        }

        .hero-content {
            position: relative;
            z-index: 2;
            max-width: 550px;
        }

        .hero-badge {
            background: #e6f4f0;
            color: var(--secondary-color);
            padding: 5px 15px;
            border-radius: 20px;
            font-size: 14px;
            font-weight: 600;
            display: inline-block;
            margin-bottom: 20px;
        }

        .hero-content h1 {
            font-size: 48px;
            color: var(--primary-color);
            margin: 0 0 20px 0;
            line-height: 1.2;
        }

        .hero-content p {
            color: #333;
            font-size: 16px;
            margin-bottom: 30px;
            max-width: 440px;
            font-weight: 500;
        }

        .btn-primary {
            background-color: var(--secondary-color);
            color: #fff;
            padding: 12px 30px;
            border-radius: 25px;
            font-weight: 600;
            display: inline-block;
            transition: 0.3s;
            border: none;
            cursor: pointer;
        }

            .btn-primary:hover {
                background-color: var(--primary-color);
            }

        .hero-features {
            display: flex;
            gap: 20px;
            margin-top: 40px;
        }

        .feature-item {
            display: flex;
            align-items: center;
            gap: 10px;
            font-size: 13px;
            color: #333;
            font-weight: 500;
        }

        .hero-slider-container {
            position: absolute;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            z-index: 1;
            overflow: hidden;
        }

            .hero-slider-container::after {
                content: "";
                position: absolute;
                top: 0;
                left: 0;
                width: 100%;
                height: 100%;
                background: linear-gradient(90deg, rgba(248, 249, 250, 0.95) 0%, rgba(248, 249, 250, 0.75) 50%, rgba(248, 249, 250, 0.15) 100%);
                pointer-events: none;
            }

        .hero-slider {
            display: flex;
            width: 100%;
            height: 100%;
            transition: transform 0.6s ease-in-out;
        }

        .slide-item {
            min-width: 100%;
            height: 100%;
        }

            .slide-item img {
                width: 100%;
                height: 100%;
                object-fit: cover;
            }

        .slider-dots {
            position: absolute;
            bottom: 20px;
            left: 50%;
            transform: translateX(-50%);
            display: flex;
            gap: 8px;
            z-index: 3;
        }

        .dot {
            width: 10px;
            height: 10px;
            background: rgba(0, 0, 0, 0.25);
            border-radius: 50%;
            cursor: pointer;
            transition: 0.3s;
        }

            .dot.active {
                background: var(--primary-color);
                width: 25px;
                border-radius: 5px;
            }

        /* THANH CÔNG CỤ LỌC & SẮP XẾP */
        .section-container {
            margin: 40px 50px 60px 50px;
        }

        .toolbar {
            display: flex;
            justify-content: space-between;
            align-items: center;
            margin-bottom: 30px;
            flex-wrap: wrap;
            gap: 15px;
        }

        .toolbar-title h2 {
            margin: 0;
            font-size: 24px;
            color: var(--text-dark);
        }

        .toolbar-controls {
            display: flex;
            gap: 12px;
            align-items: center;
        }

        .filter-input, .filter-select {
            padding: 10px 16px;
            border: 1px solid #ddd;
            border-radius: 10px;
            font-family: inherit;
            font-size: 14px;
            outline: none;
            background: #fff;
        }

            .filter-input:focus, .filter-select:focus {
                border-color: var(--secondary-color);
            }

        /* LƯỚI SẢN PHẨM */
        .product-grid {
            display: grid;
            grid-template-columns: repeat(4, 1fr);
            gap: 25px;
        }

        .product-card {
            background: #fff;
            border: 1px solid #eaeaea;
            border-radius: var(--border-radius);
            padding: 20px;
            transition: 0.3s;
            position: relative;
        }

            .product-card:hover {
                box-shadow: 0 10px 25px rgba(0,0,0,0.08);
                transform: translateY(-5px);
            }

        .cate-badge {
            position: absolute;
            top: 15px;
            left: 15px;
            background: #e6f4f0;
            color: var(--primary-color);
            padding: 3px 10px;
            border-radius: 15px;
            font-size: 11px;
            font-weight: 600;
        }

        .wishlist-icon {
            position: absolute;
            top: 15px;
            right: 15px;
            color: #ccc;
            font-size: 18px;
            cursor: pointer;
        }

        .product-img {
            width: 100%;
            height: 200px;
            object-fit: contain;
            margin-bottom: 15px;
        }

        .product-title {
            font-size: 16px;
            font-weight: 600;
            margin: 0 0 10px 0;
            color: var(--text-dark);
            height: 40px;
            overflow: hidden;
        }

        .product-rating {
            color: #ffc107;
            font-size: 12px;
            margin-bottom: 10px;
        }

        .product-price {
            font-size: 20px;
            font-weight: 700;
            color: var(--text-dark);
            margin-bottom: 15px;
        }

        .btn-add-cart {
            display: block;
            width: 100%;
            box-sizing: border-box;
            text-align: center;
            background: var(--secondary-color);
            color: #fff;
            border: none;
            padding: 10px;
            border-radius: 8px;
            font-weight: 600;
            cursor: pointer;
            transition: 0.3s;
        }

            .btn-add-cart:hover {
                background: var(--primary-color);
            }

        /* PHÂN TRANG */
        .pagination-container {
            display: flex;
            justify-content: center;
            margin-top: 40px;
        }

        .pagination {
            display: flex;
            list-style: none;
            gap: 8px;
            padding: 0;
        }

            .pagination li a, .pagination li span {
                padding: 8px 14px;
                border: 1px solid #ddd;
                border-radius: 8px;
                color: var(--text-dark);
            }

            .pagination li.active a {
                background: var(--secondary-color);
                color: #fff;
                border-color: var(--secondary-color);
            }

        /* USER DROPDOWN */
        .user-dropdown {
            position: relative;
            display: inline-block;
        }

        .user-trigger {
            display: flex;
            align-items: center;
            gap: 8px;
            background-color: #e6f4f0;
            color: var(--primary-color);
            padding: 7px 14px;
            border-radius: 20px;
            font-size: 14px;
            font-weight: 600;
            cursor: pointer;
            transition: 0.3s;
            user-select: none;
        }

            .user-trigger:hover {
                background-color: var(--secondary-color);
                color: #fff;
            }

        .user-dropdown-menu {
            opacity: 0;
            visibility: hidden;
            transform: translateY(-6px);
            position: absolute;
            right: 0;
            top: calc(100% + 8px);
            background: #fff;
            box-shadow: 0 8px 20px rgba(0,0,0,0.12);
            border: 1px solid #eee;
            border-radius: 10px;
            min-width: 200px;
            z-index: 1000;
            transition: opacity 0.2s ease, transform 0.2s ease, visibility 0s linear 0.35s;
        }

            .user-dropdown-menu::before {
                content: "";
                position: absolute;
                top: -15px;
                left: 0;
                width: 100%;
                height: 18px;
                background: transparent;
            }

        .user-dropdown:hover .user-dropdown-menu,
        .user-dropdown.open .user-dropdown-menu {
            opacity: 1;
            visibility: visible;
            transform: translateY(0);
            transition: opacity 0.2s ease, transform 0.2s ease, visibility 0s linear 0s;
        }

        .user-dropdown-menu a {
            padding: 12px 20px;
            display: block;
            border-bottom: 1px solid #eee;
            font-size: 14px;
        }

            .user-dropdown-menu a:first-child {
                border-radius: 10px 10px 0 0;
            }

            .user-dropdown-menu a:last-child {
                border-bottom: none;
                border-radius: 0 0 10px 10px;
            }

            .user-dropdown-menu a:hover {
                background: #f9f9f9;
                color: var(--secondary-color);
            }

        /* FOOTER */
        .phone-footer {
            background-color: var(--primary-color);
            color: #fff;
            padding: 40px 50px;
            display: flex;
            justify-content: space-between;
            align-items: center;
        }

            .phone-footer h3 {
                margin: 0 0 8px 0;
                font-size: 22px;
            }

            .phone-footer p {
                margin: 0;
                color: #cce5de;
                font-size: 14px;
            }
    </style>
</head>
<body>

    <!-- HEADER -->
    <header class="header-top">
        <a href="@Url.Action("Index", "Home")" class="logo">
            <i class="fas fa-shopping-bag"></i> PHONE & ACCES
        </a>

        <nav class="nav-links">
            <a href="@Url.Action("Index", "Home")" class="@(currentAction == "Index" ? "active" : "")">Trang chủ</a>
            <a href="@Url.Action("PageDienThoai", "Home")" class="@(currentAction == "PageDienThoai" ? "active" : "")">Điện thoại</a>
            <a href="@Url.Action("PagePhuKien", "Home")" class="@(!isDongHo ? "active" : "")">Phụ kiện</a>
            <a href="@Url.Action("PageThietBi", "Home")" class="@(isDongHo ? "active" : "")">Đồng hồ</a>
            <a href="#footer">Hỗ trợ</a>
        </nav>

        <div class="header-actions">
            @using (Html.BeginForm(formAction, "Home", FormMethod.Get))
            {
                <div class="search-bar">
                    <i class="fas fa-search" style="color:#aaa;"></i>
                    @Html.TextBoxFor(m => m.SearchTerm, new { @placeholder = searchPlaceholder })
                    <button type="submit" style="display:none;"></button>
                </div>
            }

            @if (Session["Username"] != null)
            {
                <div class="user-dropdown">
                    <div class="user-trigger" onclick="this.parentElement.classList.toggle('open')">
                        <i class="fas fa-user-circle" style="font-size: 18px;"></i>
                        <span>@Session["Username"]</span>
                        <i class="fas fa-chevron-down" style="font-size: 11px;"></i>
                    </div>
                    <div class="user-dropdown-menu">
                        <a href="@Url.Action("ProfileInfo", "Account")">Thông tin tài khoản</a>
                        <a href="@Url.Action("MyOrder", "Order")">Đơn hàng của tôi</a>
                        <a href="@Url.Action("Logout", "Account")" style="color: #d9534f;">Đăng xuất</a>
                    </div>
                </div>
            }
            else
            {
                <a href="@Url.Action("Login", "Account")" class="icon-btn" title="Đăng nhập"><i class="fas fa-user"></i></a>
            }

            <a href="@Url.Action("Index", "Cart")" class="icon-btn">
                <i class="fas fa-shopping-cart"></i>
                <span class="cart-badge">@cartCount</span>
            </a>
        </div>
    </header>

    <!-- BANNER LƯỚT -->
    <section class="hero-section">
        <div class="hero-content">
            <span class="hero-badge">✦ Sản phẩm mới</span>
            @if (isDongHo)
            {
                <h1>Đồng hồ thông minh<br>nâng tầm phong cách</h1>
                <p>Nâng tầm giá trị của bạn. “Where ideas come to life” – Nơi những ý tưởng công nghệ hiện đại đồng hành trên cổ tay.</p>
            }
            else
            {
                <h1>Phụ kiện công nghệ<br>nâng tầm trải nghiệm</h1>
                <p>Sạc dự phòng, tai nghe, ốp lưng và phụ kiện chính hãng với chất lượng vượt trội và giá cả cạnh tranh.</p>
            }
            <a href="#productSection" class="btn-primary">Khám phá bộ sưu tập ></a>

            <div class="hero-features">
                <div class="feature-item">
                    <i class="fas fa-truck" style="font-size:18px; color:var(--primary-color);"></i>
                    <span>Giao hàng nhanh<br>trong 24/48h</span>
                </div>
                <div class="feature-item">
                    <i class="fas fa-shield-alt" style="font-size:18px; color:var(--primary-color);"></i>
                    <span>Thanh toán<br>bảo mật 100%</span>
                </div>
            </div>
        </div>

        <!-- KHUNG SLIDER ẢNH CHẠY DƯỚI NỀN -->
        <div class="hero-slider-container">
            <div class="hero-slider" id="heroSlider">
                @if (isDongHo)
                {
                    <div class="slide-item">
                        <img src="https://images.unsplash.com/photo-1579586337278-3befd40fd17a?auto=format&fit=crop&w=1200&q=80" alt="Banner Đồng hồ 1">
                    </div>
                    <div class="slide-item">
                        <img src="https://images.unsplash.com/photo-1523275335684-37898b6baf30?auto=format&fit=crop&w=1200&q=80" alt="Banner Đồng hồ 2">
                    </div>
                    <div class="slide-item">
                        <img src="https://images.unsplash.com/photo-1508685096489-7aacd43bd3b1?auto=format&fit=crop&w=1200&q=80" alt="Banner Đồng hồ 3">
                    </div>
                }
                else
                {
                    <div class="slide-item">
                        <img src="https://images.unsplash.com/photo-1505740420928-5e560c06d30e?auto=format&fit=crop&w=1200&q=80" alt="Banner Phụ kiện 1">
                    </div>
                    <div class="slide-item">
                        <img src="https://images.unsplash.com/photo-1590658268037-6bf12165a8df?auto=format&fit=crop&w=1200&q=80" alt="Banner Phụ kiện 2">
                    </div>
                    <div class="slide-item">
                        <img src="https://images.unsplash.com/photo-1583394838336-acd977736f90?auto=format&fit=crop&w=1200&q=80" alt="Banner Phụ kiện 3">
                    </div>
                }
            </div>

            <div class="slider-dots">
                <div class="dot active" onclick="goToSlide(0)"></div>
                <div class="dot" onclick="goToSlide(1)"></div>
                <div class="dot" onclick="goToSlide(2)"></div>
            </div>
        </div>
    </section>

    <!-- DANH SÁCH SẢN PHẨM TỪ DATABASE -->
    <main class="section-container" id="productSection">
        <div class="toolbar">
            <div class="toolbar-title">
                <h2>@listHeading</h2>
            </div>

            @using (Html.BeginForm(formAction, "Home", FormMethod.Get, new { @class = "toolbar-controls" }))
            {
                <input type="text"
                       name="searchTerm"
                       value="@Model.SearchTerm"
                       class="filter-input"
                       placeholder="@searchInputPlaceholder" />

                <select name="sortOrder" class="filter-select" onchange="this.form.submit()">
                    <option value="default" @(ViewBag.CurrentSort == "default" ? "selected" : "")>Sắp xếp mặc định</option>
                    <option value="asc" @(ViewBag.CurrentSort == "asc" ? "selected" : "")>Giá thấp đến cao</option>
                    <option value="desc" @(ViewBag.CurrentSort == "desc" ? "selected" : "")>Giá cao đến thấp</option>
                </select>
            }
        </div>

        @if (Model.NewProducts != null && Model.NewProducts.Any())
        {
            <div class="product-grid" id="productList">
                @foreach (var product in Model.NewProducts)
                {
                    <div class="product-card">
                        <span class="cate-badge">@product.Category.CategoryName</span>
                        <i class="far fa-heart wishlist-icon"></i>

                        <a href="@Url.Action("ProductDetails", "Home", new { id = product.ProductID })">
                            <img src="@product.ProductImage" alt="@product.ProductName" class="product-img" />
                        </a>

                        <h3 class="product-title">
                            <a href="@Url.Action("ProductDetails", "Home", new { id = product.ProductID })">
                                @product.ProductName
                            </a>
                        </h3>

                        <div class="product-rating">
                            ★★★★★ <span style="color:#aaa;">(Đã bán: @product.OrderDetails.Count)</span>
                        </div>

                        <div class="product-price">
                            @product.ProductPrice.ToString("#,##0").Replace(",", ".") đ
                        </div>

                        <a href="@Url.Action("AddToCart", "Cart", new { id = product.ProductID })" class="btn-add-cart">
                            <i class="fas fa-shopping-cart"></i> Thêm vào giỏ
                        </a>
                    </div>
                }
            </div>

            <div class="pagination-container">
                @Html.PagedListPager(Model.NewProducts, page => Url.Action(formAction, new
                {
                    page,
                    searchTerm = Model.SearchTerm,
                    sortOrder = ViewBag.CurrentSort
                }))
            </div>
        }
        else
        {
            <div style="text-align: center; padding: 60px 20px; background: var(--bg-light); border-radius: 15px;">
                <p style="color: var(--text-gray); font-size: 16px; margin: 0;">
                    Hiện chưa có sản phẩm nào thuộc danh mục <strong>@emptyCategoryName</strong>.
                </p>
            </div>
        }
    </main>

    <!-- FOOTER -->
    <footer class="phone-footer" id="footer">
        <div>
            <h3>PHONE & ACCES</h3>
            <p>Điện thoại và phụ kiện công nghệ chính hãng dành cho bạn.</p>
        </div>
        <p>© 2026 PHONE & ACCES. All rights reserved.</p>
    </footer>

    <!-- SCRIPT CHẠY SLIDER & ĐÓNG MENU TÀI KHOẢN -->
    <script>
        let currentSlide = 0;
        const slider = document.getElementById('heroSlider');
        const dots = document.querySelectorAll('.dot');
        const totalSlides = document.querySelectorAll('.slide-item').length;

        function goToSlide(index) {
            currentSlide = index;
            slider.style.transform = `translateX(-${currentSlide * 100}%)`;

            dots.forEach(dot => dot.classList.remove('active'));
            dots[currentSlide].classList.add('active');
        }

        setInterval(() => {
            let nextSlide = (currentSlide + 1) % totalSlides;
            goToSlide(nextSlide);
        }, 3000);

        document.addEventListener('click', function (e) {
            const dropdown = document.querySelector('.user-dropdown');
            if (dropdown && !dropdown.contains(e.target)) {
                dropdown.classList.remove('open');
            }
        });
    </script>

</body>
</html>