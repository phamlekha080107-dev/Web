@model _25DH110384_WebStore.Models.ViewModel.HomeProductVM
@using PagedList.Mvc;

@{
    Layout = null;
    var cart = Session["Cart"] as _25DH110384_WebStore.Models.ViewModel.Cart;
    int cartCount = (cart != null && cart.Items != null) ? cart.Items.Count() : 0;

    string currentAction = ViewContext.RouteData.Values["action"] != null
        ? ViewContext.RouteData.Values["action"].ToString()
        : "PageThietBi";
    bool isDongHo = currentAction.Equals("PageThietBi", StringComparison.OrdinalIgnoreCase);

    string formAction = isDongHo ? "PageThietBi" : "PagePhuKien";
    string pageTitle = isDongHo ? "Đồng hồ" : "Phụ kiện";
    string searchPlaceholder = isDongHo ? "Tìm đồng hồ..." : "Tìm phụ kiện...";
    string searchInputPlaceholder = isDongHo ? "Tìm tên đồng hồ..." : "Tìm tên phụ kiện...";
    string listHeading = isDongHo ? "DANH SÁCH ĐỒNG HỒ" : "DANH SÁCH PHỤ KIỆN";
    string emptyCategoryName = isDongHo ? "Đồng hồ" : "Phụ kiện";
    string promoHighlightText = isDongHo ? "Đồng hồ thông minh chính hãng" : "Phụ kiện công nghệ chính hãng";
    string heroEyebrow = isDongHo ? "Bộ sưu tập SmartWatch" : "Bộ sưu tập Phụ kiện";
}

<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@pageTitle - PHONE & ACCES</title>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800&display=swap" rel="stylesheet">

    <style>
        :root {
            --primary-color: #0b4d3c;
            --secondary-color: #1a8f6d;
            --dark-surface: #0d1714;
            --dark-card: #152420;
            --bg-light: #f4f6f8;
            --text-dark: #181c1b;
            --text-gray: #646e6b;
            --border-color: #e6eae8;
            --container-max: 1280px;
        }

        *, *::before, *::after {
            box-sizing: border-box;
        }

        html {
            scroll-behavior: smooth;
        }

        body {
            font-family: 'Inter', sans-serif;
            margin: 0;
            padding: 0;
            background-color: #ffffff;
            color: var(--text-dark);
            display: flex;
            flex-direction: column;
            min-height: 100vh;
            overflow-x: clip;
        }

        a {
            text-decoration: none;
            color: inherit;
        }

        .page-container {
            max-width: var(--container-max);
            margin: 0 auto;
            padding: 0 32px;
        }

        /* ================= 1. TOP ANNOUNCEMENT BAR ================= */
        .top-promo-bar {
            background-color: #0b1411;
            color: #d7e2de;
            font-size: 12px;
            padding: 8px 0;
            border-bottom: 1px solid rgba(255,255,255,0.08);
        }

            .top-promo-bar .page-container {
                display: flex;
                justify-content: space-between;
                align-items: center;
            }

        .promo-highlights {
            display: flex;
            align-items: center;
            gap: 14px;
        }

            .promo-highlights span.sep {
                color: #4b5c57;
            }

        .promo-meta {
            display: flex;
            align-items: center;
            gap: 16px;
            font-weight: 500;
        }

        /* ================= 2. MAIN HEADER ================= */
        .header-top {
            background-color: #ffffff;
            border-bottom: 1px solid #ecefef;
            position: sticky;
            top: 0;
            z-index: 1000;
        }

            .header-top .page-container {
                height: 70px;
                display: flex;
                align-items: center;
                justify-content: space-between;
                gap: 24px;
            }

        .logo {
            font-size: 22px;
            font-weight: 800;
            color: var(--primary-color);
            display: flex;
            align-items: center;
            gap: 9px;
            letter-spacing: -0.4px;
            white-space: nowrap;
        }

            .logo i {
                color: var(--secondary-color);
            }

        .nav-links {
            display: flex;
            align-items: center;
            gap: 28px;
            font-size: 14.5px;
            font-weight: 500;
            white-space: nowrap;
        }

            .nav-links a {
                position: relative;
                padding: 6px 0;
                color: #2d3533;
                transition: color 0.2s ease;
            }

                .nav-links a::after {
                    content: "";
                    position: absolute;
                    left: 0;
                    bottom: 0;
                    width: 0;
                    height: 2px;
                    background-color: var(--secondary-color);
                    border-radius: 2px;
                    transition: width 0.25s ease;
                }

                .nav-links a:hover,
                .nav-links a.active {
                    color: var(--secondary-color);
                    font-weight: 600;
                }

                    .nav-links a:hover::after,
                    .nav-links a.active::after {
                        width: 100%;
                    }

        .header-actions {
            display: flex;
            align-items: center;
            gap: 16px;
        }

            .header-actions form {
                margin: 0;
            }

        .search-bar {
            background: #f3f5f6;
            border: 1px solid transparent;
            border-radius: 999px;
            padding: 8px 16px;
            display: flex;
            align-items: center;
            width: 260px;
            transition: all 0.2s ease;
        }

            .search-bar:focus-within {
                background: #fff;
                border-color: var(--secondary-color);
                box-shadow: 0 0 0 3px rgba(26, 143, 109, 0.12);
            }

            .search-bar input {
                border: none;
                background: transparent;
                outline: none;
                padding-left: 10px;
                width: 100%;
                font-family: inherit;
                font-size: 13.5px;
                color: var(--text-dark);
            }

        .icon-btn {
            font-size: 19px;
            color: var(--text-dark);
            cursor: pointer;
            position: relative;
            width: 38px;
            height: 38px;
            border-radius: 50%;
            display: inline-flex;
            align-items: center;
            justify-content: center;
            transition: background 0.2s;
            flex-shrink: 0;
        }

            .icon-btn:hover {
                background: #f2f5f4;
                color: var(--primary-color);
            }

        .cart-badge {
            position: absolute;
            top: 0;
            right: -2px;
            background: var(--secondary-color);
            color: #fff;
            font-size: 10.5px;
            min-width: 18px;
            height: 18px;
            padding: 0 5px;
            border-radius: 999px;
            font-weight: 700;
            display: inline-flex;
            align-items: center;
            justify-content: center;
        }

        /* USER DROPDOWN */
        .user-dropdown {
            position: relative;
            display: inline-block;
        }

        .user-trigger {
            display: flex;
            align-items: center;
            gap: 8px;
            background-color: #e8f5f1;
            color: var(--primary-color);
            padding: 7px 14px;
            border-radius: 999px;
            font-size: 13.5px;
            font-weight: 600;
            cursor: pointer;
            transition: 0.25s;
            user-select: none;
            white-space: nowrap;
        }

            .user-trigger:hover {
                background-color: var(--secondary-color);
                color: #fff;
            }

        .user-dropdown-menu {
            opacity: 0;
            visibility: hidden;
            transform: translateY(-6px);
            position: absolute;
            right: 0;
            top: calc(100% + 8px);
            background: #fff;
            box-shadow: 0 10px 28px rgba(0,0,0,0.12);
            border: 1px solid #eaeaea;
            border-radius: 12px;
            min-width: 205px;
            z-index: 1000;
            transition: opacity 0.2s ease, transform 0.2s ease, visibility 0s linear 0.35s;
        }

            .user-dropdown-menu::before {
                content: "";
                position: absolute;
                top: -15px;
                left: 0;
                width: 100%;
                height: 18px;
                background: transparent;
            }

        .user-dropdown:hover .user-dropdown-menu,
        .user-dropdown.open .user-dropdown-menu {
            opacity: 1;
            visibility: visible;
            transform: translateY(0);
            transition: opacity 0.2s ease, transform 0.2s ease, visibility 0s linear 0s;
        }

        .user-dropdown-menu a {
            padding: 11px 18px;
            display: block;
            border-bottom: 1px solid #f1f3f2;
            font-size: 13.5px;
            font-weight: 500;
        }

            .user-dropdown-menu a:first-child {
                border-radius: 12px 12px 0 0;
            }

            .user-dropdown-menu a:last-child {
                border-bottom: none;
                border-radius: 0 0 12px 12px;
            }

            .user-dropdown-menu a:hover {
                background: #f5faf8;
                color: var(--secondary-color);
            }

        /* ================= 3. DARK TECH HERO BANNER ================= */
        .hero-wrapper {
            background: radial-gradient(circle at 75% 45%, #16382e 0%, #0b1613 55%, #070d0b 100%);
            color: #ffffff;
            position: relative;
            overflow: hidden;
        }

        .hero-section {
            max-width: var(--container-max);
            margin: 0 auto;
            padding: 68px 32px 76px 32px;
            display: grid;
            grid-template-columns: 1.05fr 0.95fr;
            align-items: center;
            gap: 40px;
            position: relative;
            z-index: 2;
        }

        .hero-content {
            min-width: 0;
        }

        .hero-eyebrow {
            font-size: 12px;
            font-weight: 700;
            letter-spacing: 1.8px;
            text-transform: uppercase;
            color: #5eead4;
            margin-bottom: 14px;
            display: block;
        }

        .hero-content h1 {
            font-size: 48px;
            font-weight: 800;
            color: #ffffff;
            margin: 0 0 18px 0;
            line-height: 1.15;
            letter-spacing: -0.8px;
        }

        .hero-content p {
            color: #b8c7c2;
            font-size: 15.5px;
            line-height: 1.6;
            margin: 0 0 28px 0;
            max-width: 460px;
        }

        .btn-hero-white {
            background-color: #ffffff;
            color: #0b1613;
            padding: 13px 28px;
            border-radius: 999px;
            font-size: 14px;
            font-weight: 700;
            display: inline-flex;
            align-items: center;
            gap: 10px;
            transition: all 0.25s ease;
            box-shadow: 0 6px 20px rgba(0,0,0,0.25);
        }

            .btn-hero-white:hover {
                background-color: #5eead4;
                color: #061410;
                transform: translateY(-2px);
            }

        .hero-trust-row {
            display: flex;
            align-items: center;
            flex-wrap: wrap;
            gap: 28px;
            margin-top: 42px;
            padding-top: 24px;
            border-top: 1px solid rgba(255,255,255,0.1);
        }

        .hero-trust-item {
            display: flex;
            align-items: center;
            gap: 10px;
            font-size: 12.5px;
            color: #d0ddd9;
            line-height: 1.35;
        }

            .hero-trust-item .trust-circle {
                width: 34px;
                height: 34px;
                border-radius: 50%;
                border: 1px solid rgba(94, 234, 212, 0.35);
                background: rgba(255,255,255,0.04);
                color: #5eead4;
                display: inline-flex;
                align-items: center;
                justify-content: center;
                font-size: 14px;
                flex-shrink: 0;
            }

        .hero-visual-box {
            position: relative;
            min-width: 0;
            border-radius: 20px;
            overflow: hidden;
            height: 360px;
            box-shadow: 0 20px 50px rgba(0,0,0,0.45);
            border: 1px solid rgba(255,255,255,0.1);
        }

        .hero-tagline-watermark {
            position: absolute;
            top: 18px;
            right: 22px;
            z-index: 3;
            text-align: right;
            font-size: 16px;
            font-weight: 600;
            font-style: italic;
            color: rgba(255,255,255,0.75);
            line-height: 1.25;
            pointer-events: none;
            text-shadow: 0 2px 10px rgba(0,0,0,0.6);
        }

        .hero-slider {
            display: flex;
            width: 100%;
            height: 100%;
            transition: transform 0.6s ease-in-out;
        }

        .slide-item {
            min-width: 100%;
            height: 100%;
        }

            .slide-item img {
                width: 100%;
                height: 100%;
                object-fit: cover;
            }

        .slider-dots {
            position: absolute;
            bottom: 18px;
            left: 50%;
            transform: translateX(-50%);
            display: flex;
            gap: 8px;
            z-index: 4;
        }

        .dot {
            width: 8px;
            height: 8px;
            background: rgba(255, 255, 255, 0.35);
            border-radius: 50%;
            cursor: pointer;
            transition: 0.3s;
        }

            .dot.active {
                background: #ffffff;
                width: 24px;
                border-radius: 6px;
            }

        /* ================= 4. SECTION HEADER, FILTER & PRODUCT GRID ================= */
        .section-container {
            max-width: var(--container-max);
            margin: 54px auto;
            padding: 0 32px;
        }

        .breadcrumb-bar {
            display: flex;
            align-items: center;
            gap: 8px;
            font-size: 13px;
            color: var(--text-gray);
            margin-bottom: 16px;
        }

            .breadcrumb-bar a:hover {
                color: var(--secondary-color);
            }

            .breadcrumb-bar span.current {
                color: var(--primary-color);
                font-weight: 600;
            }

        .section-header {
            display: flex;
            justify-content: space-between;
            align-items: flex-end;
            margin-bottom: 24px;
            flex-wrap: wrap;
            gap: 16px;
        }

        .section-subtitle {
            color: var(--secondary-color);
            text-transform: uppercase;
            font-size: 11.5px;
            font-weight: 700;
            letter-spacing: 1.2px;
            display: block;
            margin-bottom: 4px;
        }

        .section-title h2 {
            font-size: 24px;
            font-weight: 700;
            color: var(--text-dark);
            margin: 0;
            letter-spacing: -0.3px;
        }

        .toolbar-controls {
            display: flex;
            gap: 12px;
            align-items: center;
            flex-wrap: wrap;
        }

        .filter-search-box {
            position: relative;
            display: flex;
            align-items: center;
        }

            .filter-search-box i {
                position: absolute;
                left: 14px;
                color: #8b9693;
                font-size: 13px;
                pointer-events: none;
            }

        .filter-input {
            height: 40px;
            padding: 0 16px 0 36px;
            border: 1px solid #e2e6e5;
            border-radius: 999px;
            font-family: inherit;
            font-size: 13.5px;
            outline: none;
            background: #f3f5f6;
            width: 240px;
            transition: all 0.2s ease;
        }

            .filter-input:focus {
                background: #ffffff;
                border-color: var(--secondary-color);
                box-shadow: 0 0 0 3px rgba(26, 143, 109, 0.12);
            }

        .filter-select {
            height: 40px;
            padding: 0 16px;
            border: 1px solid #e2e6e5;
            border-radius: 999px;
            font-family: inherit;
            font-size: 13.5px;
            font-weight: 500;
            color: var(--text-dark);
            outline: none;
            background: #ffffff;
            cursor: pointer;
            transition: border-color 0.2s ease;
        }

            .filter-select:focus {
                border-color: var(--secondary-color);
            }

        /* LƯỚI SẢN PHẨM */
        .product-grid {
            display: grid;
            grid-template-columns: repeat(4, 1fr);
            gap: 20px;
        }

        .product-card {
            background: #ffffff;
            border: 1px solid #e9eded;
            border-radius: 14px;
            padding: 18px;
            transition: all 0.25s ease;
            position: relative;
            display: flex;
            flex-direction: column;
            min-width: 0;
        }

            .product-card:hover {
                box-shadow: 0 12px 28px rgba(11, 77, 60, 0.08);
                border-color: #cce5de;
                transform: translateY(-4px);
            }

        .cate-badge {
            position: absolute;
            top: 14px;
            left: 14px;
            background: #e8f5f1;
            color: var(--primary-color);
            padding: 3px 10px;
            border-radius: 999px;
            font-size: 11px;
            font-weight: 700;
            z-index: 2;
        }

        .wishlist-icon {
            position: absolute;
            top: 14px;
            right: 14px;
            color: #b8c2bf;
            font-size: 16px;
            cursor: pointer;
            transition: color 0.2s;
            z-index: 2;
        }

            .wishlist-icon:hover {
                color: #e11d48;
            }

        .product-img {
            width: 100%;
            height: 175px;
            object-fit: contain;
            margin: 10px 0 14px 0;
            transition: transform 0.25s ease;
        }

        .product-card:hover .product-img {
            transform: scale(1.03);
        }

        .product-title {
            font-size: 14.5px;
            font-weight: 600;
            margin: 0 0 8px 0;
            color: var(--text-dark);
            line-height: 1.4;
            height: 40px;
            overflow: hidden;
            display: -webkit-box;
            -webkit-line-clamp: 2;
            -webkit-box-orient: vertical;
        }

            .product-title a:hover {
                color: var(--secondary-color);
            }

        .product-rating {
            color: #f59e0b;
            font-size: 12px;
            margin-bottom: 8px;
        }

        .product-price {
            font-size: 17px;
            font-weight: 800;
            color: var(--primary-color);
            margin-bottom: 14px;
        }

        .btn-add-cart {
            display: flex;
            align-items: center;
            justify-content: center;
            gap: 8px;
            width: 100%;
            background: #141f1c;
            color: #ffffff;
            border: none;
            padding: 10px 14px;
            border-radius: 999px;
            font-family: inherit;
            font-size: 13px;
            font-weight: 600;
            cursor: pointer;
            transition: background 0.25s ease;
            margin-top: auto;
        }

            .btn-add-cart:hover {
                background: var(--secondary-color);
            }

        /* PHÂN TRANG */
        .pagination-container {
            display: flex;
            justify-content: center;
            margin-top: 34px;
        }

        .pagination {
            display: flex;
            list-style: none;
            gap: 8px;
            padding: 0;
            margin: 0;
            align-items: center;
        }

            .pagination li a,
            .pagination li span {
                display: inline-flex;
                align-items: center;
                justify-content: center;
                min-width: 36px;
                height: 36px;
                padding: 0 12px;
                border: 1px solid #e2e6e5;
                border-radius: 8px;
                background-color: #ffffff;
                color: var(--text-dark);
                font-size: 13.5px;
                font-weight: 500;
                transition: all 0.2s ease;
            }

                .pagination li a:hover {
                    background-color: #e8f5f1;
                    border-color: var(--secondary-color);
                    color: var(--primary-color);
                }

            .pagination li.active a,
            .pagination li.active span {
                background-color: var(--secondary-color);
                border-color: var(--secondary-color);
                color: #ffffff;
                font-weight: 600;
            }

            .pagination li.disabled a,
            .pagination li.disabled span {
                color: #bbb;
                background-color: #f8f9fa;
                border-color: #eee;
                pointer-events: none;
            }

        /* ================= 5. SERVICE STRIP ================= */
        .service-strip {
            border-top: 1px solid #ecefef;
            background: #fafcfb;
            padding: 32px 0;
            margin-top: auto;
        }

        .service-grid {
            max-width: var(--container-max);
            margin: 0 auto;
            padding: 0 32px;
            display: grid;
            grid-template-columns: repeat(4, 1fr);
            gap: 24px;
        }

        .service-box {
            display: flex;
            align-items: center;
            gap: 14px;
        }

            .service-box .srv-icon {
                width: 44px;
                height: 44px;
                border-radius: 12px;
                background: #e8f5f1;
                color: var(--secondary-color);
                display: inline-flex;
                align-items: center;
                justify-content: center;
                font-size: 18px;
                flex-shrink: 0;
            }

            .service-box h4 {
                margin: 0 0 3px 0;
                font-size: 14.5px;
                font-weight: 700;
                color: var(--text-dark);
            }

            .service-box p {
                margin: 0;
                font-size: 12.5px;
                color: var(--text-gray);
            }

        /* ================= 6. MULTI-COLUMN DARK FOOTER ================= */
        .voltix-footer {
            background-color: #0b1411;
            color: #b7c4c0;
            padding-top: 52px;
        }

        .footer-grid {
            max-width: var(--container-max);
            margin: 0 auto;
            padding: 0 32px 40px 32px;
            display: grid;
            grid-template-columns: 1.4fr 1fr 1fr 1fr 1.2fr;
            gap: 32px;
        }

        .footer-brand .logo {
            color: #ffffff;
            margin-bottom: 14px;
        }

        .footer-brand p {
            font-size: 13px;
            line-height: 1.6;
            color: #93a39e;
            margin: 0 0 20px 0;
        }

        .social-links {
            display: flex;
            gap: 10px;
        }

            .social-links a {
                width: 34px;
                height: 34px;
                border-radius: 50%;
                background: rgba(255,255,255,0.08);
                color: #ffffff;
                display: inline-flex;
                align-items: center;
                justify-content: center;
                font-size: 13.5px;
                transition: background 0.2s;
            }

                .social-links a:hover {
                    background: var(--secondary-color);
                }

        .footer-col h4 {
            color: #ffffff;
            font-size: 14px;
            font-weight: 700;
            margin: 0 0 16px 0;
        }

        .footer-col ul {
            list-style: none;
            padding: 0;
            margin: 0;
            display: flex;
            flex-direction: column;
            gap: 10px;
            font-size: 13px;
        }

            .footer-col ul a:hover {
                color: #5eead4;
            }

        .app-badges {
            display: flex;
            flex-direction: column;
            gap: 10px;
            margin-top: 14px;
        }

        .app-badge-btn {
            display: inline-flex;
            align-items: center;
            gap: 10px;
            background: rgba(255,255,255,0.07);
            border: 1px solid rgba(255,255,255,0.14);
            color: #ffffff;
            padding: 8px 14px;
            border-radius: 10px;
            font-size: 12px;
            transition: background 0.2s;
        }

            .app-badge-btn:hover {
                background: rgba(255,255,255,0.14);
            }

            .app-badge-btn i {
                font-size: 18px;
            }

        .footer-bottom {
            border-top: 1px solid rgba(255,255,255,0.08);
            padding: 18px 0;
            font-size: 12.5px;
            color: #7f908b;
        }

            .footer-bottom .page-container {
                display: flex;
                justify-content: space-between;
                align-items: center;
            }

        .footer-legal {
            display: flex;
            gap: 18px;
        }

            .footer-legal a:hover {
                color: #ffffff;
            }

        /* ================= RESPONSIVE ================= */
        @@media (max-width: 1180px) {
            .nav-links {
                gap: 20px;
            }

            .search-bar {
                width: 210px;
            }
        }

        @@media (max-width: 1100px) {
            .product-grid {
                grid-template-columns: repeat(2, 1fr);
            }

            .footer-grid {
                grid-template-columns: repeat(2, 1fr);
            }
        }

        @@media (max-width: 900px) {
            .top-promo-bar,
            .nav-links,
            .search-bar {
                display: none;
            }

            .hero-section {
                grid-template-columns: 1fr;
                padding: 44px 20px;
            }

            .hero-content h1 {
                font-size: 34px;
            }

            .service-grid {
                grid-template-columns: 1fr;
            }

            .filter-input {
                width: 100%;
            }
        }
    </style>
</head>
<body>

    <!-- 1. TOP ANNOUNCEMENT BAR -->
    <div class="top-promo-bar">
        <div class="page-container">
            <div class="promo-highlights">
                <span>Miễn phí vận chuyển cho đơn từ 500.000đ</span>
                <span class="sep">|</span>
                <span>Đổi trả dễ dàng 30 ngày</span>
                <span class="sep">|</span>
                <span>Công nghệ chính hãng 100%</span>
            </div>
            <div class="promo-meta">
                <span>VND</span>
                <span style="color:#4b5c57;">|</span>
                <span>Tiếng Việt</span>
            </div>
        </div>
    </div>

    <!-- 2. MAIN HEADER -->
    <header class="header-top">
        <div class="page-container">
            <a href="@Url.Action("Index", "Home")" class="logo">
                <i class="fas fa-shopping-bag"></i> PHONE & ACCES
            </a>

            <nav class="nav-links">
                <a href="@Url.Action("Index", "Home")" class="@(currentAction == "Index" ? "active" : "")">Trang chủ</a>
                <a href="@Url.Action("PageDienThoai", "Home")" class="@(currentAction == "PageDienThoai" ? "active" : "")">Điện thoại</a>
                <a href="@Url.Action("PagePhuKien", "Home")" class="@(currentAction == "PagePhuKien" ? "active" : "")">Phụ kiện</a>
                <a href="@Url.Action("PageThietBi", "Home")" class="@(currentAction == "PageThietBi" ? "active" : "")">Đồng hồ</a>
                <a href="#footer">Hỗ trợ</a>
            </nav>

            <div class="header-actions">
                @using (Html.BeginForm("PagePhuKien", "Home", FormMethod.Get))
                {
                    <div class="search-bar">
                        <i class="fas fa-search" style="color:#8b9693; font-size:13px;"></i>
                        @Html.TextBoxFor(m => m.SearchTerm, new { @placeholder = "Tìm sản phẩm..." })
                        <button type="submit" style="display:none;"></button>
                    </div>
                }

                @if (Session["Username"] != null)
                {
                    <div class="user-dropdown">
                        <div class="user-trigger" onclick="this.parentElement.classList.toggle('open')">
                            <i class="fas fa-user-circle" style="font-size: 17px;"></i>
                            <span>@Session["Username"]</span>
                            <i class="fas fa-chevron-down" style="font-size: 10px;"></i>
                        </div>
                        <div class="user-dropdown-menu">
                            <a href="@Url.Action("ProfileInfo", "Account")">Thông tin tài khoản</a>
                            <a href="@Url.Action("MyOrder", "Order")">Đơn hàng của tôi</a>
                            <a href="@Url.Action("Logout", "Account")" style="color: #d9534f;">Đăng xuất</a>
                        </div>
                    </div>
                }
                else
                {
                    <a href="@Url.Action("Login", "Account")" class="icon-btn" title="Đăng nhập">
                        <i class="far fa-user"></i>
                    </a>
                }

                <a href="@Url.Action("Index", "Cart")" class="icon-btn" title="Giỏ hàng">
                    <i class="fas fa-shopping-cart"></i>
                    <span class="cart-badge">@cartCount</span>
                </a>
            </div>
        </div>
    </header>

    <!-- 3. DARK TECH HERO BANNER -->
    <div class="hero-wrapper">
        <section class="hero-section">
            <div class="hero-content">
                <span class="hero-eyebrow">Công nghệ thế hệ mới</span>
                <h1>Thiết bị thông minh<br>Trải nghiệm đỉnh cao</h1>
                <p>Khám phá những dòng điện thoại thông minh, đồng hồ và phụ kiện công nghệ mới nhất với chất lượng chính hãng và mức giá cạnh tranh.</p>
                <a href="#featured" class="btn-hero-white">
                    Khám phá ngay <i class="fas fa-arrow-right"></i>
                </a>

                <div class="hero-trust-row">
                    <div class="hero-trust-item">
                        <span class="trust-circle"><i class="fas fa-bolt"></i></span>
                        <span>Công nghệ<br>tiên tiến</span>
                    </div>
                    <div class="hero-trust-item">
                        <span class="trust-circle"><i class="fas fa-check-circle"></i></span>
                        <span>Chất lượng<br>chính hãng</span>
                    </div>
                    <div class="hero-trust-item">
                        <span class="trust-circle"><i class="fas fa-shipping-fast"></i></span>
                        <span>Giao hàng<br>siêu tốc</span>
                    </div>
                </div>
            </div>

            <div class="hero-visual-box">
                <div class="hero-tagline-watermark">Tech<br>Without<br>Limits</div>
                <div class="hero-slider" id="heroSlider">
                    <div class="slide-item">
                        <img src="https://images.unsplash.com/photo-1610945265064-0e34e5519bbf?auto=format&fit=crop&w=1200&q=80" alt="Banner 1">
                    </div>
                    <div class="slide-item">
                        <img src="https://images.unsplash.com/photo-1542204165-65bf26472b9b?auto=format&fit=crop&w=1200&q=80" alt="Banner 2">
                    </div>
                    <div class="slide-item">
                        <img src="https://images.unsplash.com/photo-1505156868547-9b49f4df4e04?auto=format&fit=crop&w=1200&q=80" alt="Banner 3">
                    </div>
                </div>

                <div class="slider-dots">
                    <div class="dot active" onclick="goToSlide(0)"></div>
                    <div class="dot" onclick="goToSlide(1)"></div>
                    <div class="dot" onclick="goToSlide(2)"></div>
                </div>
            </div>
        </section>
    </div>

    <!-- 4. DANH SÁCH SẢN PHẨM TỪ DATABASE -->
    <main class="section-container" id="productSection">
        <div class="breadcrumb-bar">
            <a href="@Url.Action("Index", "Home")"><i class="fas fa-home"></i> Trang chủ</a>
            <span>/</span>
            <span class="current">@pageTitle</span>
        </div>

        <div class="section-header">
            <div class="section-title">
                <span class="section-subtitle">Danh mục sản phẩm</span>
                <h2>@listHeading</h2>
            </div>

            @using (Html.BeginForm(formAction, "Home", FormMethod.Get, new { @class = "toolbar-controls" }))
            {
                <div class="filter-search-box">
                    <i class="fas fa-search"></i>
                    <input type="text"
                           name="searchTerm"
                           value="@Model.SearchTerm"
                           class="filter-input"
                           placeholder="@searchInputPlaceholder" />
                </div>

                <select name="sortOrder" class="filter-select" onchange="this.form.submit()">
                    <option value="default" @(ViewBag.CurrentSort == "default" ? "selected" : "")>Sắp xếp mặc định</option>
                    <option value="asc" @(ViewBag.CurrentSort == "asc" ? "selected" : "")>Giá thấp đến cao</option>
                    <option value="desc" @(ViewBag.CurrentSort == "desc" ? "selected" : "")>Giá cao đến thấp</option>
                </select>
            }
        </div>

        @if (Model.NewProducts != null && Model.NewProducts.Any())
        {
            <div class="product-grid" id="productList">
                @foreach (var product in Model.NewProducts)
                {
                    <div class="product-card">
                        <span class="cate-badge">@(product.Category != null ? product.Category.CategoryName : emptyCategoryName)</span>
                        <i class="far fa-heart wishlist-icon"></i>

                        <a href="@Url.Action("ProductDetails", "Home", new { id = product.ProductID })">
                            <img src="@product.ProductImage" alt="@product.ProductName" class="product-img" />
                        </a>

                        <h3 class="product-title">
                            <a href="@Url.Action("ProductDetails", "Home", new { id = product.ProductID })">
                                @product.ProductName
                            </a>
                        </h3>

                        <div class="product-rating">
                            ★★★★★ <span style="color:#8b9693;">(Đã bán: @(product.OrderDetails != null ? product.OrderDetails.Count : 0))</span>
                        </div>

                        <div class="product-price">
                            @product.ProductPrice.ToString("#,##0").Replace(",", ".") đ
                        </div>

                        <a href="@Url.Action("AddToCart", "Cart", new { id = product.ProductID })" class="btn-add-cart">
                            <i class="fas fa-shopping-cart"></i> Thêm vào giỏ
                        </a>
                    </div>
                }
            </div>

            <div class="pagination-container">
                @Html.PagedListPager(Model.NewProducts, page => Url.Action(formAction, new
                {
                    page,
                    searchTerm = Model.SearchTerm,
                    sortOrder = ViewBag.CurrentSort
                }))
            </div>
        }
        else
        {
            <div style="text-align: center; padding: 64px 20px; background: #f6f8f7; border: 1px solid #e7ecea; border-radius: 16px;">
                <i class="fas @(isDongHo ? "fa-clock" : "fa-headphones-alt")" style="font-size: 36px; color: #9aa6a2; margin-bottom: 12px;"></i>
                <p style="color: var(--text-gray); font-size: 15.5px; margin: 0;">
                    Hiện chưa có sản phẩm nào thuộc danh mục <strong>@emptyCategoryName</strong>.
                </p>
            </div>
        }
    </main>

    <!-- 5. SERVICE STRIP -->
    <div class="service-strip">
        <div class="service-grid">
            <div class="service-box">
                <span class="srv-icon"><i class="fas fa-truck"></i></span>
                <div>
                    <h4>Miễn phí vận chuyển</h4>
                    <p>Cho đơn hàng từ 500.000đ</p>
                </div>
            </div>

            <div class="service-box">
                <span class="srv-icon"><i class="fas fa-undo-alt"></i></span>
                <div>
                    <h4>Đổi trả 30 ngày</h4>
                    <p>Bảo hành 1 đổi 1 dễ dàng</p>
                </div>
            </div>

            <div class="service-box">
                <span class="srv-icon"><i class="fas fa-headset"></i></span>
                <div>
                    <h4>Hỗ trợ 24/7</h4>
                    <p>Tư vấn kỹ thuật tận tâm</p>
                </div>
            </div>

            <div class="service-box">
                <span class="srv-icon"><i class="fas fa-shield-alt"></i></span>
                <div>
                    <h4>Thanh toán bảo mật</h4>
                    <p>Hỗ trợ PayPal & COD an toàn</p>
                </div>
            </div>
        </div>
    </div>

    <!-- 6. MULTI-COLUMN DARK FOOTER -->
    <footer class="voltix-footer" id="footer">
        <div class="footer-grid">
            <div class="footer-brand">
                <a href="@Url.Action("Index", "Home")" class="logo">
                    <i class="fas fa-shopping-bag"></i> PHONE & ACCES
                </a>
                <p>Hệ thống bán lẻ điện thoại thông minh, đồng hồ và phụ kiện công nghệ chính hãng hàng đầu dành cho bạn.</p>
                <div class="social-links">
                    <a href="#"><i class="fab fa-facebook-f"></i></a>
                    <a href="#"><i class="fab fa-instagram"></i></a>
                    <a href="#"><i class="fab fa-youtube"></i></a>
                    <a href="#"><i class="fab fa-tiktok"></i></a>
                </div>
            </div>

            <div class="footer-col">
                <h4>Danh mục</h4>
                <ul>
                    <li><a href="@Url.Action("PageDienThoai", "Home")">Điện thoại</a></li>
                    <li><a href="@Url.Action("PagePhuKien", "Home")">Phụ kiện</a></li>
                    <li><a href="@Url.Action("PageThietBi", "Home")">Đồng hồ thông minh</a></li>
                    <li><a href="@Url.Action("Index", "Home")#featured">Sản phẩm nổi bật</a></li>
                </ul>
            </div>

            <div class="footer-col">
                <h4>Về chúng tôi</h4>
                <ul>
                    <li><a href="#footer">Giới thiệu cửa hàng</a></li>
                    <li><a href="#footer">Chính sách bảo hành</a></li>
                    <li><a href="#footer">Tin tức công nghệ</a></li>
                    <li><a href="#footer">Hệ thống chi nhánh</a></li>
                </ul>
            </div>

            <div class="footer-col">
                <h4>Hỗ trợ khách hàng</h4>
                <ul>
                    <li><a href="@Url.Action("MyOrder", "Order")">Tra cứu đơn hàng</a></li>
                    <li><a href="@Url.Action("ProfileInfo", "Account")">Tài khoản của tôi</a></li>
                    <li><a href="#footer">Hướng dẫn thanh toán PayPal</a></li>
                    <li><a href="#footer">Chính sách đổi trả</a></li>
                </ul>
            </div>

            <div class="footer-col">
                <h4>Tải ứng dụng</h4>
                <p style="font-size:12.5px; color:#93a39e; margin:0;">Trải nghiệm mua sắm tiện lợi hơn trên điện thoại.</p>
                <div class="app-badges">
                    <a href="#footer" class="app-badge-btn">
                        <i class="fab fa-apple"></i>
                        <span>Tải về trên <strong>App Store</strong></span>
                    </a>
                    <a href="#footer" class="app-badge-btn">
                        <i class="fab fa-google-play"></i>
                        <span>Tải về trên <strong>Google Play</strong></span>
                    </a>
                </div>
            </div>
        </div>

        <div class="footer-bottom">
            <div class="page-container">
                <span>© 2026 PHONE & ACCES. All rights reserved.</span>
                <div class="footer-legal">
                    <a href="#footer">Chính sách bảo mật</a>
                    <a href="#footer">Điều khoản dịch vụ</a>
                    <a href="#footer">Sơ đồ trang</a>
                </div>
            </div>
        </div>
    </footer>

    <!-- SCRIPT CHẠY SLIDER & ĐÓNG MENU TÀI KHOẢN -->
    <script>
        let currentSlide = 0;
        const slider = document.getElementById('heroSlider');
        const dots = document.querySelectorAll('.dot');
        const totalSlides = document.querySelectorAll('.slide-item').length;

        function goToSlide(index) {
            currentSlide = index;
            slider.style.transform = `translateX(-${currentSlide * 100}%)`;

            dots.forEach(dot => dot.classList.remove('active'));
            dots[currentSlide].classList.add('active');
        }

        setInterval(() => {
            let nextSlide = (currentSlide + 1) % totalSlides;
            goToSlide(nextSlide);
        }, 3500);

        document.addEventListener('click', function (e) {
            const dropdown = document.querySelector('.user-dropdown');
            if (dropdown && !dropdown.contains(e.target)) {
                dropdown.classList.remove('open');
            }
        });
    </script>

</body>
</html>