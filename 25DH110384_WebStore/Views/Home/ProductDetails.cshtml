@model _25DH110384_WebStore.Models.ViewModel.ProductDetailVM

@{
    Layout = null;
    var cart = Session["Cart"] as _25DH110384_WebStore.Models.ViewModel.Cart;
    int cartCount = (cart != null && cart.Items != null) ? cart.Items.Count() : 0;
    int initQty = Model.quantity > 0 ? Model.quantity : 1;
}

<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@Model.product.ProductName - PHONE & ACCES</title>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet">

    <style>
        :root {
            --primary-color: #0b4d3c;
            --primary-hover: #083b2e;
            --secondary-color: #1a8f6d;
            --accent-soft: #e6f4f0;
            --accent-border: #cce7df;
            --bg-page: #f4f6f8;
            --bg-light: #f8f9fa;
            --text-dark: #1f2937;
            --text-gray: #6b7280;
            --danger-color: #d93025;
            --border-color: #e5e7eb;
            --border-radius: 16px;
            --shadow-sm: 0 2px 8px rgba(0, 0, 0, 0.04);
            --shadow-md: 0 8px 24px rgba(11, 77, 60, 0.07);
        }

        *, *::before, *::after {
            box-sizing: border-box;
        }

        html {
            scroll-behavior: smooth;
        }

        body {
            font-family: 'Inter', sans-serif;
            margin: 0;
            padding: 0;
            background-color: var(--bg-page);
            color: var(--text-dark);
            display: flex;
            flex-direction: column;
            min-height: 100vh;
            -webkit-font-smoothing: antialiased;
        }

        a {
            text-decoration: none;
            color: inherit;
        }

        /* HEADER */
        .header-top {
            position: sticky;
            top: 0;
            z-index: 999;
            background-color: rgba(255, 255, 255, 0.96);
            backdrop-filter: blur(8px);
            padding: 14px 50px;
            display: flex;
            align-items: center;
            justify-content: space-between;
            border-bottom: 1px solid var(--border-color);
            box-shadow: var(--shadow-sm);
        }

        .logo {
            font-size: 22px;
            font-weight: 800;
            color: var(--primary-color);
            display: flex;
            align-items: center;
            gap: 10px;
            letter-spacing: -0.3px;
        }

            .logo i {
                color: var(--secondary-color);
                font-size: 24px;
            }

        .nav-links {
            display: flex;
            gap: 28px;
            font-weight: 500;
            font-size: 15px;
        }

            .nav-links a {
                position: relative;
                padding: 6px 0;
                color: var(--text-dark);
                transition: color 0.25s ease;
            }

                .nav-links a::after {
                    content: "";
                    position: absolute;
                    left: 0;
                    bottom: 0;
                    width: 0;
                    height: 2.5px;
                    background-color: var(--secondary-color);
                    border-radius: 2px;
                    transition: width 0.25s ease;
                }

                .nav-links a:hover {
                    color: var(--secondary-color);
                }

                    .nav-links a:hover::after {
                        width: 100%;
                    }

        .header-actions {
            display: flex;
            align-items: center;
            gap: 18px;
        }

        .search-bar {
            background: var(--bg-light);
            border: 1px solid var(--border-color);
            border-radius: 999px;
            padding: 8px 16px;
            display: flex;
            align-items: center;
            transition: border-color 0.2s, box-shadow 0.2s, background 0.2s;
        }

            .search-bar:focus-within {
                background: #fff;
                border-color: var(--secondary-color);
                box-shadow: 0 0 0 3px rgba(26, 143, 109, 0.12);
            }

            .search-bar input {
                border: none;
                background: transparent;
                outline: none;
                padding-left: 10px;
                width: 200px;
                font-family: inherit;
                font-size: 14px;
                color: var(--text-dark);
            }

        .icon-btn {
            width: 40px;
            height: 40px;
            border-radius: 50%;
            background: var(--bg-light);
            display: inline-flex;
            align-items: center;
            justify-content: center;
            font-size: 18px;
            color: var(--text-dark);
            cursor: pointer;
            position: relative;
            transition: all 0.2s ease;
        }

            .icon-btn:hover {
                background: var(--accent-soft);
                color: var(--primary-color);
            }

        .cart-badge {
            position: absolute;
            top: -4px;
            right: -4px;
            background: var(--danger-color);
            color: #fff;
            font-size: 11px;
            min-width: 19px;
            height: 19px;
            padding: 0 5px;
            border-radius: 999px;
            font-weight: 700;
            display: flex;
            align-items: center;
            justify-content: center;
            border: 2px solid #fff;
        }

        /* USER DROPDOWN */
        .user-dropdown {
            position: relative;
            display: inline-block;
        }

        .user-trigger {
            display: flex;
            align-items: center;
            gap: 8px;
            background-color: var(--accent-soft);
            color: var(--primary-color);
            border: 1px solid var(--accent-border);
            padding: 7px 14px;
            border-radius: 999px;
            font-size: 14px;
            font-weight: 600;
            cursor: pointer;
            transition: all 0.25s ease;
            user-select: none;
        }

            .user-trigger:hover {
                background-color: var(--secondary-color);
                border-color: var(--secondary-color);
                color: #fff;
            }

        .user-dropdown-menu {
            opacity: 0;
            visibility: hidden;
            transform: translateY(-6px);
            position: absolute;
            right: 0;
            top: calc(100% + 10px);
            background: #fff;
            box-shadow: 0 10px 28px rgba(0, 0, 0, 0.12);
            border: 1px solid var(--border-color);
            border-radius: 12px;
            min-width: 210px;
            overflow: hidden;
            z-index: 1000;
            transition: opacity 0.2s ease, transform 0.2s ease, visibility 0s linear 0.3s;
        }

            .user-dropdown-menu::before {
                content: "";
                position: absolute;
                top: -15px;
                left: 0;
                width: 100%;
                height: 18px;
                background: transparent;
            }

        .user-dropdown:hover .user-dropdown-menu,
        .user-dropdown.open .user-dropdown-menu {
            opacity: 1;
            visibility: visible;
            transform: translateY(0);
            transition: opacity 0.2s ease, transform 0.2s ease, visibility 0s linear 0s;
        }

        .user-dropdown-menu a {
            padding: 12px 18px;
            display: block;
            border-bottom: 1px solid #f3f4f6;
            font-size: 14px;
            font-weight: 500;
            transition: background 0.15s, color 0.15s;
        }

            .user-dropdown-menu a:last-child {
                border-bottom: none;
            }

            .user-dropdown-menu a:hover {
                background: #f2faf7;
                color: var(--secondary-color);
            }

        /* BREADCRUMB */
        .breadcrumb-bar {
            max-width: 1280px;
            width: 100%;
            margin: 20px auto 0 auto;
            padding: 0 30px;
            font-size: 13.5px;
            color: var(--text-gray);
            display: flex;
            align-items: center;
            flex-wrap: wrap;
            gap: 8px;
        }

            .breadcrumb-bar a {
                display: inline-flex;
                align-items: center;
                gap: 6px;
                transition: color 0.2s;
            }

                .breadcrumb-bar a:hover {
                    color: var(--secondary-color);
                }

            .breadcrumb-bar span.current {
                color: var(--primary-color);
                font-weight: 600;
            }

        /* BỐ CỤC CHI TIẾT SẢN PHẨM */
        .detail-wrapper {
            max-width: 1280px;
            width: 100%;
            margin: 18px auto 60px auto;
            padding: 0 30px;
            display: grid;
            grid-template-columns: minmax(0, 1fr) 330px;
            gap: 24px;
            align-items: start;
            flex: 1;
        }

        .card-box {
            background: #fff;
            border-radius: var(--border-radius);
            border: 1px solid var(--border-color);
            padding: 28px;
            box-shadow: var(--shadow-sm);
            margin-bottom: 24px;
        }

            .card-box:last-child {
                margin-bottom: 0;
            }

        /* KHỐI ẢNH & THÔNG TIN CHÍNH */
        .product-main-grid {
            display: grid;
            grid-template-columns: 370px minmax(0, 1fr);
            gap: 36px;
            align-items: start;
        }

        .product-image-box {
            background: radial-gradient(circle at center, #ffffff 0%, #f4f7f6 100%);
            border-radius: 14px;
            padding: 28px;
            display: flex;
            align-items: center;
            justify-content: center;
            min-height: 360px;
            border: 1px solid #edf1ef;
            overflow: hidden;
        }

            .product-image-box img {
                max-width: 100%;
                max-height: 310px;
                object-fit: contain;
                transition: transform 0.35s cubic-bezier(0.22, 1, 0.36, 1);
                filter: drop-shadow(0 8px 16px rgba(0, 0, 0, 0.06));
            }

            .product-image-box:hover img {
                transform: scale(1.06);
            }

        .cate-pill {
            display: inline-flex;
            align-items: center;
            gap: 6px;
            background: var(--accent-soft);
            color: var(--primary-color);
            border: 1px solid var(--accent-border);
            font-size: 12.5px;
            font-weight: 600;
            padding: 5px 13px;
            border-radius: 999px;
            margin-bottom: 14px;
        }

        .detail-title {
            font-size: 26px;
            font-weight: 700;
            color: #111827;
            margin: 0 0 12px 0;
            line-height: 1.35;
            letter-spacing: -0.3px;
        }

        .detail-meta {
            display: flex;
            align-items: center;
            flex-wrap: wrap;
            gap: 14px;
            font-size: 13.5px;
            color: var(--text-gray);
            margin-bottom: 20px;
        }

            .detail-meta .stars {
                color: #f59e0b;
                letter-spacing: 1px;
                font-size: 15px;
            }

        .detail-price-box {
            background: linear-gradient(135deg, #f3faf7 0%, #eaf6f2 100%);
            border: 1px solid var(--accent-border);
            border-left: 4px solid var(--secondary-color);
            border-radius: 12px;
            padding: 18px 22px;
            margin-bottom: 24px;
        }

        .detail-price {
            font-size: 30px;
            font-weight: 800;
            color: var(--danger-color);
            margin: 0;
            letter-spacing: -0.5px;
        }

        /* BỘ CHỌN SỐ LƯỢNG & TẠM TÍNH */
        .purchase-box {
            border-top: 1px solid #f0f2f4;
            padding-top: 22px;
        }

        .qty-row {
            display: flex;
            align-items: center;
            gap: 16px;
            margin-bottom: 18px;
        }

        .qty-label {
            font-size: 14px;
            font-weight: 600;
            color: var(--text-dark);
            min-width: 85px;
        }

        .qty-control {
            display: inline-flex;
            align-items: center;
            border: 1px solid #d1d5db;
            border-radius: 10px;
            overflow: hidden;
            background: #fff;
            box-shadow: 0 1px 2px rgba(0, 0, 0, 0.03);
        }

            .qty-control button {
                width: 38px;
                height: 38px;
                border: none;
                background: #f9fafb;
                color: var(--text-dark);
                font-size: 17px;
                font-weight: 600;
                cursor: pointer;
                transition: background 0.2s, color 0.2s;
            }

                .qty-control button:hover {
                    background: var(--accent-soft);
                    color: var(--primary-color);
                }

                .qty-control button:active {
                    background: var(--accent-border);
                }

            .qty-control input {
                width: 56px;
                height: 38px;
                border: none;
                border-left: 1px solid #e5e7eb;
                border-right: 1px solid #e5e7eb;
                text-align: center;
                font-family: inherit;
                font-size: 15px;
                font-weight: 700;
                color: var(--text-dark);
                outline: none;
                -moz-appearance: textfield;
            }

                .qty-control input::-webkit-outer-spin-button,
                .qty-control input::-webkit-inner-spin-button {
                    -webkit-appearance: none;
                    margin: 0;
                }

        .subtotal-row {
            display: flex;
            align-items: baseline;
            gap: 16px;
            margin-bottom: 24px;
        }

        .subtotal-value {
            font-size: 23px;
            font-weight: 800;
            color: var(--primary-color);
        }

        .action-buttons {
            display: flex;
            gap: 14px;
        }

        .btn-cart-main {
            flex: 1;
            display: inline-flex;
            align-items: center;
            justify-content: center;
            gap: 10px;
            background: linear-gradient(135deg, var(--secondary-color) 0%, var(--primary-color) 100%);
            color: #fff;
            padding: 15px 26px;
            border-radius: 12px;
            font-size: 15.5px;
            font-weight: 700;
            letter-spacing: 0.2px;
            transition: transform 0.2s ease, box-shadow 0.2s ease, filter 0.2s ease;
            box-shadow: 0 6px 18px rgba(11, 77, 60, 0.24);
        }

            .btn-cart-main:hover {
                transform: translateY(-2px);
                box-shadow: 0 10px 24px rgba(11, 77, 60, 0.32);
                filter: brightness(1.05);
            }

            .btn-cart-main:active {
                transform: translateY(0);
            }

        /* CHÍNH SÁCH BẢO HÀNH */
        .policy-list {
            display: grid;
            grid-template-columns: repeat(2, 1fr);
            gap: 10px;
            margin-top: 24px;
            padding-top: 20px;
            border-top: 1px dashed #e5e7eb;
        }

            .policy-list div {
                display: flex;
                align-items: center;
                gap: 9px;
                background: #f8fbfa;
                border: 1px solid #e6f0ec;
                border-radius: 9px;
                padding: 9px 12px;
                font-size: 13px;
                font-weight: 500;
                color: #374151;
            }

            .policy-list i {
                color: var(--secondary-color);
                font-size: 14px;
                width: 16px;
                text-align: center;
            }

        /* MÔ TẢ SẢN PHẨM */
        .section-heading {
            font-size: 18px;
            font-weight: 700;
            color: var(--primary-color);
            margin: 0 0 16px 0;
            padding-bottom: 12px;
            border-bottom: 2px solid var(--accent-soft);
            display: flex;
            align-items: center;
            gap: 8px;
        }

        .product-desc-text {
            font-size: 15px;
            line-height: 1.75;
            color: #374151;
            white-space: pre-line;
            margin: 0;
        }

        /* SẢN PHẨM LIÊN QUAN & SIDEBAR */
        .related-wrapper h3,
        .related-wrapper h4,
        aside h3,
        aside h4 {
            color: var(--primary-color);
            margin-top: 0;
        }

        .related-wrapper .list-container {
            display: grid;
            grid-template-columns: repeat(3, minmax(0, 1fr));
            gap: 16px;
            list-style: none;
            padding: 0;
            margin: 16px 0 0 0;
        }

        .related-wrapper .lproduct-item {
            border: 1px solid var(--border-color);
            border-radius: 12px;
            padding: 16px;
            text-align: center;
            transition: all 0.25s ease;
            background: #fff;
            display: flex;
            flex-direction: column;
            justify-content: space-between;
        }

            .related-wrapper .lproduct-item:hover {
                border-color: var(--secondary-color);
                box-shadow: var(--shadow-md);
                transform: translateY(-4px);
            }

            .related-wrapper .lproduct-item img {
                width: 100%;
                height: 140px;
                object-fit: contain;
                margin-bottom: 12px;
                transition: transform 0.25s ease;
            }

            .related-wrapper .lproduct-item:hover img {
                transform: scale(1.04);
            }

            .related-wrapper .lproduct-item h5 {
                font-size: 14px;
                font-weight: 600;
                line-height: 1.4;
                margin: 0 0 8px 0;
                color: var(--text-dark);
                display: -webkit-box;
                -webkit-line-clamp: 2;
                -webkit-box-orient: vertical;
                overflow: hidden;
            }

                .related-wrapper .lproduct-item h5 a:hover {
                    color: var(--secondary-color);
                }

            .related-wrapper .lproduct-item .prodSale {
                font-weight: 700;
                color: var(--danger-color);
                margin: 0;
                font-size: 15px;
            }

        /* CỘT PHẢI (PVTopProduct) */
        aside {
            position: sticky;
            top: 88px;
        }

            aside .list-container {
                list-style: none;
                padding: 0;
                margin: 14px 0 0 0;
                display: flex;
                flex-direction: column;
                gap: 14px;
            }

            aside .lproduct-item {
                background: #fff;
                border: 1px solid var(--border-color);
                border-radius: 12px;
                padding: 14px;
                text-align: center;
                transition: all 0.25s ease;
            }

                aside .lproduct-item:hover {
                    border-color: var(--secondary-color);
                    box-shadow: var(--shadow-md);
                    transform: translateY(-2px);
                }

                aside .lproduct-item img {
                    width: 100%;
                    height: 115px;
                    object-fit: contain;
                    margin-bottom: 8px;
                }

                aside .lproduct-item h5 {
                    font-size: 14px;
                    font-weight: 600;
                    margin: 0 0 6px 0;
                    color: var(--text-dark);
                }

                aside .lproduct-item .prodSale {
                    font-weight: 700;
                    color: var(--danger-color);
                    margin: 0;
                    font-size: 14.5px;
                }

        /* FOOTER */
        .phone-footer {
            background-color: var(--primary-color);
            color: #fff;
            padding: 40px 50px;
            display: flex;
            justify-content: space-between;
            align-items: center;
            margin-top: auto;
        }

            .phone-footer h3 {
                margin: 0 0 8px 0;
                font-size: 22px;
                font-weight: 800;
            }

            .phone-footer p {
                margin: 0;
                color: #cce5de;
                font-size: 14px;
            }

        /* RESPONSIVE */
        @@media (max-width: 1024px) {
            .detail-wrapper {
                grid-template-columns: 1fr;
            }

            aside {
                position: static;
            }

            .product-main-grid {
                grid-template-columns: 300px minmax(0, 1fr);
                gap: 24px;
            }
        }

        @@media (max-width: 768px) {
            .header-top {
                padding: 14px 20px;
            }

            .nav-links,
            .search-bar {
                display: none;
            }

            .breadcrumb-bar,
            .detail-wrapper {
                padding: 0 16px;
            }

            .card-box {
                padding: 20px;
            }

            .product-main-grid {
                grid-template-columns: 1fr;
            }

            .product-image-box {
                min-height: 250px;
            }

            .detail-title {
                font-size: 22px;
            }

            .policy-list {
                grid-template-columns: 1fr;
            }

            .related-wrapper .list-container {
                grid-template-columns: repeat(2, minmax(0, 1fr));
            }

            .phone-footer {
                flex-direction: column;
                text-align: center;
                gap: 12px;
                padding: 30px 20px;
            }
        }
    </style>
</head>
<body>

    <!-- HEADER -->
    <header class="header-top">
        <a href="@Url.Action("Index", "Home")" class="logo">
            <i class="fas fa-shopping-bag"></i> PHONE & ACCES
        </a>

        <nav class="nav-links">
            <a href="@Url.Action("Index", "Home")">Trang chủ</a>
            <a href="@Url.Action("PageDienThoai", "Home")">Điện thoại</a>
            <a href="@Url.Action("PagePhuKien", "Home")">Phụ kiện</a>
            <a href="@Url.Action("PageThietBi", "Home")">Đồng hồ</a>
            <a href="#footer">Hỗ trợ</a>
        </nav>

        <div class="header-actions">
            @using (Html.BeginForm("Index", "Home", FormMethod.Get))
            {
                <div class="search-bar">
                    <i class="fas fa-search" style="color:#9ca3af;"></i>
                    <input type="text" name="searchTerm" placeholder="Tìm sản phẩm..." />
                    <button type="submit" style="display:none;"></button>
                </div>
            }

            @if (Session["Username"] != null)
            {
                <div class="user-dropdown">
                    <div class="user-trigger" onclick="this.parentElement.classList.toggle('open')">
                        <i class="fas fa-user-circle" style="font-size: 18px;"></i>
                        <span>@Session["Username"]</span>
                        <i class="fas fa-chevron-down" style="font-size: 11px;"></i>
                    </div>
                    <div class="user-dropdown-menu">
                        <a href="@Url.Action("ProfileInfo", "Account")">Thông tin tài khoản</a>
                        <a href="@Url.Action("MyOrder", "Order")">Đơn hàng của tôi</a>
                        <a href="@Url.Action("Logout", "Account")" style="color: #d9534f;">Đăng xuất</a>
                    </div>
                </div>
            }
            else
            {
                <a href="@Url.Action("Login", "Account")" class="icon-btn" title="Đăng nhập"><i class="fas fa-user"></i></a>
            }

            <a href="@Url.Action("Index", "Cart")" class="icon-btn" title="Giỏ hàng">
                <i class="fas fa-shopping-cart"></i>
                <span class="cart-badge">@cartCount</span>
            </a>
        </div>
    </header>

    <!-- BREADCRUMB -->
    <div class="breadcrumb-bar">
        <a href="@Url.Action("Index", "Home")"><i class="fas fa-home"></i> Trang chủ</a>
        <span>/</span>
        <span>@Model.product.Category.CategoryName</span>
        <span>/</span>
        <span class="current">@Model.product.ProductName</span>
    </div>

    <!-- NỘI DUNG CHI TIẾT -->
    <div class="detail-wrapper">
        <!-- CỘT TRÁI (THÔNG TIN SẢN PHẨM + MÔ TẢ + SẢN PHẨM TƯƠNG TỰ) -->
        <div>
            <div class="card-box">
                <div class="product-main-grid">
                    <!-- Ảnh sản phẩm -->
                    <div class="product-image-box">
                        <img src="@Model.product.ProductImage" alt="@Model.product.ProductName" />
                    </div>

                    <!-- Thông tin & Mua hàng -->
                    <div>
                        <span class="cate-pill">
                            <i class="fas fa-tag"></i> Danh mục: @Model.product.Category.CategoryName
                        </span>

                        <h1 class="detail-title">@Model.product.ProductName</h1>

                        <div class="detail-meta">
                            <span class="stars">★★★★★</span>
                            <span>|</span>
                            <span>Đã bán: <strong>@Model.product.OrderDetails.Count</strong></span>
                            <span>|</span>
                            <span style="color: var(--secondary-color); font-weight: 600;">
                                <i class="fas fa-check-circle"></i> Còn hàng
                            </span>
                        </div>

                        <div class="detail-price-box">
                            <p class="detail-price" id="unitPrice" data-price="@Model.product.ProductPrice">
                                @Model.product.ProductPrice.ToString("#,##0").Replace(",", ".") đ
                            </p>
                        </div>

                        <div class="purchase-box">
                            <div class="qty-row">
                                <span class="qty-label">Số lượng:</span>
                                <div class="qty-control">
                                    <button type="button" onclick="changeQty(-1)">−</button>
                                    <input type="number" id="qtyInput" value="@initQty" min="1" onchange="updateSubtotal()" oninput="updateSubtotal()" />
                                    <button type="button" onclick="changeQty(1)">+</button>
                                </div>
                            </div>

                            <div class="subtotal-row">
                                <span class="qty-label">Tạm tính:</span>
                                <span class="subtotal-value" id="subtotalDisplay">
                                    @((Model.product.ProductPrice * initQty).ToString("#,##0").Replace(",", ".")) đ
                                </span>
                            </div>

                            <div class="action-buttons">
                                <a id="btnAddToCart"
                                   href="@Url.Action("AddToCart", "Cart", new { id = Model.product.ProductID, quantity = initQty })"
                                   class="btn-cart-main">
                                    <i class="fas fa-shopping-cart"></i> Thêm vào giỏ hàng
                                </a>
                            </div>

                            <div class="policy-list">
                                <div><i class="fas fa-shield-alt"></i> Bảo hành chính hãng 12 tháng</div>
                                <div><i class="fas fa-truck"></i> Giao hàng nhanh 24/48h</div>
                                <div><i class="fas fa-sync-alt"></i> Đổi trả miễn phí trong 7 ngày</div>
                                <div><i class="fas fa-headset"></i> Hỗ trợ kỹ thuật trọn đời</div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <!-- MÔ TẢ SẢN PHẨM -->
            <div class="card-box">
                <h3 class="section-heading"><i class="fas fa-align-left"></i> Mô tả sản phẩm</h3>
                <p class="product-desc-text">
                    @(string.IsNullOrWhiteSpace(Model.product.ProductDescription)
                        ? "Đang cập nhật thông tin mô tả chi tiết cho sản phẩm này."
                        : Model.product.ProductDescription)
                </p>
            </div>

            <!-- SẢN PHẨM LIÊN QUAN -->
            <div class="card-box related-wrapper">
                @Html.Partial("PVRelatedProduct", Model)
            </div>
        </div>

        <!-- CỘT PHẢI (SẢN PHẨM BÁN CHẠY) -->
        <aside>
            @Html.Partial("PVTopProduct", Model)
        </aside>
    </div>

    <!-- FOOTER -->
    <footer class="phone-footer" id="footer">
        <div>
            <h3>PHONE & ACCES</h3>
            <p>Điện thoại và phụ kiện công nghệ chính hãng dành cho bạn.</p>
        </div>
        <p>© 2026 PHONE & ACCES. All rights reserved.</p>
    </footer>

    <script>
        const unitPrice = parseFloat(document.getElementById('unitPrice').getAttribute('data-price')) || 0;
        const baseCartUrl = '@Url.Action("AddToCart", "Cart", new { id = Model.product.ProductID })';

        function formatVND(number) {
            return Math.round(number).toString().replace(/\B(?=(\d{3})+(?!\d))/g, ".") + " đ";
        }

        function changeQty(delta) {
            const input = document.getElementById('qtyInput');
            let current = parseInt(input.value) || 1;
            let next = current + delta;
            if (next < 1) next = 1;
            input.value = next;
            updateSubtotal();
        }

        function updateSubtotal() {
            const input = document.getElementById('qtyInput');
            let qty = parseInt(input.value);
            if (isNaN(qty) || qty < 1) {
                qty = 1;
                input.value = 1;
            }

            document.getElementById('subtotalDisplay').innerText = formatVND(unitPrice * qty);

            const separator = baseCartUrl.includes('?') ? '&' : '?';
            document.getElementById('btnAddToCart').href = `${baseCartUrl}${separator}quantity=${qty}`;
        }

        document.addEventListener('click', function (e) {
            const dropdown = document.querySelector('.user-dropdown');
            if (dropdown && !dropdown.contains(e.target)) {
                dropdown.classList.remove('open');
            }
        });
    </script>
</body>
</html>