@model _25DH110384_WebStore.Models.ViewModel.LoginVM

@{
    ViewBag.Title = "Đăng nhập - PHONE&ACCES";
    Layout = null;
}

<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>PHONE & ACCES</title>

    <link rel="stylesheet" href="~/Areas/Customer/Content/Login.css" />
</head>

<body>
    <div class="top-note">
        MIỄN PHÍ VẬN CHUYỂN CHO ĐƠN HÀNG TỪ 500.000Đ
    </div>

    <header class="header">
        <a class="logo"
           href="@Url.Action("Index", "Home")">
            PHONE&ACCES
        </a>

        <div class="header-right">
            <a href="#">♡ Yêu thích</a>
            <a href="@Url.Action("Index", "Cart")">🛒 Giỏ hàng</a>
        </div>
    </header>

    <nav class="navbar">
        <a href="@Url.Action("Index", "Home")">TRANG CHỦ</a>
        <a href="@Url.Action("PageDienThoai", "Home")">ĐIỆN THOẠI</a>
        <a href="#">PHỤ KIỆN</a>
        <a href="#">THIẾT BỊ ĐEO THÔNG MINH</a>
        <a href="#">THÔNG TIN HỖ TRỢ</a>
    </nav>

    <main class="login-page">
        <div class="login-box">
            <h1>Đăng nhập</h1>

            <p class="login-description">
                Chào mừng bạn trở lại PHONE&ACCES
            </p>

            <div class="login-container">
                @using (Html.BeginForm("Login", "Home", FormMethod.Post, new { @class = "form-horizontal", role = "form" }))

                {
                    @Html.AntiForgeryToken()
                    @Html.ValidationSummary(true, "", new { @class = "text-danger" })

                    <h2 class="login-title">ĐĂNG NHẬP HỆ THỐNG</h2>

                    @* Tên đăng nhập *@
                    <div class="form-group row">
                        @Html.LabelFor(m => m.Username, new { @class = "control-label col-md-3 font-weight-bold" })
                        <div class="col-md-9">
                            @Html.TextBoxFor(m => m.Username, new { @class = "form-control", placeholder = "Nhập tên đăng nhập..." })
                            @Html.ValidationMessageFor(m => m.Username, "", new { @class = "text-danger" })
                        </div>
                    </div>

                    <br />

                    @* Mật khẩu *@
                    <div class="form-group row">
                        @Html.LabelFor(m => m.Password, new { @class = "control-label col-md-3 font-weight-bold" })
                        <div class="col-md-9">
                            @Html.PasswordFor(m => m.Password, new { @class = "form-control", placeholder = "Nhập mật khẩu..." })
                            @Html.ValidationMessageFor(m => m.Password, "", new { @class = "text-danger" })
                        </div>
                    </div>

                    <br />

                    <div class="form-group">
                        <div class="col-md-offset-3 col-md-9">
                            <input type="submit" value="Đăng nhập" class="btn accountbtn" />
                            <div class="register-link">
                                <p>Bạn chưa có tài khoản? <a href="@Url.Action("Register", "Account", null)">Đăng ký ngay</a></p>
                            </div>
                        </div>
                    </div>
                }
            </div>
        </div>
    </main>

    <footer class="phone-footer">
        <div class="footer-logo">PHONE&ACCES</div>
        <p>Điện thoại và phụ kiện chính hãng</p>
    </footer>
</body>
</html>