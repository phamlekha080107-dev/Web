@model IEnumerable<_25DH110384_WebStore.Models.Category>
<link rel="stylesheet" href="~/Areas/Customer/Content/Index.css" />

@{
    Layout = null;
    
}


<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>PHONE & ACCES</title>
    <link rel="stylesheet" href="~/Areas/Customer/Content/style.css">

   
</head>
<body>
    <div class="top-note">MIỄN PHÍ VẬN CHUYỂN CHO ĐƠN HÀNG TỪ 500.000Đ</div>

    <header class="header">
        <a class="logo" href="#">PHONE & ACCES</a>
        <div class="header-right">
            <span>♡ Yêu thích</span>
            <a href="#cart">🛒 Giỏ hàng <b id="cart-count">0</b></a>
            <a href="@Url.Action("Login", "Categories1", new { area = "Customer" })">
                Đăng nhập
            </a>
        </div>
    </header>

    <nav class="navbar">
        <a href="#">TRANG CHỦ</a>
        <a href="@Url.Action("PageDienThoai", "Categories1", new { area = "Customer" })">ĐIỆN THOẠI</a>
        <a href="#products">PHỤ KIỆN</a>
        <a href="#featured">THIẾT BỊ ĐEO THÔNG MINH</a>
        <a href="#footer">THÔNG TIN HỖ TRỢ</a>
    </nav>

    <section class="hero">
        <div class="hero-copy">
            <p class="eyebrow">SẢN PHẨM MỚI</p>
            <h1>SMART PHONE</h1>
            <span class="small-line"></span>
            <p>Thiết kế nổi bật, hiện đại cho mỗi ngày.</p>
            <a class="btn" href="#products">KHÁM PHÁ NGAY&nbsp; →</a>
        </div>
    </section>

    <main class="container">
        <section class="categories" id="categories">
            <a class="category category-one" href="#products"><span>ĐIỆN THOẠI</span></a>
            <a class="category category-two" href="#products"><span>PHỤ KIỆN</span></a>
            <a class="category category-three" href="#products"><span>THIẾT BỊ ĐEO THÔNG MINH</span></a>
        </section>

        <section id="featured" class="section">
            <div class="section-heading"><span></span><h2>SẢN PHẨM NỔI BẬT</h2><span></span></div>
            <div class="products">
                <article class="product">
                    <div class="product-image"><img src="data:image/webp;base64," alt="Iphone 18 Promax"><label>SALE</label></div>
                    <h3>IPhone 18 Promax</h3><p class="price"><del>42.450.000đ</del>  <strong>39.329.000đ</strong></p>
                    <button onclick="addToCart()">Thêm vào giỏ</button>
                </article>
                <article class="product">
                    <div class="product-image"><img src="https://encrypted-tbn0.gstatic.com/images?q=tbn:ANd9GcSTFAEZcPeoYPhP1AbswUqOWpP_NwuhMo2Ny5wvEqf9Bg&s=10" alt="Samsung S25"><label>MỚI</label></div>
                    <h3>Samsung S25</h3><p class="price"><strong>37.100.000đ</strong></p>
                    <button onclick="addToCart()">Thêm vào giỏ</button>
                </article>
                <article class="product">
                    <div class="product-image"><img src="https://encrypted-tbn0.gstatic.com/images?q=tbn:ANd9GcQngvhZs9flaU2NLxB-3uefWVlNXqBWmkh2BDQ8WROmFw&s" alt="Xiaomi Redmi Note 14"><label>SALE</label></div>
                    <h3>Xiaomi Redmi Note 14</h3><p class="price"><del>10.990.000đ</del>  <strong>9.830.000đ</strong></p>
                    <button onclick="addToCart()">Thêm vào giỏ</button>
                </article>
                <article class="product">
                    <div class="product-image"><img src="data:image/webp;base64," alt="Tai nghe GOOJODOQ J201"></div>
                    <h3>Tai nghe GOOJODOQ J201</h3><p class="price"><strong>190.000đ</strong></p>
                    <button onclick="addToCart()">Thêm vào giỏ</button>
                </article>
            </div>
        </section>

        <section id="products" class="section">
            <div class="section-heading"><span></span><h2>SẢN PHẨM KHÁC</h2><span></span></div>
            <div class="tools">
                <p>Những sản phẩm mới nhất</p>
                <input id="search-input" type="search" placeholder="Tìm sản phẩm..." oninput="searchProducts()">
            </div>
            <div class="products" id="product-list">
                <article class="product">
                    <div class="product-image"><img src="https://encrypted-tbn0.gstatic.com/images?q=tbn:ANd9GcTZyd4_8OBNxEbzMYoM3rx3Rrylcr0pAIduxIahR3U1xA&s=10" alt=""><label>SALE</label></div>
                    <h3>Đế sạc điện thoại</h3><p class="price"><strong>299.000đ</strong></p><button onclick="addToCart()">Thêm vào giỏ</button>
                </article>
                <article class="product">
                    <div class="product-image"><img src="https://encrypted-tbn0.gstatic.com/images?q=tbn:ANd9GcQmkf5iJ5KuLD9wwbIIyoRduOMj7-NSSaUipGKVSj6DZA&s" alt=""></div>
                    <h3>Sạc dự phòng Apple</h3><p class="price"><strong>1.420.000đ</strong></p><button onclick="addToCart()">Thêm vào giỏ</button>
                </article>
                <article class="product">
                    <div class="product-image"><img src="https://encrypted-tbn0.gstatic.com/images?q=tbn:ANd9GcQo85fnKMS-vgPUJLSRiQaBBqFgOWwRQgLg3COn_dPa2Q&s=10" alt=""></div>
                    <h3>Ốp lưng IPhone 17 Promax</h3><p class="price"><strong>650.000đ</strong></p><button onclick="addToCart()">Thêm vào giỏ</button>
                </article>
                <article class="product">
                    <div class="product-image"><img src="https://encrypted-tbn0.gstatic.com/images?q=tbn:ANd9GcRQnW5jNogikOSOd7ZXSB6W3si-cruPn0V3ZwHPJl-V_g&s=10" alt=""></div>
                    <h3>Tai nghe</h3><p class="price"><strong>790.000đ</strong></p><button onclick="addToCart()">Thêm vào giỏ</button>
                </article>
            </div>
            <p id="no-result" class="no-result" hidden>Không tìm thấy sản phẩm phù hợp.</p>
        </section>
    </main>

    <footer id="footer">
        <div class="footer-logo">PHONE & ACCES</div>
        <p>Thế giới công nghệ tiện ích</p>
        <p>© 2026 PHONE & ACCES</p>
    </footer>
    <script src="script.js"></script>
</body>
</html>
