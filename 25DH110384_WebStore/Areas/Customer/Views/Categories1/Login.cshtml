
@{
    ViewBag.Title = "Đăng nhập - PHONE&ACCES";
    Layout = null;
}

<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>PHONE & ACCES</title>

    <link rel="stylesheet" href="~/Areas/Customer/Content/Login.css" />

  
</head>

<body>
    <div class="top-note">
        MIỄN PHÍ VẬN CHUYỂN CHO ĐƠN HÀNG TỪ 500.000Đ
    </div>

    <header class="header">
        <a class="logo"
           href="@Url.Action("PageHome", "Categories1",new { area = "Customer" })">
            PHONE&ACCES
        </a>

        <div class="header-right">
            <a href="#">♡ Yêu thích</a>
            <a href="#">🛒 Giỏ hàng</a>
        </div>
    </header>

    <nav class="navbar">
        <a href="@Url.Action("PageHome", "Categories1", new { area = "Customer" })">TRANG CHỦ</a>
        <a href="@Url.Action("PageDienThoai", "Categories1", new { area = "Customer" })">ĐIỆN THOẠI</a>
        <a href="#">PHỤ KIỆN</a>
        <a href="#">THIẾT BỊ ĐEO THÔNG MINH</a>
        <a href="#">THÔNG TIN HỖ TRỢ</a>
    </nav>

    <main class="login-page">
        <div class="login-box">
            <h1>Đăng nhập</h1>

            <p class="login-description">
                Chào mừng bạn trở lại PHONE&ACCES
            </p>

            @using (Html.BeginForm("Login", "Account",
                new { area = "Customer" }, FormMethod.Post))
            {
                @Html.AntiForgeryToken()

                if (ViewBag.Error != null)
                {
                    <div class="login-error">
                        @ViewBag.Error
                    </div>
                }

                <div class="login-field">
                    <label for="username">Tên đăng nhập hoặc email</label>
                    <input type="text"
                           id="username"
                           name="username"
                           placeholder="Nhập tên đăng nhập hoặc email"
                           required />
                </div>

                <div class="login-field">
                    <label for="password">Mật khẩu</label>
                    <input type="password"
                           id="password"
                           name="password"
                           placeholder="Nhập mật khẩu"
                           required />
                </div>

                <div type="submit" class="login-submit">
                    <a href="@Url.Action("PageHome", "Categories1", new { area = "Customer" })">Đăng Nhập</a>
                </div>
            }

            <div class="login-links">
                Chưa có tài khoản?
                <a href="@Url.Action("#", "Category1",new { area = "Customer" })">
                    Đăng ký ngay
                </a>
            </div>
        </div>
    </main>

    <footer class="phone-footer">
        <div class="footer-logo">PHONE&ACCES</div>
        <p>Điện thoại và phụ kiện chính hãng</p>
    </footer>
</body>
</html>
