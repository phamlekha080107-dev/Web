@model _25DH110384_WebStore.Models.ViewModel.HomeProductVM

<link rel="stylesheet" href="~/Areas/Customer/Content/Index.css" />

@{
    Layout = null;

}

<div class="top-note">MIỄN PHÍ VẬN CHUYỂN CHO ĐƠN HÀNG TỪ 500.000Đ</div>

<header class="header">
    <a class="logo" href="#">PHONE & ACCES</a>
    <div class="header-right">

        @using (Html.BeginForm("Index", "Home", FormMethod.Get))
        {
            <div class="form-group search-container">
                @Html.TextBoxFor(m => m.SearchTerm, new
                {
                    @class = "search-input",
                    @id = "search-input",
                    @placeholder = "Tìm sản phẩm..."
                })
                <button type="submit" class="search-button" style="display:none;">Tìm</button>
            </div>
        }
        <span class="wishlist">♡ Yêu thích</span>
        <a href="#cart" class="cart-link">🛒 Giỏ hàng <b id="cart-count">0</b></a>
        <a href="@Url.Action("Login", "Categories1", new { area = "Customer" })" class="login-link">
            Đăng nhập
        </a>
    </div>
</header>

<nav class="navbar">
    <a href="#">TRANG CHỦ</a>
    <a href="@Url.Action("PageDienThoai", "Categories1", new { area = "Customer" })">ĐIỆN THOẠI</a>
    <a href="#products">PHỤ KIỆN</a>
    <a href="#featured">THIẾT BỊ ĐEO THÔNG MINH</a>
    <a href="#footer">THÔNG TIN HỖ TRỢ</a>
</nav>

<section class="hero">
    <div class="hero-copy">
        <p class="eyebrow">SẢN PHẨM MỚI</p>
        <h1>SMART PHONE</h1>
        <span class="small-line"></span>
        <p>Thiết kế nổi bật, hiện đại cho mỗi ngày.</p>
        <a class="btn" href="#products">KHÁM PHÁ NGAY&nbsp; →</a>
    </div>
</section>

@* Phần hiển thị các danh mục hoặc sản phẩm bên dưới banner *@
<div class="container">
    @* Sản phẩm nổi bật *@
    @Html.Partial("PVFeatureProduct", Model)

    @* Sản phẩm mới *@
    @Html.Partial("PVNewProduct", Model)
</div>