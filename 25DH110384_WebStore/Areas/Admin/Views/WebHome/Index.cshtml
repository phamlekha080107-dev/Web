@model IEnumerable<_25DH110384_WebStore.Models.ThongKeVM>

@{
    ViewBag.Title = "Admin Home - Thống kê hàng hóa";
    Layout = "~/Areas/Admin/Views/Shared/_AdminLayout.cshtml";
}

<!-- Phần Bảng Thống Kê -->
<div class="panel panel-success" style="margin-top: 20px;">
    <div class="panel-heading" style="background-color: #dff0d8; padding: 10px; font-weight: bold; color: #3c763d;">
        THỐNG KÊ HÀNG HÓA TỪNG LOẠI
    </div>
    <table class="table table-striped table-bordered" style="width:100%; margin-bottom:0;">
        <thead>
            <tr style="background-color: #f5f5f5;">
                <th>LOẠI HÀNG</th>
                <th>SỐ LƯỢNG</th>
                <th>GIÁ CAO NHẤT</th>
                <th>GIÁ THẤP NHẤT</th>
                <th>GIÁ TRUNG BÌNH</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var item in Model)
            {
                <tr>
                    <td>@item.LoaiHang</td>
                    <td>@item.SoLuong</td>
                    <td>@item.GiaCaoNhat.ToString("N0") đ</td>
                    <td>@item.GiaThapNhat.ToString("N0") đ</td>
                    <td>@item.GiaTrungBinh.ToString("N0") đ</td>
                </tr>
            }
        </tbody>
    </table>
</div>

<!-- Phần Biểu Đồ Thống Kê (Google Chart) -->
<div class="panel panel-default" style="margin-top: 30px;">
    <div class="panel-heading" style="background-color: #f5f5f5; padding: 10px; font-weight: bold;">
        BIỂU ĐỒ THỐNG KÊ - TỶ LỆ HÀNG HÓA
    </div>
    <div class="panel-body" style="text-align: center;">
        <!-- Thẻ div chứa biểu đồ -->
        <div id="piechart_3d" style="width: 750px; height: 450px; margin: 0 auto;"></div>
    </div>
</div>

<!-- Nhúng thư viện Google Charts và viết script vẽ biểu đồ -->
<script type="text/javascript" src="https://www.gstatic.com/charts/loader.js"></script>
<script type="text/javascript">
    google.charts.load("current", {packages:["corechart"]});
    google.charts.setOnLoadCallback(drawChart);

    function drawChart() {
        var data = new google.visualization.DataTable();
        data.addColumn('string', 'Loại Hàng');
        data.addColumn('number', 'Số Lượng');

        var dataArray = [];
        @foreach (var item in Model)
        {
            <text>
            // Sử dụng Html.Raw(Json.Encode(...)) để giữ nguyên tiếng Việt có dấu
            dataArray.push([@Html.Raw(Json.Encode(item.LoaiHang)), @item.SoLuong]);
            </text>
        }
        data.addRows(dataArray);

        var options = {
            title: 'TỶ LỆ HÀNG HÓA THEO SỐ LƯỢNG',
            is3D: true,
            chartArea: { width: '90%', height: '80%' }
        };

        var chart = new google.visualization.PieChart(document.getElementById('piechart_3d'));
        chart.draw(data, options);
    }
</script>