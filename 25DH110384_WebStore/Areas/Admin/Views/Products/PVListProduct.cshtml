@model _25DH110384_WebStore.Models.ViewModel.ProductSearchVM
@using PagedList.Mvc;

<style>
    /* --- Card Container --- */
    .product-list-card {
        border-radius: 12px;
        overflow: hidden;
        background-color: #ffffff;
        border: 1px solid #e2e8f0 !important;
    }

    /* --- Product Image Style --- */
    .product-img-wrapper {
        width: 60px;
        height: 60px;
        border-radius: 8px;
        overflow: hidden;
        background-color: #f8fafc;
        border: 1px solid #e2e8f0;
        display: flex;
        align-items: center;
        justify-content: center;
    }

        .product-img-wrapper img {
            width: 100%;
            height: 100%;
            object-fit: cover;
        }

    /* --- Custom Table --- */
    .table-products {
        border-collapse: separate;
        border-spacing: 0;
    }

        .table-products thead {
            background-color: #f8fafc;
            border-bottom: 2px solid #e2e8f0;
        }

            .table-products thead th {
                color: #475569;
                font-size: 0.85rem;
                font-weight: 600;
                text-transform: uppercase;
                letter-spacing: 0.05em;
            }

        .table-products tbody tr {
            transition: background-color 0.15s ease-in-out;
        }

            .table-products tbody tr:hover {
                background-color: #f1f5f9;
            }

            .table-products tbody tr:not(:last-child) td {
                border-bottom: 1px solid #f1f5f9;
            }

        /* --- Action Buttons --- */
        .table-products .btn-sm {
            border-radius: 6px;
            font-weight: 500;
            font-size: 0.825rem;
        }

    .btn-outline-info {
        color: #0284c7;
        border-color: #bae6fd;
        background-color: #f0f9ff;
    }

        .btn-outline-info:hover {
            color: #ffffff;
            background-color: #0284c7;
            border-color: #0284c7;
        }

    .btn-outline-warning {
        color: #d97706;
        border-color: #fde68a;
        background-color: #fffbeb;
    }

        .btn-outline-warning:hover {
            color: #ffffff;
            background-color: #d97706;
            border-color: #d97706;
        }

    .btn-outline-danger {
        color: #dc2626;
        border-color: #fecaca;
        background-color: #fef2f2;
    }

        .btn-outline-danger:hover {
            color: #ffffff;
            background-color: #dc2626;
            border-color: #dc2626;
        }

    /* --- PagedList Pager Custom Style --- */
    .pagination-wrapper {
        display: flex;
        justify-content: center;
        padding: 1.25rem 0;
    }

    .pagination-container ul.pagination {
        display: flex;
        padding-left: 0;
        list-style: none;
        gap: 4px;
        margin: 0;
    }

        .pagination-container ul.pagination li a,
        .pagination-container ul.pagination li span {
            color: #475569;
            padding: 0.4rem 0.85rem;
            border-radius: 6px;
            border: 1px solid #cbd5e1;
            text-decoration: none;
            font-size: 0.875rem;
            font-weight: 500;
            transition: all 0.2s ease;
        }

        .pagination-container ul.pagination li:hover a {
            background-color: #eff6ff;
            color: #2563eb;
            border-color: #93c5fd;
        }

        .pagination-container ul.pagination li.active span {
            background-color: #2563eb;
            color: #ffffff;
            border-color: #2563eb;
        }

        .pagination-container ul.pagination li.disabled span {
            color: #94a3b8;
            background-color: #f8fafc;
            border-color: #e2e8f0;
        }
</style>

<div class="product-list-container">
    <!-- Header & Add Button -->
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h5 class="fw-bold text-dark m-0">KẾT QUẢ SẢN PHẨM</h5>
        @Html.ActionLink(" Thêm mới sản phẩm", "Create", null, new { @class = "btn btn-primary btn-sm px-3 py-2 fw-semibold shadow-sm" })
    </div>

    <!-- Table Card Container -->
    <div class="card product-list-card border-0 shadow-sm">
        <div class="card-body p-0">
            @if (Model.Products != null && Model.Products.Any())
            {
                <div class="table-responsive">
                    <table class="table table-hover align-middle table-products m-0">
                        <thead>
                            <tr>
                                <th class="py-3 px-4" style="width: 10%;">Hình ảnh</th>
                                <th class="py-3 px-4" style="width: 30%;">Tên sản phẩm</th>
                                <th class="py-3 px-4" style="width: 15%;">Đơn giá</th>
                                <th class="py-3 px-4" style="width: 20%;">Danh mục</th>
                                <th class="py-3 px-4 text-end" style="width: 25%;">Thao tác</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var product in Model.Products)
                            {
                                <tr>
                                    <td class="py-3 px-4">
                                        <div class="product-img-wrapper">
                                            @if (!string.IsNullOrEmpty(product.ProductImage))
                                            {
                                                <img src="@Url.Content(product.ProductImage)" alt="@product.ProductName" />
                                            }
                                            else
                                            {
                                                <i class="fa-regular fa-image text-muted"></i>
                                            }
                                        </div>
                                    </td>
                                    <td class="py-3 px-4 fw-medium text-dark">
                                        @Html.DisplayFor(modelItem => product.ProductName)
                                    </td>
                                    <td class="py-3 px-4 fw-bold text-primary">
                                        @string.Format("{0:N0} đ", product.ProductPrice)
                                    </td>
                                    <td class="py-3 px-4">
                                        <span class="badge bg-light text-dark border">
                                            @Html.DisplayFor(modelItem => product.Category.CategoryName)
                                        </span>
                                    </td>
                                    <td class="py-3 px-4 text-end">
                                        @Html.ActionLink("Chi tiết", "Details", new { id = product.ProductID }, new { @class = "btn btn-sm btn-outline-info me-1 px-2" })
                                        @Html.ActionLink("Sửa", "Edit", new { id = product.ProductID }, new { @class = "btn btn-sm btn-outline-warning me-1 px-2" })
                                        @Html.ActionLink("Xóa", "Delete", new { id = product.ProductID }, new { @class = "btn btn-sm btn-outline-danger px-2" })
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>

                <!-- Phân trang -->
                <div class="pagination-wrapper border-top">
                    <div class="pagination-container">
                        @Html.PagedListPager(Model.Products, page => Url.Action("Index", new { page, searchTerm = Model.SearchTerm, minPrice = Model.MinPrice, maxPrice = Model.MaxPrice, sortOrder = Model.SortOrder }))
                    </div>
                </div>
            }
            else
            {
                <div class="text-center py-5">
                    <i class="fa-solid fa-box-open fs-1 text-muted mb-3 d-block"></i>
                    <p class="text-muted m-0">Không tìm thấy sản phẩm nào phù hợp.</p>
                </div>
            }
        </div>
    </div>
</div>