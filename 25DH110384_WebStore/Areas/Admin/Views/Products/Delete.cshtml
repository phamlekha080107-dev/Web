@model _25DH110384_WebStore.Models.Product

@{
    ViewBag.Title = "Delete";
    Layout = "~/Areas/Admin/Views/Shared/_AdminLayout.cshtml";
}


<h2 class="bg-success">XÓA SẢN PHẨM</h2>

<h4 class="bg-danger">Bạn có chắc chắn xóa sản phẩm này ?</h4>

@Html.Partial("PVProdInfo", Model)

<div class="col-md-4 col-md-8">
    @using (Html.BeginForm("Delete", "Products", new { id = Model.ProductID }, FormMethod.Post))
    {
        @Html.AntiForgeryToken()

        <input type="submit" value="Xóa" class="btn btn-danger" />
        @Html.ActionLink("Quay lại danh sách", "Index", null, new { @class = "btn btn-default" })
    }
</div>
