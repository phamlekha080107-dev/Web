@model _25DH110384_WebStore.Models.Product

@{
    ViewBag.Title = "Delete";
    Layout = "~/Areas/Admin/Views/Shared/_AdminLayout.cshtml";
}


<h2 class="bg-success">XÓA SẢN PHẨM</h2>

<h4 class="bg-danger">Bạn có chắc chắn xóa sản phẩm này ?</h4>
<div class="container-fluid">
    <dl class="dl-horizontal">
        <dt>Tên sản phẩm</dt>
        <dd>@Html.DisplayFor(model => model.ProductName)</dd>

        <dt>Đơn giá </dt>
        <dd>@Html.DisplayFor(model => model.ProductPrice)</dd>

        <dt>Hình ảnh    </dt>
        <dd>@Html.DisplayFor(model => model.ProductImage)</dd>

        <dt>Mô tả   </dt>
        <dd>@Html.DisplayFor(model => model.ProductDescription)</dd>

        <dt>Danh mục   </dt>
        <dd>@Html.DisplayFor(model => model.Category.CategoryName)</dd>

        <dt></dt>
        <dd>
            @Html.ActionLink("Sửa", "Edit", new { id = Model.ProductID }, new { @class = "btn btn-primary btn-sm" })
            @Html.ActionLink("Quay lại danh sách", "Index", null, new { @class = "btn btn-primary btn-sm" })
        </dd>

    </dl>


</div>
