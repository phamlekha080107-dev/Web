@model _25DH110384_WebStore.Models.Product

@{
    ViewBag.Title = "Cập nhật sản phẩm";
    Layout = "~/Areas/Admin/Views/Shared/_AdminLayout.cshtml";
}

<style>
    .product-form-container {
        padding: 1.5rem 0;
    }

    .card-product-form {
        border-radius: 12px;
        overflow: hidden;
        background-color: #ffffff;
        border: 1px solid #e2e8f0 !important;
    }

        .card-product-form .card-header {
            background: linear-gradient(135deg, #f59e0b 0%, #d97706 100%) !important;
        }

        .card-product-form .btn-warning {
            background-color: #d97706;
            border-color: #d97706;
            color: #ffffff;
            border-radius: 8px;
        }

            .card-product-form .btn-warning:hover {
                background-color: #b45309;
                border-color: #b45309;
                color: #ffffff;
            }

        .card-product-form .btn-outline-secondary {
            color: #475569;
            border-color: #cbd5e1;
            border-radius: 8px;
        }

            .card-product-form .btn-outline-secondary:hover {
                background-color: #f1f5f9;
                color: #1e293b;
            }
</style>

<div class="product-form-container">
    <div class="card card-product-form border-0 shadow-sm mx-auto" style="max-width: 750px;">
        <div class="card-header text-white p-3">
            <h5 class="m-0 fw-bold text-dark">
                <i class="fa-solid fa-pen-to-square me-2"></i>CẬP NHẬT SẢN PHẨM
            </h5>
        </div>

        <div class="card-body p-4">
            @using (Html.BeginForm())
            {
                @Html.AntiForgeryToken()
                @Html.ValidationSummary(true, "", new { @class = "alert alert-danger p-2 small mb-3" })
                @Html.HiddenFor(model => model.ProductID)

                @Html.Partial("PVCreateEditProduct", Model)
            }
        </div>
    </div>
</div>

@section Scripts {
    @Scripts.Render("~/bundles/jqueryval")
}