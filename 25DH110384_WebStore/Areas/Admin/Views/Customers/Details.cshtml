@model _25DH110384_WebStore.Models.Customer

@{
    ViewBag.Title = "Chi tiết Khách hàng";
    Layout = "~/Areas/Admin/Views/Shared/_AdminLayout.cshtml";
}

<style>
    .customer-card {
        background: #ffffff;
        border-radius: 8px;
        box-shadow: 0 2px 8px rgba(0, 0, 0, 0.06);
        border: 1px solid #e9ecef;
        overflow: hidden;
        margin-top: 20px;
        margin-bottom: 30px;
    }

    .card-header {
        background-color: #1e824c;
        color: white;
        padding: 15px 20px;
        font-weight: bold;
        font-size: 1.3rem;
    }

    .info-box {
        background-color: #f8f9fa;
        border: 1px solid #e9ecef;
        border-radius: 6px;
        padding: 18px 22px;
        margin: 20px;
        line-height: 1.9;
    }

    .order-history-box {
        margin: 20px;
    }

    .order-item-header {
        background-color: #e9ecef;
        padding: 12px 15px;
        font-weight: bold;
        border-radius: 6px 6px 0 0;
        border: 1px solid #dee2e6;
        display: flex;
        justify-content: space-between;
    }

    .detail-table {
        margin-bottom: 25px;
        width: 100%;
        border-top: none;
    }

        .detail-table th {
            background-color: #f1f3f5;
            color: #333;
            font-weight: 600;
            text-align: center;
            padding: 10px !important;
        }

        .detail-table td {
            vertical-align: middle !important;
            padding: 10px !important;
        }

    .product-thumb {
        height: 50px;
        width: 50px;
        object-fit: cover;
        border-radius: 4px;
        border: 1px solid #dee2e6;
    }
</style>

<div class="customer-card">
    <div class="card-header">
        <i class="fas fa-user-circle" style="margin-right: 8px;"></i> HỒ SƠ KHÁCH HÀNG: @(string.IsNullOrEmpty(Model.CustomerName) ? Model.Username : Model.CustomerName)
    </div>

    <!-- THÔNG TIN CÁ NHÂN -->
    <div class="info-box">
        <h4 style="font-weight: 700; color: #1e824c; margin-bottom: 15px; border-bottom: 1px solid #dee2e6; padding-bottom: 8px;">
            Thông tin liên hệ
        </h4>
        <div class="row">
            <div class="col-md-6">
                <p><strong>Mã KH:</strong> #@Model.CustomerID</p>
                <p><strong>Họ và tên:</strong> @(string.IsNullOrEmpty(Model.CustomerName) ? "Chưa cập nhật" : Model.CustomerName)</p>
                <p><strong>Tài khoản đăng nhập:</strong> @Model.Username</p>
            </div>
            <div class="col-md-6">
                <p><strong>Số điện thoại:</strong> @(string.IsNullOrEmpty(Model.CustomerPhone) ? "Chưa cập nhật" : Model.CustomerPhone)</p>
                <p><strong>Email:</strong> @(string.IsNullOrEmpty(Model.CustomerEmail) ? "Chưa cập nhật" : Model.CustomerEmail)</p>
                <p><strong>Địa chỉ mặc định:</strong> @(string.IsNullOrEmpty(Model.CustomerAddress) ? "Chưa cập nhật" : Model.CustomerAddress)</p>
            </div>
        </div>
    </div>

    <!-- LỊCH SỬ MUA HÀNG -->
    <div class="order-history-box">
        <h4 style="font-weight: 700; color: #333; margin-bottom: 20px;">
            <i class="fas fa-history" style="margin-right: 5px;"></i> Lịch sử đơn hàng đã mua
        </h4>

        @if (Model.Orders != null && Model.Orders.Any())
        {
            foreach (var order in Model.Orders)
            {
                <div class="order-item-header">
                    <span>
                        <span class="text-primary">Đơn hàng #@order.OrderID</span>
                        | Ngày đặt: @order.OrderDate.ToString("dd/MM/yyyy HH:mm")
                    </span>
                    <span style="color: #d9534f;">Tổng tiền: @(((decimal)order.TotalAmount).ToString("N0")) VNĐ</span>
                </div>
                <table class="table table-bordered detail-table">
                    <thead>
                        <tr>
                            <th style="width: 70px;">Hình ảnh</th>
                            <th class="text-left">Tên sản phẩm</th>
                            <th style="width: 100px;">Số lượng</th>
                            <th style="width: 130px;">Đơn giá</th>
                            <th style="width: 140px;">Thành tiền</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (order.OrderDetails != null && order.OrderDetails.Any())
                        {
                            foreach (var item in order.OrderDetails)
                            {
                                <tr>
                                    <td class="text-center">
                                        <img src="@Url.Content(item.Product != null && !string.IsNullOrEmpty(item.Product.ProductImage) ? item.Product.ProductImage : "~/Images/default.png")" class="product-thumb" />
                                    </td>
                                    <td class="text-left" style="font-weight: 600;">
                                        @(item.Product != null ? item.Product.ProductName : "Sản phẩm #" + item.ProductID)
                                    </td>
                                    <td class="text-center">x@(item.Quantity)</td>
                                    <td class="text-right">@(((decimal)item.UnitPrice).ToString("N0")) đ</td>
                                    <td class="text-right" style="font-weight: bold; color: #333;">
                                        @(((decimal)(item.Quantity * item.UnitPrice)).ToString("N0")) đ
                                    </td>
                                </tr>
                            }
                        }
                        else
                        {
                            <tr>
                                <td colspan="5" class="text-center text-muted">Đơn hàng này không có chi tiết sản phẩm.</td>
                            </tr>
                        }
                    </tbody>
                </table>
            }
        }
        else
        {
            <div class="alert alert-info text-center" style="padding: 20px;">
                Khách hàng này chưa thực hiện đơn hàng nào.
            </div>
        }
    </div>

    <!-- NÚT ĐIỀU HƯỚNG -->
    <div style="padding: 0 20px 25px;">
        <a href="@Url.Action("Index", "Customers", new { area = "Admin" })" class="btn btn-default btn-lg">
            <i class="fas fa-arrow-left"></i> Quay lại danh sách Khách hàng
        </a>
    </div>
</div>
