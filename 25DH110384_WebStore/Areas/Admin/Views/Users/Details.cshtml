@model _25DH110384_WebStore.Models.User

@{
    ViewBag.Title = "Chi tiết Tài khoản";
    Layout = "~/Areas/Admin/Views/Shared/_AdminLayout.cshtml";

    // Lấy thông tin khách hàng liên kết với tài khoản này (nếu có)
    var customerInfo = Model.Customers.FirstOrDefault();
}

<style>
    .admin-card {
        background: #ffffff;
        border-radius: 8px;
        box-shadow: 0 2px 8px rgba(0,0,0,0.06);
        border: 1px solid #e9ecef;
        overflow: hidden;
        margin-top: 20px;
        margin-bottom: 20px;
    }

    .admin-header {
        background-color: #1e824c;
        color: white;
        padding: 15px 20px;
        font-weight: bold;
        font-size: 1.2rem;
    }

    .info-box {
        background-color: #f8f9fa;
        border: 1px solid #e9ecef;
        border-radius: 6px;
        padding: 25px 30px;
        margin: 25px;
        line-height: 2.2;
        font-size: 1.1rem;
    }

    .info-group {
        margin-bottom: 15px;
    }

    .info-label {
        font-weight: bold;
        display: inline-block;
        width: 180px;
    }

    .section-title {
        color: #1e824c;
        font-weight: bold;
        margin-top: 10px;
        margin-bottom: 15px;
        border-bottom: 2px solid #e9ecef;
        padding-bottom: 5px;
        text-transform: uppercase;
    }

    .back-link {
        display: inline-block;
        margin: 0 25px 25px 25px;
        font-weight: bold;
        color: #333;
        text-decoration: none;
        font-size: 1.1rem;
    }

        .back-link:hover {
            color: #1e824c;
            text-decoration: none;
        }
</style>

<div class="admin-card">
    <div class="admin-header">
        <i class="fas fa-address-card" style="margin-right: 8px;"></i> THÔNG TIN CHI TIẾT TÀI KHOẢN
    </div>

    <div class="info-box">
        <!-- PHẦN 1: THÔNG TIN ĐĂNG NHẬP (Lấy từ bảng User) -->
        <div class="section-title">Thông tin đăng nhập</div>

        <div class="info-group">
            <span class="info-label">Tên đăng nhập:</span>
            <span style="color: #1e824c; font-weight: bold;">@Model.Username</span>
        </div>

        <div class="info-group">
            <span class="info-label">Mật khẩu:</span>
            <span style="color: #555;">@Model.Password</span>
        </div>

        

        <!-- PHẦN 2: THÔNG TIN CÁ NHÂN (Lấy từ bảng Customer) -->
        <div class="section-title" style="margin-top: 30px;">Thông tin cá nhân liên kết</div>

        <div class="info-group">
            <span class="info-label">Email:</span>
            <span>@(customerInfo != null ? customerInfo.CustomerEmail : "Chưa có thông tin")</span>
        </div>

        <div class="info-group">
            <span class="info-label">Số điện thoại:</span>
            <span>@(customerInfo != null ? customerInfo.CustomerPhone : "Chưa có thông tin")</span>
        </div>

        <div class="info-group" style="margin-bottom: 0;">
            <span class="info-label">Địa chỉ:</span>
            <span>@(customerInfo != null ? customerInfo.CustomerAddress : "Chưa có thông tin")</span>
        </div>
    </div>

    <a href="@Url.Action("Index", "Users", new { area = "Admin" })" class="back-link">
        <i class="fas fa-arrow-left" style="margin-right: 5px;"></i> Quay lại danh sách
    </a>
</div>