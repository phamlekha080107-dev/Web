@model IEnumerable<_25DH110384_WebStore.Models.User>

@{
    ViewBag.Title = "Danh sách Tài khoản";
    Layout = "~/Areas/Admin/Views/Shared/_AdminLayout.cshtml";
}

<style>
    .admin-card {
        background: #ffffff;
        border-radius: 8px;
        box-shadow: 0 2px 8px rgba(0,0,0,0.06);
        border: 1px solid #e9ecef;
        overflow: hidden;
        margin-top: 20px;
    }

    .admin-header {
        background-color: #1e824c;
        color: white;
        padding: 15px 20px;
        font-weight: bold;
        font-size: 1.3rem;
    }

    .custom-table {
        margin-bottom: 0;
        width: 100%;
    }

        .custom-table th {
            background-color: #f8f9fa;
            color: #333;
            font-weight: 700;
            border-bottom: 2px solid #dee2e6 !important;
            padding: 12px !important;
            vertical-align: middle !important;
        }

        .custom-table td {
            vertical-align: middle !important;
            padding: 12px !important;
        }
</style>

<div class="admin-card">
    <div class="admin-header">
        <i class="fas fa-user-shield" style="margin-right: 8px;"></i> DANH SÁCH TÀI KHOẢN HỆ THỐNG
    </div>

    <div class="table-responsive">
        <table class="table table-hover custom-table">
            <thead>
                <tr>
                    <th class="text-left">Tên đăng nhập (Username)</th>
                    <th class="text-center">Mật khẩu</th>
                    <th class="text-center" style="width: 150px;">Thao tác</th>
                </tr>
            </thead>
            <tbody>
                @if (Model != null && Model.Any())
                {
                    foreach (var item in Model)
                    {
                        <tr>
                            <td class="text-left" style="font-weight: 600; color: #1e824c;">
                                @item.Username
                            </td>
                            <td class="text-center text-muted">
                                ********
                            </td>
                            <td class="text-center">
                                <!-- Nút Xem chi tiết truyền Username qua id -->
                                <a href="@Url.Action("Details", "Users", new { area = "Admin", id = item.Username })" class="btn btn-info btn-sm">
                                    <i class="fas fa-eye"></i> Chi tiết
                                </a>
                            </td>
                        </tr>
                    }
                }
                else
                {
                    <tr>
                        <td colspan="3" class="text-center text-muted" style="padding: 30px !important;">
                            Chưa có tài khoản nào.
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>