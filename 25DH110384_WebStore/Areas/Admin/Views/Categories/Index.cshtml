@model IEnumerable<_25DH110384_WebStore.Models.Category>

@{
    ViewBag.Title = "Quản lý Danh Mục";
    Layout = "~/Areas/Admin/Views/Shared/_AdminLayout.cshtml";
}

<style>
    /* --- Page Header --- */
    .category-manager .page-title {
        color: #1e293b;
        font-size: 1.5rem;
        letter-spacing: -0.02em;
    }

    /* --- Card & Table Layout --- */
    .card-custom {
        border-radius: 12px;
        overflow: hidden;
        background-color: #ffffff;
        border: 1px solid #e2e8f0 !important;
    }

    .custom-table {
        border-collapse: separate;
        border-spacing: 0;
    }

        .custom-table thead {
            background-color: #f8fafc;
            border-bottom: 2px solid #e2e8f0;
        }

            .custom-table thead th {
                color: #475569;
                font-size: 0.85rem;
                font-weight: 600;
                text-transform: uppercase;
                letter-spacing: 0.05em;
            }

        .custom-table tbody tr {
            transition: background-color 0.15s ease-in-out;
        }

            .custom-table tbody tr:hover {
                background-color: #f1f5f9;
            }

            .custom-table tbody tr:not(:last-child) td {
                border-bottom: 1px solid #f1f5f9;
            }

    /* --- Action Buttons --- */
    .btn-add-new {
        background-color: #2563eb;
        border-color: #2563eb;
        font-weight: 500;
        padding: 0.5rem 1.25rem;
        border-radius: 8px;
        transition: all 0.2s ease;
    }

        .btn-add-new:hover {
            background-color: #1d4ed8;
            border-color: #1d4ed8;
            transform: translateY(-1px);
        }

    .custom-table .btn-sm {
        border-radius: 6px;
        font-weight: 500;
        font-size: 0.825rem;
    }

    /* Nút Chi tiết (Xanh lam nhạt) */
    .btn-outline-info {
        color: #0284c7;
        border-color: #bae6fd;
        background-color: #f0f9ff;
    }

        .btn-outline-info:hover {
            color: #ffffff;
            background-color: #0284c7;
            border-color: #0284c7;
        }

    /* Nút Sửa (Vàng cam nhạt) */
    .btn-outline-warning {
        color: #d97706;
        border-color: #fde68a;
        background-color: #fffbeb;
    }

        .btn-outline-warning:hover {
            color: #ffffff;
            background-color: #d97706;
            border-color: #d97706;
        }

    /* Nút Xóa (Đỏ nhạt) */
    .btn-outline-danger {
        color: #dc2626;
        border-color: #fecaca;
        background-color: #fef2f2;
    }

        .btn-outline-danger:hover {
            color: #ffffff;
            background-color: #dc2626;
            border-color: #dc2626;
        }
</style>

<div class="category-manager">
    <!-- Header Page -->
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2 class="page-title fw-bold m-0">DANH SÁCH DANH MỤC</h2>
            <p class="text-muted small mb-0">Quản lý các nhóm sản phẩm trong hệ thống</p>
        </div>
        <div>
            @Html.ActionLink(" Thêm mới", "Create", null, new { @class = "btn btn-primary btn-add-new shadow-sm" })
        </div>
    </div>

    <!-- Table Card Container -->
    <div class="card card-custom border-0 shadow-sm">
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-hover align-middle custom-table m-0">
                    <thead>
                        <tr>
                            <th class="py-3 px-4" style="width: 50%;">Tên Danh Mục</th>
                            <th class="py-3 px-4 text-end" style="width: 50%;">Thao tác</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (Model != null && Model.Any())
                        {
                            foreach (var item in Model)
                            {
                                <tr>
                                    <td class="py-3 px-4 fw-medium text-dark">
                                        <i class="fa-regular fa-folder text-primary me-2"></i>
                                        @Html.DisplayFor(modelItem => item.CategoryName)
                                    </td>
                                    <td class="py-3 px-4 text-end">
                                        @Html.ActionLink("Chi tiết", "Details", new { id = item.CategoryID }, new { @class = "btn btn-sm btn-outline-info me-1 px-3" })
                                        @Html.ActionLink("Sửa", "Edit", new { id = item.CategoryID }, new { @class = "btn btn-sm btn-outline-warning me-1 px-3" })
                                        @Html.ActionLink("Xóa", "Delete", new { id = item.CategoryID }, new { @class = "btn btn-sm btn-outline-danger px-3" })
                                    </td>
                                </tr>
                            }
                        }
                        else
                        {
                            <tr>
                                <td colspan="2" class="text-center py-4 text-muted">
                                    Chưa có dữ liệu danh mục.
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>