@model _25DH110384_WebStore.Models.Category

@{
    ViewBag.Title = "Chi tiết danh mục";
    Layout = "~/Areas/Admin/Views/Shared/_AdminLayout.cshtml";
}
<style>
    /* --- Details View Layout --- */
    .category-details-container {
        padding: 2rem 0;
    }

    .card-details {
        border-radius: 12px;
        overflow: hidden;
        background-color: #ffffff;
        border: 1px solid #e2e8f0 !important;
    }

        .card-details .card-header {
            background: linear-gradient(135deg, #2563eb 0%, #1d4ed8 100%) !important;
        }

    /* --- Detail Content Box --- */
    .detail-item {
        background-color: #f8fafc;
        border: 1px solid #e2e8f0;
    }

    /* --- Form Buttons --- */
    .card-details .btn {
        border-radius: 8px;
        font-size: 0.9rem;
        transition: all 0.2s ease-in-out;
    }

    .card-details .btn-warning {
        background-color: #d97706;
        border-color: #d97706;
    }

        .card-details .btn-warning:hover {
            background-color: #b45309;
            border-color: #b45309;
            box-shadow: 0 4px 12px rgba(217, 119, 6, 0.25);
        }

    .card-details .btn-outline-secondary {
        color: #475569;
        border-color: #cbd5e1;
    }

        .card-details .btn-outline-secondary:hover {
            background-color: #f1f5f9;
            color: #1e293b;
        }
</style>


<div class="category-details-container">
    <div class="card card-details border-0 shadow-sm mx-auto" style="max-width: 650px;">
        <div class="card-header bg-primary text-white p-3">
            <h5 class="m-0 fw-bold">
                <i class="fa-solid fa-circle-info me-2"></i>THÔNG TIN CHI TIẾT DANH MỤC
            </h5>
        </div>

        <div class="card-body p-4">
            <div class="detail-item p-3 mb-4 rounded">
                <div class="row align-items-center">
                    <div class="col-sm-4 text-muted fw-semibold">
                        <i class="fa-solid fa-tag me-1 text-primary"></i> Tên danh mục:
                    </div>
                    <div class="col-sm-8 text-dark fw-bold fs-5">
                        @Html.DisplayFor(model => model.CategoryName)
                    </div>
                </div>
            </div>

            <!-- Nút thao tác -->
            <div class="d-flex justify-content-end gap-2 mt-4 pt-2 border-top">
                @Html.ActionLink("Quay lại danh sách", "Index", null, new { @class = "btn btn-outline-secondary px-4 py-2" })
                @Html.ActionLink("Cập nhật", "Edit", new { id = Model.CategoryID }, new { @class = "btn btn-warning text-white px-4 py-2 fw-semibold" })
            </div>
        </div>
    </div>
</div>