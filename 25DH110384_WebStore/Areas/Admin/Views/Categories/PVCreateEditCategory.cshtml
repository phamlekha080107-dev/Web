@model _25DH110384_WebStore.Models.Category

<div class="mb-4">
    <label for="CategoryName" class="form-label fw-semibold text-secondary">
        Tên danh mục <span class="text-danger">*</span>
    </label>
    <div class="input-group">
        <span class="input-group-text bg-light border-end-0">
            <i class="fa-solid fa-folder text-muted"></i>
        </span>
        @Html.EditorFor(model => model.CategoryName, new { htmlAttributes = new { @class = "form-control border-start-0 ps-0", placeholder = "Nhập tên danh mục..." } })
    </div>
    @Html.ValidationMessageFor(model => model.CategoryName, "", new { @class = "text-danger small mt-1 d-block" })
</div>

<div class="d-flex justify-content-end gap-2 pt-3 border-top">
    @Html.ActionLink("Quay lại danh sách", "Index", null, new { @class = "btn btn-outline-secondary px-4 py-2" })
    <button type="submit" class="btn btn-primary px-4 py-2 fw-semibold shadow-sm">
        <i class="fa-solid fa-floppy-disk me-1"></i> Lưu dữ liệu
    </button>
</div>