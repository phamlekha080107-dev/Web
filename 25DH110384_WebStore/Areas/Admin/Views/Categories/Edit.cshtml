@model _25DH110384_WebStore.Models.Category

@{
    ViewBag.Title = "Cập nhật danh mục";
    Layout = "~/Areas/Admin/Views/Shared/_AdminLayout.cshtml";
}
<style>
    /* --- Form Card Container --- */
    .category-form-container .card-form {
        border-radius: 12px;
        overflow: hidden;
        background-color: #ffffff;
        border: 1px solid #e2e8f0 !important;
    }

    .category-form-container .card-header.bg-primary {
        background: linear-gradient(135deg, #2563eb 0%, #1d4ed8 100%) !important;
    }

    .category-form-container .card-header.bg-warning {
        background: linear-gradient(135deg, #f59e0b 0%, #d97706 100%) !important;
    }

    /* --- Form Controls --- */
    .form-label {
        font-size: 0.9rem;
    }

    .input-group-text {
        border-color: #cbd5e1;
        color: #64748b;
    }

    .form-control {
        border-color: #cbd5e1;
        padding: 0.6rem 0.75rem;
        font-size: 0.95rem;
        border-radius: 8px;
        transition: all 0.2s ease-in-out;
    }

        .form-control:focus {
            border-color: #3b82f6;
            box-shadow: 0 0 0 3px rgba(59, 130, 246, 0.15);
        }

    /* --- Form Buttons --- */
    .card-form .btn {
        border-radius: 8px;
        font-size: 0.9rem;
        transition: all 0.2s ease-in-out;
    }

    .card-form .btn-primary {
        background-color: #2563eb;
        border-color: #2563eb;
    }

        .card-form .btn-primary:hover {
            background-color: #1d4ed8;
            border-color: #1d4ed8;
            box-shadow: 0 4px 12px rgba(37, 99, 235, 0.25);
        }

    .card-form .btn-outline-secondary {
        color: #475569;
        border-color: #cbd5e1;
    }

        .card-form .btn-outline-secondary:hover {
            background-color: #f1f5f9;
            color: #1e293b;
        }
</style>

<div class="category-form-container py-4">
    <div class="card card-form border-0 shadow-sm mx-auto" style="max-width: 600px;">
        <div class="card-header bg-warning text-white p-3">
            <h5 class="m-0 fw-bold text-dark">
                <i class="fa-solid fa-pen-to-square me-2"></i>CẬP NHẬT DANH MỤC
            </h5>
        </div>

        <div class="card-body p-4">
            @using (Html.BeginForm())
            {
                @Html.AntiForgeryToken()
                @Html.ValidationSummary(true, "", new { @class = "alert alert-danger p-2 small mb-3" })
                @Html.HiddenFor(model => model.CategoryID)

                <!-- Nhúng Partial View -->
                @Html.Partial("PVCreateEditCategory", Model)
            }
        </div>
    </div>
</div>