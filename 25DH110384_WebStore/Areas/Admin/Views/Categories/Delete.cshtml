@model _25DH110384_WebStore.Models.Category

@{
    ViewBag.Title = "Xác nhận xóa danh mục";
    Layout = "~/Areas/Admin/Views/Shared/_AdminLayout.cshtml";
}

<style>
    /* --- Delete View Layout --- */
    .category-delete-container {
        padding: 2rem 0;
    }

    .card-delete {
        border-radius: 12px;
        overflow: hidden;
        background-color: #ffffff;
        border: 1px solid #e2e8f0 !important;
    }

        .card-delete .card-header {
            background: linear-gradient(135deg, #ef4444 0%, #dc2626 100%) !important;
        }

    /* --- Warning & Info Box --- */
    .alert-warning {
        background-color: #fffbe strain;
        background-color: #fffbeb;
        color: #b45309;
        border-radius: 8px;
    }

    .detail-box {
        background-color: #f8fafc;
        border: 1px dashed #cbd5e1;
    }

    /* --- Form Buttons --- */
    .card-delete .btn {
        border-radius: 8px;
        font-size: 0.9rem;
        transition: all 0.2s ease-in-out;
    }

    .card-delete .btn-danger {
        background-color: #dc2626;
        border-color: #dc2626;
    }

        .card-delete .btn-danger:hover {
            background-color: #b91c1c;
            border-color: #b91c1c;
            box-shadow: 0 4px 12px rgba(220, 38, 38, 0.25);
        }

    .card-delete .btn-outline-secondary {
        color: #475569;
        border-color: #cbd5e1;
    }

        .card-delete .btn-outline-secondary:hover {
            background-color: #f1f5f9;
            color: #1e293b;
        }
</style>


<div class="category-delete-container">
    <div class="card card-delete border-0 shadow-sm mx-auto" style="max-width: 600px;">
        <div class="card-header bg-danger text-white p-3">
            <h5 class="m-0 fw-bold">
                <i class="fa-solid fa-triangle-exclamation me-2"></i>XÁC NHẬN XÓA DANH MỤC
            </h5>
        </div>

        <div class="card-body p-4">
            <div class="alert alert-warning border-0 d-flex align-items-center mb-4" role="alert">
                <i class="fa-solid fa-circle-info fs-4 me-3 text-warning"></i>
                <div>
                    <strong>Cảnh báo:</strong> Bạn có chắc chắn muốn xóa danh mục này? Hành động này không thể hoàn tác.
                </div>
            </div>

            <!-- Thông tin chi tiết -->
            <div class="detail-box p-3 rounded mb-4">
                <div class="row align-items-center">
                    <div class="col-sm-4 text-muted fw-semibold">Tên danh mục:</div>
                    <div class="col-sm-8 text-dark fw-bold fs-5">
                        @Html.DisplayFor(model => model.CategoryName)
                    </div>
                </div>
            </div>

            <!-- Form xử lý xóa -->
            @using (Html.BeginForm())
            {
                @Html.AntiForgeryToken()
                @Html.HiddenFor(model => model.CategoryID)

                <div class="d-flex justify-content-end gap-2 mt-4">
                    @Html.ActionLink("Quay lại danh sách", "Index", null, new { @class = "btn btn-outline-secondary px-4 py-2" })
                    <button type="submit" class="btn btn-danger px-4 py-2 fw-semibold">
                        <i class="fa-solid fa-trash me-1"></i> Xóa vĩnh viễn
                    </button>
                </div>
            }
        </div>
    </div>
</div>