@model _25DH110384_WebStore.Models.Order

@{
    ViewBag.Title = "Chi tiết đơn hàng #" + Model.OrderID;
    Layout = "~/Areas/Admin/Views/Shared/_AdminLayout.cshtml";
}

<style>
    .detail-card {
        background: #ffffff;
        border-radius: 8px;
        box-shadow: 0 2px 8px rgba(0, 0, 0, 0.06);
        border: 1px solid #e9ecef;
        overflow: hidden;
        margin-top: 20px;
        margin-bottom: 30px;
    }

    .detail-header {
        background-color: #1e824c;
        color: white;
        padding: 15px 20px;
        font-weight: bold;
        font-size: 1.3rem;
        display: flex;
        justify-content: space-between;
        align-items: center;
    }

    .detail-body {
        padding: 25px;
    }

    .info-box {
        background-color: #f8f9fa;
        border: 1px solid #e9ecef;
        border-radius: 6px;
        padding: 18px 22px;
        margin-bottom: 25px;
        line-height: 1.9;
    }

    .info-box-title {
        font-weight: 700;
        color: #1e824c;
        border-bottom: 1px solid #dee2e6;
        padding-bottom: 8px;
        margin-bottom: 12px;
        font-size: 1.1rem;
    }

    .section-title {
        font-weight: 700;
        color: #333;
        margin-bottom: 15px;
        font-size: 1.15rem;
    }

    .detail-table {
        margin-bottom: 0;
        width: 100%;
    }

        .detail-table th {
            background-color: #f8f9fa;
            color: #333;
            font-weight: 700;
            border-bottom: 2px solid #dee2e6 !important;
            padding: 12px !important;
            vertical-align: middle !important;
        }

        .detail-table td {
            vertical-align: middle !important;
            padding: 12px !important;
        }

    .product-thumb {
        height: 60px;
        width: 60px;
        object-fit: cover;
        border-radius: 6px;
        border: 1px solid #dee2e6;
    }

    .total-summary {
        background-color: #fff5f5;
        border: 1px solid #f5c6cb;
        border-radius: 6px;
        padding: 15px 20px;
        margin-top: 20px;
        text-align: right;
    }

    .total-amount {
        color: #d9534f;
        font-size: 1.4rem;
        font-weight: 700;
        margin-left: 10px;
    }
</style>

<div class="detail-card">
    <div class="detail-header">
        <span><i class="fas fa-file-invoice" style="margin-right: 8px;"></i> CHI TIẾT ĐƠN HÀNG #@Model.OrderID</span>
        <span style="font-size: 0.95rem; font-weight: normal; background: rgba(255,255,255,0.2); padding: 4px 12px; border-radius: 20px;">
            @(string.IsNullOrEmpty(Model.PaymentStatus) ? "Đã tiếp nhận" : Model.PaymentStatus)
        </span>
    </div>

    <div class="detail-body">
        <!-- THÔNG TIN ĐƠN HÀNG & KHÁCH HÀNG -->
        <div class="info-box">
            <div class="info-box-title">THÔNG TIN ĐƠN HÀNG & KHÁCH HÀNG</div>
            <div class="row">
                <div class="col-md-6">
                    <p style="margin-bottom: 6px;"><strong>Khách hàng:</strong> @(Model.Customer != null ? (string.IsNullOrEmpty(Model.Customer.CustomerName) ? Model.Customer.Username : Model.Customer.CustomerName) : "Khách vãng lai")</p>
                    <p style="margin-bottom: 6px;"><strong>Số điện thoại:</strong> @(Model.Customer != null ? Model.Customer.CustomerPhone : "Chưa cập nhật")</p>
                    <p style="margin-bottom: 0;"><strong>Phương thức thanh toán:</strong> @(string.IsNullOrEmpty(Model.PaymentMethod) ? "Tiền mặt" : Model.PaymentMethod)</p>
                </div>
                <div class="col-md-6">
                    <p style="margin-bottom: 6px;"><strong>Ngày đặt hàng:</strong> @Model.OrderDate.ToString("dd/MM/yyyy HH:mm")</p>
                    <p style="margin-bottom: 0;"><strong>Địa chỉ giao hàng:</strong> @Model.ShippingAddress</p>
                </div>
            </div>
        </div>

        <!-- DANH SÁCH SẢN PHẨM TRONG ĐƠN HÀNG -->
        <div class="section-title">DANH SÁCH SẢN PHẨM TRONG ĐƠN HÀNG</div>
        <div class="table-responsive">
            <table class="table table-hover table-bordered detail-table">
                <thead>
                    <tr>
                        <th class="text-center" style="width: 90px;">Hình ảnh</th>
                        <th class="text-left">Tên sản phẩm</th>
                        <th class="text-center" style="width: 110px;">Số lượng</th>
                        <th class="text-center" style="width: 150px;">Đơn giá</th>
                        <th class="text-right" style="width: 160px;">Thành tiền</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model.OrderDetails != null && Model.OrderDetails.Any())
                    {
                        foreach (var item in Model.OrderDetails)
                        {
                            <tr>
                                <td class="text-center">
                                    <img src="@Url.Content(item.Product != null && !string.IsNullOrEmpty(item.Product.ProductImage) ? item.Product.ProductImage : "~/Images/default.png")" class="product-thumb" alt="Product" />
                                </td>
                                <td class="text-left" style="font-weight: 600;">
                                    @(item.Product != null ? item.Product.ProductName : "Sản phẩm #" + item.ProductID)
                                </td>
                                <td class="text-center">
                                    <span style="background: #e9ecef; padding: 3px 10px; border-radius: 4px; font-weight: 600;">x@(item.Quantity)</span>
                                </td>
                                <td class="text-center">
                                    @(((decimal)item.UnitPrice).ToString("N0")) VNĐ
                                </td>
                                <td class="text-right" style="font-weight: 700; color: #333;">
                                    @(((decimal)(item.Quantity * item.UnitPrice)).ToString("N0")) VNĐ
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="5" class="text-center text-muted" style="padding: 20px !important;">
                                Không có sản phẩm nào trong đơn hàng này.
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>

        <!-- TỔNG TIỀN THANH TOÁN -->
        <div class="total-summary">
            <span style="font-size: 1.15rem; font-weight: 600; color: #333;">Tổng tiền thanh toán:</span>
            <span class="total-amount">@(((decimal)Model.TotalAmount).ToString("N0")) VNĐ</span>
        </div>

        <!-- NÚT QUAY LẠI -->
        <div style="margin-top: 25px;">
            <a href="@Url.Action("Index", "Orders", new { area = "Admin" })" class="btn btn-default btn-lg" style="font-weight: 600;">
                <i class="fas fa-arrow-left" style="margin-right: 6px;"></i> Quay lại danh sách đơn hàng
            </a>
        </div>
    </div>
</div>