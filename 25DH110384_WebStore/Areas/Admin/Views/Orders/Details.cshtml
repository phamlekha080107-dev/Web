@model _25DH110384_WebStore.Models.Order

@{
    ViewBag.Title = "Chi tiết đơn hàng";
    Layout = "~/Areas/Admin/Views/Shared/_AdminLayout.cshtml";
}

<h2 class="bg-success" style="padding: 10px;">CHI TIẾT ĐƠN HÀNG #@Model.OrderID</h2>

<div class="panel panel-default">
    <div class="panel-heading"><b>THÔNG TIN ĐƠN HÀNG & KHÁCH HÀNG</b></div>
    <div class="panel-body">
        <p><b>Khách hàng:</b> @Model.Customer.CustomerName</p>
        <p><b>Số điện thoại:</b> @Model.Customer.CustomerPhone</p>
        <p><b>Ngày đặt hàng:</b> @Model.OrderDate</p>
        <p><b>Địa chỉ giao hàng:</b> @Model.ShippingAddress</p>
    </div>
</div>

<h4 class="text-primary">DANH SÁCH SẢN PHẨM TRONG ĐƠN HÀNG</h4>
<table class="table table-bordered bg-info">
    <tr class="bg-success">
        <th>Hình ảnh</th>
        <th>Tên sản phẩm</th>
        <th>Số lượng</th>
        <th>Đơn giá</th>
        <th>Thành tiền</th>
    </tr>

    @foreach (var item in Model.OrderDetails)
    {
        <tr>
            <td>
                <img src="@Url.Content(item.Product.ProductImage)" style="height: 60px; width: 60px; object-fit: cover;" />
            </td>
            <td>@item.Product.ProductName</td>
            <td>@item.Quantity</td>
            <td>@String.Format("{0:N0} VNĐ", item.UnitPrice)</td>
            <td>@String.Format("{0:N0} VNĐ", item.Quantity * item.UnitPrice)</td>
        </tr>
    }
</table>

<div class="well text-right">
    <h3><b>Tổng tiền thanh toán: <span class="text-danger">@String.Format("{0:N0} VNĐ", Model.TotalAmount)</span></b></h3>
</div>

<p>
    @Html.ActionLink("Quay lại danh sách đơn hàng", "Index", null, new { @class = "btn btn-primary" })
</p>