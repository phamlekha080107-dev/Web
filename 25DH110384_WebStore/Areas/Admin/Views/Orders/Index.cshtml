@model IEnumerable<_25DH110384_WebStore.Models.Order>

@{
    ViewBag.Title = "Danh sách đơn hàng";
    Layout = "~/Areas/Admin/Views/Shared/_AdminLayout.cshtml";
}

<h2 class="bg-success" style="padding: 10px;">DANH SÁCH ĐƠN HÀNG</h2>

<table class="table table-bordered table-striped bg-info">
    <tr class="bg-success">
        <th>Mã ĐH</th>  
        <th>Tên khách hàng</th>
        <th>Ngày đặt</th>
        <th>Tổng tiền</th>
        <th>Địa chỉ giao hàng</th>
        <th>Thao tác</th>
    </tr>

    @foreach (var item in Model)
    {
        <tr>
            <td>@Html.DisplayFor(modelItem => item.OrderID)</td>
            <td>@Html.DisplayFor(modelItem => item.Customer.CustomerName)</td>
            <td>@Html.DisplayFor(modelItem => item.OrderDate)</td>
            <td>@String.Format("{0:N0} VNĐ", item.TotalAmount)</td>
            <td>@Html.DisplayFor(modelItem => item.ShippingAddress)</td>
            <td>
                @Html.ActionLink("Xem chi tiết đơn", "Details", new { id = item.OrderID }, new { @class = "btn btn-primary btn-sm" })
            </td>
        </tr>
    }
</table>