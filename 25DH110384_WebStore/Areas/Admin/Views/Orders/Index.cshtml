@model PagedList.IPagedList<_25DH110384_WebStore.Models.Order>
@using PagedList.Mvc;

@{
    ViewBag.Title = "Danh sách đơn hàng";
    Layout = "~/Areas/Admin/Views/Shared/_AdminLayout.cshtml";
    var statusList = ViewBag.PaymentStatuses as System.Collections.Generic.List<string> ?? new System.Collections.Generic.List<string>();
    var allStatuses = ViewBag.AllStatuses as System.Collections.Generic.List<string> ?? new System.Collections.Generic.List<string>
{
        "Chờ thanh toán", "Đang xử lý", "Đã xử lý", "Đang vận chuyển", "Đã giao", "Đã hủy"
    };
}

<style>
    .order-card {
        background: #ffffff;
        border-radius: 8px;
        box-shadow: 0 2px 8px rgba(0,0,0,0.06);
        border: 1px solid #e9ecef;
        overflow: hidden;
        margin-top: 20px;
    }

    .order-header {
        background-color: #1e824c;
        color: white;
        padding: 15px 20px;
        font-weight: bold;
        font-size: 1.3rem;
        display: flex;
        justify-content: space-between;
        align-items: center;
    }

    /* KHUNG TÌM KIẾM */
    .search-section {
        background-color: #f8fbf9;
        padding: 16px 20px;
        border-bottom: 1px solid #dee2e6;
    }

    .search-form {
        display: flex;
        flex-wrap: wrap;
        gap: 15px;
        align-items: flex-end;
    }

    .search-group {
        display: flex;
        flex-direction: column;
        gap: 5px;
        flex: 1;
        min-width: 200px;
    }

        .search-group label {
            font-size: 13px;
            font-weight: 600;
            color: #495057;
            margin: 0;
        }

        .search-group .form-control {
            height: 38px;
            border-radius: 5px;
            border: 1px solid #ced4da;
            font-size: 14px;
        }

            .search-group .form-control:focus {
                border-color: #1e824c;
                box-shadow: 0 0 0 2px rgba(30, 130, 76, 0.15);
            }

    .search-buttons {
        display: flex;
        gap: 8px;
    }

    .btn-filter {
        background-color: #1e824c;
        color: #fff;
        border: none;
        height: 38px;
        padding: 0 18px;
        border-radius: 5px;
        font-weight: 600;
        cursor: pointer;
        display: inline-flex;
        align-items: center;
        gap: 6px;
    }

        .btn-filter:hover {
            background-color: #16653b;
            color: #fff;
        }

    .btn-reset {
        background-color: #fff;
        color: #495057;
        border: 1px solid #ced4da;
        height: 38px;
        padding: 0 14px;
        border-radius: 5px;
        font-weight: 600;
        display: inline-flex;
        align-items: center;
        gap: 6px;
        text-decoration: none;
    }

        .btn-reset:hover {
            background-color: #e9ecef;
            color: #212529;
            text-decoration: none;
        }

    /* BẢNG DANH SÁCH ĐƠN HÀNG */
    .custom-table {
        margin-bottom: 0;
        width: 100%;
        table-layout: fixed;
    }

        .custom-table th {
            background-color: #f8f9fa;
            color: #333;
            font-weight: 700;
            border-bottom: 2px solid #dee2e6 !important;
            padding: 12px !important;
            vertical-align: middle !important;
        }

        .custom-table td {
            vertical-align: middle !important;
            padding: 12px !important;
            word-wrap: break-word;
        }

    .badge-id {
        background-color: #e9ecef;
        color: #495057;
        font-weight: bold;
        padding: 5px 10px;
        border-radius: 4px;
        display: inline-block;
    }

    /* DROPDOWN CHỌN TRẠNG THÁI TRỰC TIẾP */
    .status-select {
        width: 100%;
        max-width: 165px;
        height: 32px;
        padding: 2px 8px;
        border-radius: 16px;
        font-size: 12.5px;
        font-weight: 600;
        cursor: pointer;
        outline: none;
        transition: all 0.2s ease;
        background-color: #e8f5e9;
        color: #1e824c;
        border: 1px solid #c8e6c9;
    }

        .status-select.status-processing {
            background-color: #fff8e1;
            color: #b7791f;
            border-color: #f6e05e;
        }

        .status-select.status-processed {
            background-color: #e3f2fd;
            color: #1565c0;
            border-color: #90caf9;
        }

        .status-select.status-shipping {
            background-color: #ede7f6;
            color: #5e35b1;
            border-color: #b39ddb;
        }

        .status-select.status-delivered {
            background-color: #e8f5e9;
            color: #1e824c;
            border-color: #a5d6a7;
        }

        .status-select.status-cancelled {
            background-color: #ffebee;
            color: #c62828;
            border-color: #ef9a9a;
        }

        .status-select.status-pending {
            background-color: #f3f4f6;
            color: #4b5563;
            border-color: #d1d5db;
        }

    .price-text {
        color: #d9534f;
        font-weight: bold;
    }

    .action-btns {
        display: flex;
        gap: 6px;
        justify-content: center;
    }

    /* THÔNG BÁO KHÔNG CÓ */
    .empty-message {
        padding: 45px 20px !important;
        text-align: center;
        color: #d9534f;
        font-weight: 700;
        font-size: 18px;
    }

    /* PHÂN TRANG */
    .pagination-container {
        padding: 15px 20px;
        background-color: #fff;
        border-top: 1px solid #e9ecef;
        display: flex;
        justify-content: space-between;
        align-items: center;
        flex-wrap: wrap;
        gap: 10px;
    }

    .pagination-info {
        font-size: 13px;
        color: #6c757d;
    }

    .pagination-container .pagination {
        margin: 0;
        display: flex;
        list-style: none;
        gap: 6px;
        padding: 0;
    }

        .pagination-container .pagination li a,
        .pagination-container .pagination li span {
            display: inline-flex;
            align-items: center;
            justify-content: center;
            min-width: 34px;
            height: 34px;
            padding: 0 10px;
            border: 1px solid #dee2e6;
            border-radius: 5px;
            color: #333;
            font-size: 13px;
            font-weight: 600;
            text-decoration: none;
        }

            .pagination-container .pagination li a:hover {
                background-color: #e8f5e9;
                border-color: #1e824c;
                color: #1e824c;
            }

        .pagination-container .pagination li.active a,
        .pagination-container .pagination li.active span {
            background-color: #1e824c;
            border-color: #1e824c;
            color: #fff;
        }
</style>

<div class="order-card">
    <div class="order-header">
        <span><i class="fas fa-list-alt" style="margin-right: 8px;"></i> DANH SÁCH ĐƠN HÀNG</span>
        <span style="font-size: 14px; font-weight: normal;">
            Tổng: @(Model != null ? Model.TotalItemCount : 0) đơn hàng
        </span>
    </div>

    <!-- PHẦN TÌM KIẾM -->
    <div class="search-section">
        @using (Html.BeginForm("Index", "Orders", new { area = "Admin" }, FormMethod.Get, new { @class = "search-form" }))
        {
            <div class="search-group">
                <label for="customerName">Tên khách hàng / Mã ĐH</label>
                <input type="text"
                       id="customerName"
                       name="customerName"
                       value="@ViewBag.CustomerName"
                       class="form-control"
                       placeholder="Nhập tên khách hàng hoặc #mã ĐH..." />
            </div>

            <div class="search-group">
                <label for="paymentStatus">Trạng thái xử lý</label>
                <select id="paymentStatus" name="paymentStatus" class="form-control">
                    <option value="">-- Tất cả trạng thái --</option>
                    @foreach (var status in statusList)
                    {
                        <option value="@status" @(ViewBag.PaymentStatus == status ? "selected" : "")>
                            @status
                        </option>
                    }
                </select>
            </div>

            <div class="search-group">
                <label for="orderDate">Ngày đặt hàng</label>
                <input type="date"
                       id="orderDate"
                       name="orderDate"
                       value="@ViewBag.OrderDate"
                       class="form-control" />
            </div>

            <div class="search-buttons">
                <button type="submit" class="btn-filter">
                    <i class="fas fa-search"></i> Tìm kiếm
                </button>
                <a href="@Url.Action("Index", "Orders", new { area = "Admin" })" class="btn-reset">
                    <i class="fas fa-sync-alt"></i> Tất cả
                </a>
            </div>
        }
    </div>

    <!-- PHẦN KẾT QUẢ DANH SÁCH ĐƠN HÀNG -->
    <div class="table-responsive">
        <table class="table table-hover custom-table">
            <thead>
                <tr>
                    <th class="text-center" style="width: 80px;">Mã ĐH</th>
                    <th class="text-left" style="width: 165px;">Tên khách hàng</th>
                    <th class="text-center" style="width: 140px;">Ngày đặt</th>
                    <th class="text-center" style="width: 130px;">Tổng tiền</th>
                    <th class="text-center" style="width: 185px;">Trạng thái</th>
                    <th class="text-center">Địa chỉ giao hàng</th>
                    <th class="text-center" style="width: 165px;">Thao tác</th>
                </tr>
            </thead>
            <tbody>
                @if (Model != null && Model.Any())
                {
                    foreach (var item in Model)
                    {
                        string currentStatus = string.IsNullOrWhiteSpace(item.PaymentStatus) ? "Đang xử lý" : item.PaymentStatus.Trim();
                        string statusCss = "status-processing";
                        if (currentStatus == "Đã xử lý") { statusCss = "status-processed"; }
                        else if (currentStatus == "Đang vận chuyển") { statusCss = "status-shipping"; }
                        else if (currentStatus == "Đã giao" || currentStatus == "Đã giao hàng") { statusCss = "status-delivered"; }
                        else if (currentStatus == "Đã hủy") { statusCss = "status-cancelled"; }
                        else if (currentStatus == "Chờ thanh toán") { statusCss = "status-pending"; }

                        <tr>
                            <td class="text-center">
                                <span class="badge-id">#@item.OrderID</span>
                            </td>
                            <td class="text-left" style="font-weight: 600;">
                                @(item.Customer != null ? (string.IsNullOrEmpty(item.Customer.CustomerName) ? item.Customer.Username : item.Customer.CustomerName) : "Khách vãng lai")
                            </td>
                            <td class="text-center">
                                @item.OrderDate.ToString("dd/MM/yyyy HH:mm")
                            </td>
                            <td class="text-center price-text">
                                @(((decimal)item.TotalAmount).ToString("N0")) VNĐ
                            </td>
                            <td class="text-center">
                                @using (Html.BeginForm("UpdateStatus", "Orders", new { area = "Admin" }, FormMethod.Post, new { style = "margin:0;" }))
                                {
                                    @Html.AntiForgeryToken()
                                    <input type="hidden" name="OrderID" value="@item.OrderID" />
                                    <input type="hidden" name="returnUrl" value="@Request.RawUrl" />

                                    <select name="PaymentStatus"
                                            class="status-select @statusCss"
                                            onchange="this.form.submit()"
                                            title="Chọn để đổi trạng thái đơn hàng">
                                        @if (!allStatuses.Contains(currentStatus))
                                        {
                                            <option value="@currentStatus" selected>@currentStatus</option>
                                        }
                                        @foreach (var st in allStatuses)
                                        {
                                            <option value="@st" @(currentStatus == st ? "selected" : "")>@st</option>
                                        }
                                    </select>
                                }
                            </td>
                            <td class="text-center">
                                @item.ShippingAddress
                            </td>
                            <td class="text-center">
                                <div class="action-btns">
                                    <a href="@Url.Action("DetailedOrder", "Orders", new { area = "Admin", id = item.OrderID })" class="btn btn-info btn-sm" title="Xem chi tiết">
                                        <i class="fas fa-eye"></i> Chi tiết
                                    </a>

                                    @using (Html.BeginForm("Delete", "Orders", new { area = "Admin", id = item.OrderID }, FormMethod.Post, new { style = "display:inline;" }))
                                    {
                                        @Html.AntiForgeryToken()
                                        <button type="submit" class="btn btn-danger btn-sm" onclick="return confirm('Bạn có chắc chắn muốn xóa đơn hàng #@item.OrderID này không?');" title="Xóa đơn hàng">
                                            <i class="fas fa-trash-alt"></i> Xóa
                                        </button>
                                    }
                                </div>
                            </td>
                        </tr>
                    }
                }
                else
                {
                    <tr>
                        <td colspan="7" class="empty-message">
                            Không tìm thấy đơn hàng nào phù hợp
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>

    <!-- PHÂN TRANG 15 ĐƠN HÀNG / TRANG -->
    @if (Model != null && Model.PageCount > 0)
    {
        <div class="pagination-container">
            <div class="pagination-info">
                Trang @(Model.PageCount < Model.PageNumber ? 0 : Model.PageNumber) / @Model.PageCount
            </div>

            @Html.PagedListPager(Model, page => Url.Action("Index", new
            {
                area = "Admin",
                page,
                customerName = ViewBag.CustomerName,
                paymentStatus = ViewBag.PaymentStatus,
                orderDate = ViewBag.OrderDate
            }))
        </div>
    }
</div>