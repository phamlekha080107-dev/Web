@model _25DH110384_WebStore.Models.Category

@{
    ViewBag.Title = "Delete";
    Layout = "~/Areas/Admin/Views/Shared/_AdminLayout.cshtml";
}

<h2 class="bg-success">XÓA DANH MỤC</h2>
@using (Html.BeginForm())
{
    @Html.AntiForgeryToken()
    <div class="form-horizontal">

        <div class="form-group">
            <div class="col-md-offset-2 col-md-10">
                <h4>Bạn có chắc chắn xóa danh mục này ?</h4>
            </div>
        </div>
                <div class="form-group">
                    <div class="class = " control-label col-md-2">Tên danh mục </div>
                    <div class="col-md-10">
                        @* Hiển thị giá trị của CategoryName *@
                        @Html.DisplayFor(model => model.CategoryName)
                    </div>
                </div>

                <div class="form-group">
                    <div class="col-md-offset-2 col-md-10">
                        <input type="submit" value="Xóa" class="btn btn-primary" /> |
                        @Html.ActionLink("Quay lại danh sách", "Index", new { @class = "btn btn-primary " })


                    </div>

                </div>

    </div>
 }
